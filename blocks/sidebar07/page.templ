package sidebar07

import (
	"github.com/axadrn/shadcn-templ/v2/components/breadcrumb"
	"github.com/axadrn/shadcn-templ/v2/components/separator"
	"github.com/axadrn/shadcn-templ/v2/components/sidebar"
)

templ Page() {
	@sidebar.Provider() {
		@AppSidebar()
		@sidebar.Inset() {
			<header class="flex h-16 shrink-0 items-center gap-2 transition-[width,height] ease-linear group-has-data-[collapsible=icon]/sidebar-wrapper:h-12">
				<div class="flex items-center gap-2 px-4">
					@sidebar.Trigger(sidebar.TriggerProps{Class: "-ml-1"})
					@separator.Separator(separator.Props{
						Orientation: separator.OrientationVertical,
						Class:       "mr-2 data-[orientation=vertical]:h-4",
					})
					@breadcrumb.Breadcrumb() {
						@breadcrumb.List() {
							@breadcrumb.Item(breadcrumb.ItemProps{Class: "hidden md:block"}) {
								@breadcrumb.Link(breadcrumb.LinkProps{Href: "#"}) {
									Build Your Application
								}
							}
							@breadcrumb.Separator(breadcrumb.SeparatorProps{Class: "hidden md:block"})
							@breadcrumb.Item() {
								@breadcrumb.Page() {
									Data Fetching
								}
							}
						}
					}
				</div>
			</header>
			<div class="flex flex-1 flex-col gap-4 p-4 pt-0">
				<div class="grid auto-rows-min gap-4 md:grid-cols-3">
					<div class="aspect-video rounded-xl bg-muted/50"></div>
					<div class="aspect-video rounded-xl bg-muted/50"></div>
					<div class="aspect-video rounded-xl bg-muted/50"></div>
				</div>
				<div class="min-h-[100vh] flex-1 rounded-xl bg-muted/50 md:min-h-min"></div>
			</div>
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			// Team switching, the pendant of the TeamSwitcher's activeTeam React state.
			document.addEventListener("click", (e) => {
				if (!(e.target instanceof Element)) return;
				const item = e.target.closest("#sidebar07-team-menu [data-sidebar07-team-index]");
				if (!item) return;
				const i = item.getAttribute("data-sidebar07-team-index");
				const name = item.textContent.trim().replace(/⌘\d$/, "").trim();
				const plan = ["Enterprise", "Startup", "Free"][parseInt(i, 10)];
				document.querySelectorAll("[data-sidebar07-team-logo]").forEach((logo) => {
					logo.classList.toggle("hidden", logo.getAttribute("data-sidebar07-team-logo") !== i);
				});
				const nameEl = document.querySelector("[data-sidebar07-team-name]");
				const planEl = document.querySelector("[data-sidebar07-team-plan]");
				if (nameEl) nameEl.textContent = name;
				if (planEl) planEl.textContent = plan;
			});

			// side={isMobile ? "bottom" : "right"} pendant: the menus flip to
			// bottom below md, like useSidebar's isMobile.
			const mq = window.matchMedia("(max-width: 767px)");
			const applySides = () => {
				document.querySelectorAll("[data-sidebar07-menu]").forEach((menu) => {
					menu.setAttribute("data-tui-dropdownmenu-side", mq.matches ? "bottom" : "right");
					if (menu.getAttribute("data-sidebar07-menu") === "project") {
						menu.setAttribute("data-tui-dropdownmenu-align", mq.matches ? "end" : "start");
					}
				});
			};
			// The portals lift with the deferred bundle, so the initial pass
			// waits for DOM ready (matchMedia changes keep it live after).
			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", applySides);
			} else {
				applySides();
			}
			mq.addEventListener("change", applySides);
		})();
	</script>
}
