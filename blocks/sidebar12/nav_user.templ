package sidebar12

import (
	"github.com/axadrn/shadcn-templ/v2/components/avatar"
	"github.com/axadrn/shadcn-templ/v2/components/dropdownmenu"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/sidebar"
)

type User struct {
	Name   string
	Email  string
	Avatar string
}

templ NavUser(user User) {
	@sidebar.Menu() {
		@sidebar.MenuItem() {
			@dropdownmenu.DropdownMenu() {
				@sidebar.MenuButton(sidebar.MenuButtonProps{
					Size:       sidebar.MenuButtonSizeLg,
					Class:      "data-[state=open]:bg-sidebar-accent data-[state=open]:text-sidebar-accent-foreground",
					Attributes: dropdownmenu.Trigger(ctx),
				}) {
					// after:rounded-lg + the rounded-lg on Image go beyond the TSX classes:
					// shadcn's avatar root clips via overflow-hidden, ours rounds image and
					// ring themselves (cn-avatar-image, after:rounded-full), so the square
					// override has to reach both.
					@avatar.Avatar(avatar.Props{Class: "h-8 w-8 rounded-lg after:rounded-lg"}) {
						@avatar.Image(avatar.ImageProps{Src: user.Avatar, Alt: user.Name, Class: "rounded-lg"})
						@avatar.Fallback(avatar.FallbackProps{Class: "rounded-lg"}) {
							AA
						}
					}
					<div class="grid flex-1 text-left text-sm leading-tight">
						<span class="truncate font-medium">{ user.Name }</span>
						<span class="truncate text-xs">{ user.Email }</span>
					</div>
					@icon.ChevronsUpDown(icon.Props{Class: "ml-auto size-4"})
				}
				@dropdownmenu.Content(dropdownmenu.ContentProps{
					Class:      "w-(--radix-dropdown-menu-trigger-width) min-w-56 rounded-lg",
					Side:       dropdownmenu.SideRight,
					Align:      dropdownmenu.AlignStart,
					SideOffset: 4,
					Attributes: templ.Attributes{"data-sidebar12-menu": "user"},
				}) {
					@dropdownmenu.Label(dropdownmenu.LabelProps{Class: "p-0 font-normal"}) {
						<div class="flex items-center gap-2 px-1 py-1.5 text-left text-sm">
							@avatar.Avatar(avatar.Props{Class: "h-8 w-8 rounded-lg after:rounded-lg"}) {
								@avatar.Image(avatar.ImageProps{Src: user.Avatar, Alt: user.Name, Class: "rounded-lg"})
								@avatar.Fallback(avatar.FallbackProps{Class: "rounded-lg"}) {
									AA
								}
							}
							<div class="grid flex-1 text-left text-sm leading-tight">
								<span class="truncate font-medium">{ user.Name }</span>
								<span class="truncate text-xs">{ user.Email }</span>
							</div>
						</div>
					}
					@dropdownmenu.Separator()
					@dropdownmenu.Group() {
						@dropdownmenu.Item() {
							@icon.Sparkles()
							Upgrade to Pro
						}
					}
					@dropdownmenu.Separator()
					@dropdownmenu.Group() {
						@dropdownmenu.Item() {
							@icon.BadgeCheck()
							Account
						}
						@dropdownmenu.Item() {
							@icon.CreditCard()
							Billing
						}
						@dropdownmenu.Item() {
							@icon.Bell()
							Notifications
						}
					}
					@dropdownmenu.Separator()
					@dropdownmenu.Item() {
						@icon.LogOut()
						Log out
					}
				}
			}
		}
	}
}
