package sidebar12

import (
	"github.com/axadrn/shadcn-templ/v2/components/breadcrumb"
	"github.com/axadrn/shadcn-templ/v2/components/separator"
	"github.com/axadrn/shadcn-templ/v2/components/sidebar"
)

templ Page() {
	@sidebar.Provider() {
		@AppSidebar()
		@sidebar.Inset() {
			<header class="sticky top-0 flex h-16 shrink-0 items-center gap-2 border-b bg-background px-4">
				@sidebar.Trigger(sidebar.TriggerProps{Class: "-ml-1"})
				@separator.Separator(separator.Props{
					Orientation: separator.OrientationVertical,
					Class:       "mr-2 data-[orientation=vertical]:h-4",
				})
				@breadcrumb.Breadcrumb() {
					@breadcrumb.List() {
						@breadcrumb.Item() {
							@breadcrumb.Page() {
								October 2024
							}
						}
					}
				}
			</header>
			<div class="flex flex-1 flex-col gap-4 p-4">
				<div class="grid auto-rows-min gap-4 md:grid-cols-5">
					for i := 0; i < 20; i++ {
						<div class="aspect-square rounded-xl bg-muted/50"></div>
					}
				</div>
			</div>
		}
	}
}
