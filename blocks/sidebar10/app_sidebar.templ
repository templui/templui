templ AppSidebar() {
	@sidebar.Sidebar(sidebar.Props{Class: "border-r-0"}) {
		@sidebar.Header() {
			@TeamSwitcher(teams)
			@NavMain(navMain)
		}
		@sidebar.Content() {
			@NavFavorites(favorites)
			@NavWorkspaces(workspaces)
			@NavSecondary(navSecondary, "mt-auto")
		}
		@sidebar.Rail()
	}
}
