templ SidebarLeft(props ...sidebar.Props) {
	{{ var p sidebar.Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Class == "" {
		{{ p.Class = "border-r-0" }}
	}
	@sidebar.Sidebar(p) {
		@sidebar.Header() {
			@TeamSwitcher(sidebarLeftData.Teams)
			@NavMain(sidebarLeftData.NavMain)
		}
		@sidebar.Content() {
			@NavFavorites(sidebarLeftData.Favorites)
			@NavWorkspaces(sidebarLeftData.Workspaces)
			@NavSecondary(sidebarLeftData.NavSecondary, sidebar.GroupProps{Class: "mt-auto"})
		}
		@sidebar.Rail()
	}
}
