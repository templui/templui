package charts

import (
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/chart"
	"github.com/templui/templui/components/icon"
)

// The pendant of chart-bar-active.tsx.

var chartBarActiveData = []chart.Datum{
	{"browser": "chrome", "visitors": 187, "fill": "var(--color-chrome)"},
	{"browser": "safari", "visitors": 200, "fill": "var(--color-safari)"},
	{"browser": "firefox", "visitors": 275, "fill": "var(--color-firefox)"},
	{"browser": "edge", "visitors": 173, "fill": "var(--color-edge)"},
	{"browser": "other", "visitors": 90, "fill": "var(--color-other)"},
}

var chartBarActiveConfig = chart.Config{
	{Key: "visitors", Label: "Visitors"},
	{Key: "chrome", Label: "Chrome", Color: "var(--chart-1)"},
	{Key: "safari", Label: "Safari", Color: "var(--chart-2)"},
	{Key: "firefox", Label: "Firefox", Color: "var(--chart-3)"},
	{Key: "edge", Label: "Edge", Color: "var(--chart-4)"},
	{Key: "other", Label: "Other", Color: "var(--chart-5)"},
}

// barActiveLabel resolves the config label, the pendant of the demo's
// tickFormatter reading chartConfig[value].label.
func barActiveLabel(v any) string {
	return chartBarActiveConfig.Label(v.(string))
}

templ ChartBarActive() {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				Bar Chart - Active
			}
			@card.Description() {
				January - June 2024
			}
		}
		@card.Content() {
			@chart.Container(chart.ContainerProps{ID: "bar-active", Config: chartBarActiveConfig}) {
				@chart.BarChart(chart.BarChartProps{Data: chartBarActiveData}) {
					@chart.CartesianGrid(chart.CartesianGridProps{Vertical: chart.Bool(false)})
					@chart.XAxis(chart.XAxisProps{
						DataKey:       "browser",
						TickMargin:    10,
						TickFormatter: barActiveLabel,
					})
					@chart.Tooltip(chart.TooltipProps{
						Cursor:  chart.Bool(false),
						Content: chart.TooltipContentProps{HideLabel: true},
					})
					@chart.Bar(chart.BarProps{
						DataKey:     "visitors",
						StrokeWidth: 2,
						Radius:      8,
						ActiveIndex: chart.Index(2),
						ActiveBar: &chart.RectangleProps{
							FillOpacity:      0.8,
							StrokeDasharray:  4,
							StrokeDashoffset: 4,
						},
					})
				}
			}
		}
		@card.Footer(card.FooterProps{Class: "flex-col items-start gap-2 text-sm"}) {
			<div class="flex gap-2 leading-none font-medium">
				Trending up by 5.2% this month
				@icon.TrendingUp(icon.Props{Class: "h-4 w-4"})
			</div>
			<div class="leading-none text-muted-foreground">
				Showing total visitors for the last 6 months
			</div>
		}
	}
}
