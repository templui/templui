package pages

import (
	"github.com/templui/templui/internal/ui/layouts"
	"github.com/templui/templui/internal/ui/modules"
	"github.com/templui/templui/internal/ui/examples"
)

templ Tooltip() {
	@layouts.DocsLayout(
		"Tooltip",
		"A small pop-up box that appears when a user hovers over an element. Uses Popover with Floating UI under the hood.",
		[]modules.TableOfContentsItem{
			{
				ID:   "installation",
				Text: "Installation",
			},
			{
				Text: "Examples",
				ID:   "examples",
				Children: []modules.TableOfContentsItem{
					{Text: "Side", ID: "side"},
					{Text: "With Keyboard Shortcut", ID: "keyboard"},
					{Text: "Disabled Button", ID: "disabled"},
				},
			},
			{
				ID:   "api",
				Text: "API Reference",
				Children: []modules.TableOfContentsItem{
					{ID: "api-tooltip", Text: "Tooltip"},
					{ID: "api-content", Text: "Content"},
				},
			},
		},
	) {
		@modules.PageWrapper(modules.PageWrapperProps{
			Name:        "Tooltip",
			Description: templ.Raw(`Small pop-up that appears on hover. Powered by <a href="/docs/components/popover" class="text-primary underline underline-offset-2 hover:opacity-80 transition-opacity">Popover</a> with <a href="https://floating-ui.com/" target="_blank" rel="noopener" class="text-primary underline underline-offset-2 hover:opacity-80 transition-opacity">Floating UI</a>.`),
			Tailwind:    true,
			VanillaJS:   true,
			Breadcrumbs: modules.Breadcrumbs{
				Items: []modules.BreadcrumbItem{
					{
						Text: "Docs",
						Path: "/docs",
					},
					{
						Text: "Components",
						Path: "/docs/components",
					},
					{
						Text: "Tooltip",
					},
				},
			},
		}) {
			@modules.ExampleWrapper(modules.ExampleWrapperProps{
				ShowcaseFile:    examples.TooltipDefault(),
				PreviewCodeFile: "tooltip_default.templ",
			})
			@modules.ContainerWrapper(modules.ContainerWrapperProps{
				Title: "Installation",
				ID:    "installation",
			}) {
				@modules.ComponentUsage(modules.ComponentUsageProps{
					ComponentName: "tooltip",
				})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{
				Title: "Examples",
				ID:    "examples",
			}) {
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Side",
					PreviewCodeFile: "tooltip_sides.templ",
					ShowcaseFile:    examples.TooltipSides(),
					ID:              "side",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "With Keyboard Shortcut",
					PreviewCodeFile: "tooltip_keyboard.templ",
					ShowcaseFile:    examples.TooltipKeyboard(),
					ID:              "keyboard",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Disabled Button",
					PreviewCodeFile: "tooltip_disabled.templ",
					ShowcaseFile:    examples.TooltipDisabled(),
					ID:              "disabled",
				})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{
				Title: "API Reference",
				ID:    "api",
			}) {
				@modules.APILegend()
				<div id="api-tooltip" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Tooltip",
						Description: "The root that links Trigger and Content via ctx. Renders no element.",
						Items: []modules.APITableItem{
							{
								Name:        "ID",
								Type:        "string",
								Default:     "randomID",
								Description: "Optional id linking trigger and content.",
								Required:    false,
							},
						},
					})
				</div>
				<div id="api-content" class="mb-8">
					<p class="mb-4 text-sm text-muted-foreground">Make any element the trigger by spreading <code>tooltip.Trigger(ctx)</code> onto its Attributes — the templ equivalent of shadcn's <code>asChild</code>.</p>
					@modules.APITable(modules.APITableProps{
						Title:       "Content",
						Description: "The tooltip surface, portaled to the body and rendered in the native top layer.",
						Items: []modules.APITableItem{
							{
								Name:        "Side",
								Type:        "Side",
								Default:     "top",
								Description: "Side of the trigger the tooltip shows on. Options: 'top', 'right', 'bottom', 'left'. Flips automatically when there is no room.",
								Required:    false,
							},
							{
								Name:        "SideOffset",
								Type:        "int",
								Default:     "4",
								Description: "Gap to the trigger in px.",
								Required:    false,
							},
							{
								Name:        "Class",
								Type:        "string",
								Default:     "",
								Description: "Additional CSS classes to apply to the content.",
								Required:    false,
							},
							{
								Name:        "Attributes",
								Type:        "templ.Attributes",
								Default:     "",
								Description: "Additional HTML attributes to apply to the content element.",
								Required:    false,
							},
						},
					})
				</div>
			}
		}
	}
}
