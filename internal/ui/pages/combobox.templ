package pages

import (
	"github.com/templui/templui/internal/ui/layouts"
	"github.com/templui/templui/internal/ui/modules"
	"github.com/templui/templui/internal/ui/showcase"
)

templ Combobox() {
	@layouts.DocsLayout(
		"Combobox",
		"An input with a filterable list of options.",
		[]modules.TableOfContentsItem{
			{ID: "installation", Text: "Installation"},
			{
				ID:   "examples",
				Text: "Examples",
				Children: []modules.TableOfContentsItem{
					{Text: "Multiple", ID: "multiple"},
					{Text: "Clear", ID: "clear"},
					{Text: "Groups", ID: "groups"},
					{Text: "Custom Items", ID: "custom"},
					{Text: "Invalid", ID: "invalid"},
					{Text: "Disabled", ID: "disabled"},
					{Text: "Auto Highlight", ID: "auto-highlight"},
					{Text: "Popup", ID: "popup"},
					{Text: "Input Group", ID: "input-group"},
				},
			},
			{
				ID:   "api",
				Text: "API Reference",
				Children: []modules.TableOfContentsItem{
					{ID: "api-combobox", Text: "Combobox"},
					{ID: "api-input", Text: "Input"},
					{ID: "api-content", Text: "Content"},
					{ID: "api-item", Text: "Item"},
					{ID: "api-chips", Text: "Chips"},
				},
			},
		},
	) {
		@modules.PageWrapper(modules.PageWrapperProps{
			Name:        "Combobox",
			Description: templ.Raw("An input with a filterable list of options."),
			Tailwind:    true,
			VanillaJS:   true,
			Breadcrumbs: modules.Breadcrumbs{
				Items: []modules.BreadcrumbItem{
					{Text: "Docs", Path: "/docs"},
					{Text: "Components", Path: "/docs/components"},
					{Text: "Combobox"},
				},
			},
		}) {
			@modules.ExampleWrapper(modules.ExampleWrapperProps{
				ShowcaseFile:    showcase.ComboboxDefault(),
				PreviewCodeFile: "combobox_default.templ",
			})
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "Installation", ID: "installation"}) {
				@modules.ComponentUsage(modules.ComponentUsageProps{ComponentName: "combobox"})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "Examples", ID: "examples"}) {
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Multiple",
					ShowcaseFile:    showcase.ComboboxMultiple(),
					PreviewCodeFile: "combobox_multiple.templ",
					ID:              "multiple",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Clear",
					ShowcaseFile:    showcase.ComboboxClear(),
					PreviewCodeFile: "combobox_clear.templ",
					ID:              "clear",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Groups",
					ShowcaseFile:    showcase.ComboboxGroups(),
					PreviewCodeFile: "combobox_groups.templ",
					ID:              "groups",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Custom Items",
					ShowcaseFile:    showcase.ComboboxCustom(),
					PreviewCodeFile: "combobox_custom.templ",
					ID:              "custom",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Invalid",
					ShowcaseFile:    showcase.ComboboxInvalid(),
					PreviewCodeFile: "combobox_invalid.templ",
					ID:              "invalid",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Disabled",
					ShowcaseFile:    showcase.ComboboxDisabled(),
					PreviewCodeFile: "combobox_disabled.templ",
					ID:              "disabled",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Auto Highlight",
					ShowcaseFile:    showcase.ComboboxAutoHighlight(),
					PreviewCodeFile: "combobox_auto_highlight.templ",
					ID:              "auto-highlight",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Popup",
					ShowcaseFile:    showcase.ComboboxPopup(),
					PreviewCodeFile: "combobox_popup.templ",
					ID:              "popup",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Input Group",
					ShowcaseFile:    showcase.ComboboxInputGroup(),
					PreviewCodeFile: "combobox_input_group.templ",
					ID:              "input-group",
				})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "API Reference", ID: "api"}) {
				@modules.APILegend()
				<div id="api-combobox" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Combobox",
						Description: "The root that links Input/Chips, Content and the hidden form inputs. Renders no element.",
						Items: []modules.APITableItem{
							{Name: "Name", Type: "string", Default: "", Description: "Form field name. Renders hidden inputs that submit the selected value(s).", Required: false},
							{Name: "Value", Type: "string", Default: "", Description: "Preselects the item with this value (single mode).", Required: false},
							{Name: "Values", Type: "[]string", Default: "", Description: "Preselects items in multiple mode.", Required: false},
							{Name: "Multiple", Type: "bool", Default: "false", Description: "Allows selecting several items, rendered as chips.", Required: false},
							{Name: "AutoHighlight", Type: "bool", Default: "false", Description: "Keeps the first matching item highlighted while typing.", Required: false},
							{Name: "Disabled", Type: "bool", Default: "false", Description: "Disables the input.", Required: false},
							{Name: "ID", Type: "string", Default: "randomID", Description: "Optional id linking anchor and content.", Required: false},
						},
					})
				</div>
				<div id="api-input" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Input",
						Description: "The filter input, rendered as an input group. Also usable inside Content for the popup pattern.",
						Items: []modules.APITableItem{
							{Name: "Placeholder", Type: "string", Default: "", Description: "Placeholder shown while no item is selected.", Required: false},
							{Name: "Invalid", Type: "bool", Default: "false", Description: "Marks the input aria-invalid for error styling.", Required: false},
							{Name: "HideTrigger", Type: "bool", Default: "false", Description: "Hides the chevron button.", Required: false},
							{Name: "ShowClear", Type: "bool", Default: "false", Description: "Renders a clear button while a value is selected.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply to the input group.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply to the input.", Required: false},
						},
					})
				</div>
				<div id="api-content" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Content",
						Description: "The popup surface with Empty and List inside.",
						Items: []modules.APITableItem{
							{Name: "Side", Type: "Side", Default: "bottom", Description: "Side of the anchor to open against. Options: 'top', 'right', 'bottom', 'left'.", Required: false},
							{Name: "Align", Type: "Align", Default: "start", Description: "Alignment along the anchor edge. Options: 'start', 'center', 'end'.", Required: false},
							{Name: "AlignOffset", Type: "int", Default: "0", Description: "Shifts the content along the aligned edge, in px.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply to the content.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply to the content.", Required: false},
						},
					})
				</div>
				<div id="api-item" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Item",
						Description: "A selectable option. Emits a 'combobox-change' event on the anchor when picked.",
						Items: []modules.APITableItem{
							{Name: "Value", Type: "string", Default: "", Description: "The value submitted when this item is selected.", Required: true},
							{Name: "Label", Type: "string", Default: "", Description: "Text the input shows and the filter matches. Defaults to the item's text content.", Required: false},
							{Name: "Disabled", Type: "bool", Default: "false", Description: "Whether the item is disabled.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply to the item.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply to the item.", Required: false},
						},
					})
				</div>
				<div id="api-chips">
					@modules.APITable(modules.APITableProps{
						Title:       "Chips",
						Description: "The anchor for multiple mode: selected values render as removable chips with an inline filter input.",
						Items: []modules.APITableItem{
							{Name: "Placeholder", Type: "string", Default: "", Description: "Placeholder for the inline chips input.", Required: false},
							{Name: "Invalid", Type: "bool", Default: "false", Description: "Marks the chips input aria-invalid for error styling.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply to the chips container.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply to the chips container.", Required: false},
						},
					})
				</div>
			}
		}
	}
}
