package pages

import (
	"github.com/templui/templui/internal/ui/layouts"
	"github.com/templui/templui/internal/ui/modules"
	"github.com/templui/templui/internal/ui/showcase"
)

templ Field() {
	@layouts.DocsLayout(
		"Field",
		"Compose accessible form fields with labels, descriptions and errors.",
		[]modules.TableOfContentsItem{
			{ID: "installation", Text: "Installation"},
			{
				ID:   "examples",
				Text: "Examples",
				Children: []modules.TableOfContentsItem{
					{ID: "input", Text: "Input"},
					{ID: "textarea", Text: "Textarea"},
					{ID: "select", Text: "Select"},
					{ID: "slider", Text: "Slider"},
					{ID: "fieldset", Text: "Fieldset"},
					{ID: "checkbox", Text: "Checkbox"},
					{ID: "radio", Text: "Radio"},
					{ID: "switch", Text: "Switch"},
					{ID: "choice-card", Text: "Choice Card"},
					{ID: "field-group", Text: "Field Group"},
					{ID: "responsive", Text: "Responsive Layout"},
				},
			},
			{
				ID:   "api",
				Text: "API Reference",
				Children: []modules.TableOfContentsItem{
					{ID: "api-set", Text: "Set"},
					{ID: "api-legend", Text: "Legend"},
					{ID: "api-group", Text: "Group"},
					{ID: "api-field", Text: "Field"},
					{ID: "api-content", Text: "Content"},
					{ID: "api-label", Text: "Label"},
					{ID: "api-title", Text: "Title"},
					{ID: "api-description", Text: "Description"},
					{ID: "api-separator", Text: "Separator"},
					{ID: "api-error", Text: "Error"},
				},
			},
		},
	) {
		@modules.PageWrapper(modules.PageWrapperProps{
			Name:        "Field",
			Description: templ.Raw("Compose accessible form fields. Wrap a control with Label, Description and Error, group them with Group and Set."),
			Tailwind:    true,
			Breadcrumbs: modules.Breadcrumbs{
				Items: []modules.BreadcrumbItem{
					{Text: "Docs", Path: "/docs"},
					{Text: "Components", Path: "/docs/components"},
					{Text: "Field"},
				},
			},
		}) {
			@modules.ExampleWrapper(modules.ExampleWrapperProps{
				ShowcaseFile:    showcase.FieldDefault(),
				PreviewCodeFile: "field_default.templ",
			})
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "Installation", ID: "installation"}) {
				@modules.ComponentUsage(modules.ComponentUsageProps{ComponentName: "field"})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "Examples", ID: "examples"}) {
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Input",
					ShowcaseFile:    showcase.FieldInput(),
					PreviewCodeFile: "field_input.templ",
					ID:              "input",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Textarea",
					ShowcaseFile:    showcase.FieldTextarea(),
					PreviewCodeFile: "field_textarea.templ",
					ID:              "textarea",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Select",
					ShowcaseFile:    showcase.FieldSelect(),
					PreviewCodeFile: "field_select.templ",
					ID:              "select",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Slider",
					ShowcaseFile:    showcase.FieldSlider(),
					PreviewCodeFile: "field_slider.templ",
					ID:              "slider",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Fieldset",
					ShowcaseFile:    showcase.FieldFieldset(),
					PreviewCodeFile: "field_fieldset.templ",
					ID:              "fieldset",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Checkbox",
					ShowcaseFile:    showcase.FieldCheckbox(),
					PreviewCodeFile: "field_checkbox.templ",
					ID:              "checkbox",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Radio",
					ShowcaseFile:    showcase.FieldRadio(),
					PreviewCodeFile: "field_radio.templ",
					ID:              "radio",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Switch",
					ShowcaseFile:    showcase.FieldSwitch(),
					PreviewCodeFile: "field_switch.templ",
					ID:              "switch",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Choice Card",
					ShowcaseFile:    showcase.FieldChoiceCard(),
					PreviewCodeFile: "field_choice_card.templ",
					ID:              "choice-card",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Field Group",
					ShowcaseFile:    showcase.FieldGroupExample(),
					PreviewCodeFile: "field_group.templ",
					ID:              "field-group",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Responsive Layout",
					ShowcaseFile:    showcase.FieldResponsive(),
					PreviewCodeFile: "field_responsive.templ",
					ID:              "responsive",
				})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "API Reference", ID: "api"}) {
				@modules.APILegend()
				<div id="api-set" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Set",
						Description: "A fieldset that groups related fields, usually introduced by a Legend.",
						Items: []modules.APITableItem{
							{Name: "ID", Type: "string", Default: "", Description: "Optional HTML id for the element.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply.", Required: false},
						},
					})
				</div>
				<div id="api-legend" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Legend",
						Description: "A heading for a Set of fields.",
						Items: []modules.APITableItem{
							{Name: "Variant", Type: "LegendVariant", Default: "legend", Description: "Size. Options: 'legend', 'label'.", Required: false},
							{Name: "ID", Type: "string", Default: "", Description: "Optional HTML id for the element.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply.", Required: false},
						},
					})
				</div>
				<div id="api-group" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Group",
						Description: "Stacks multiple fields with consistent spacing. Enables responsive field layout via its container.",
						Items: []modules.APITableItem{
							{Name: "ID", Type: "string", Default: "", Description: "Optional HTML id for the element.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply.", Required: false},
						},
					})
				</div>
				<div id="api-field" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Field",
						Description: "Wraps a single form control with its Label, Description and Error.",
						Items: []modules.APITableItem{
							{Name: "Orientation", Type: "Orientation", Default: "vertical", Description: "Layout. Options: 'vertical', 'horizontal', 'responsive'.", Required: false},
							{Name: "ID", Type: "string", Default: "", Description: "Optional HTML id for the element.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply.", Required: false},
						},
					})
				</div>
				<div id="api-content" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Content",
						Description: "Wraps a Label/Title with a Description inside a horizontal or responsive Field.",
						Items: []modules.APITableItem{
							{Name: "ID", Type: "string", Default: "", Description: "Optional HTML id for the element.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply.", Required: false},
						},
					})
				</div>
				<div id="api-label" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Label",
						Description: "The label for the field's control. Wrap a Field to make the whole card clickable (choice cards).",
						Items: []modules.APITableItem{
							{Name: "For", Type: "string", Default: "", Description: "The id of the control this label is for.", Required: false},
							{Name: "ID", Type: "string", Default: "", Description: "Optional HTML id for the element.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply.", Required: false},
						},
					})
				</div>
				<div id="api-title" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Title",
						Description: "A non-label heading inside a Content block — e.g. the title of a choice card or a slider field.",
						Items: []modules.APITableItem{
							{Name: "ID", Type: "string", Default: "", Description: "Optional HTML id for the element.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply.", Required: false},
						},
					})
				</div>
				<div id="api-description" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Description",
						Description: "Helper text for a field or set. Links inside are styled automatically.",
						Items: []modules.APITableItem{
							{Name: "ID", Type: "string", Default: "", Description: "Optional HTML id for the element.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply.", Required: false},
						},
					})
				</div>
				<div id="api-separator" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Separator",
						Description: "A horizontal divider between sets of fields, with optional centered content.",
						Items: []modules.APITableItem{
							{Name: "ID", Type: "string", Default: "", Description: "Optional HTML id for the element.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply.", Required: false},
						},
					})
				</div>
				<div id="api-error">
					@modules.APITable(modules.APITableProps{
						Title:       "Error",
						Description: "Displays a validation error for a field. Renders as role=alert.",
						Items: []modules.APITableItem{
							{Name: "ID", Type: "string", Default: "", Description: "Optional HTML id for the element.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply.", Required: false},
						},
					})
				</div>
			}
		}
	}
}
