package pages

import (
	"github.com/templui/templui/internal/ui/layouts"
	"github.com/templui/templui/internal/ui/modules"
	"github.com/templui/templui/internal/ui/examples"
)

templ DropdownMenu() {
	@layouts.DocsLayout(
		"Dropdown Menu",
		"Displays a menu of actions or options triggered by a button.",
		[]modules.TableOfContentsItem{
			{ID: "installation", Text: "Installation"},
			{
				ID:   "examples",
				Text: "Examples",
				Children: []modules.TableOfContentsItem{
					{Text: "Basic", ID: "basic"},
					{Text: "Submenu", ID: "submenu"},
					{Text: "Shortcuts", ID: "shortcuts"},
					{Text: "Icons", ID: "icons"},
					{Text: "Checkboxes", ID: "checkboxes"},
					{Text: "Checkboxes Icons", ID: "checkboxes-icons"},
					{Text: "Radio Group", ID: "radio-group"},
					{Text: "Radio Icons", ID: "radio-icons"},
					{Text: "Destructive", ID: "destructive"},
					{Text: "Avatar", ID: "avatar"},
					{Text: "Complex", ID: "complex"},
				},
			},
			{
				ID:   "api-reference",
				Text: "API Reference",
				Children: []modules.TableOfContentsItem{
					{ID: "api-content", Text: "Content"},
					{ID: "api-item", Text: "Item"},
					{ID: "api-checkbox-item", Text: "CheckboxItem"},
					{ID: "api-radio-item", Text: "RadioItem"},
					{ID: "api-sub-trigger", Text: "SubTrigger"},
				},
			},
		},
	) {
		@modules.PageWrapper(modules.PageWrapperProps{
			Name:        "Dropdown Menu",
			Description: templ.Raw("Displays a menu of actions or options triggered by a button."),
			Tailwind:    true,
			VanillaJS:   true,
			Breadcrumbs: modules.Breadcrumbs{
				Items: []modules.BreadcrumbItem{
					{Text: "Docs", Path: "/docs"},
					{Text: "Components", Path: "/docs/components"},
					{Text: "Dropdown Menu"},
				},
			},
		}) {
			@modules.ExampleWrapper(modules.ExampleWrapperProps{
				ShowcaseFile:    examples.DropdownMenuDefault(),
				PreviewCodeFile: "dropdownmenu_default.templ",
			})
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "Installation", ID: "installation"}) {
				@modules.ComponentUsage(modules.ComponentUsageProps{ComponentName: "dropdownmenu"})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "Examples", ID: "examples"}) {
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Basic",
					ShowcaseFile:    examples.DropdownMenuBasic(),
					PreviewCodeFile: "dropdownmenu_basic.templ",
					ID:              "basic",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Submenu",
					ShowcaseFile:    examples.DropdownMenuSubmenu(),
					PreviewCodeFile: "dropdownmenu_submenu.templ",
					ID:              "submenu",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Shortcuts",
					ShowcaseFile:    examples.DropdownMenuShortcuts(),
					PreviewCodeFile: "dropdownmenu_shortcuts.templ",
					ID:              "shortcuts",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Icons",
					ShowcaseFile:    examples.DropdownMenuIcons(),
					PreviewCodeFile: "dropdownmenu_icons.templ",
					ID:              "icons",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Checkboxes",
					ShowcaseFile:    examples.DropdownMenuCheckboxes(),
					PreviewCodeFile: "dropdownmenu_checkboxes.templ",
					ID:              "checkboxes",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Checkboxes Icons",
					ShowcaseFile:    examples.DropdownMenuCheckboxesIcons(),
					PreviewCodeFile: "dropdownmenu_checkboxes_icons.templ",
					ID:              "checkboxes-icons",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Radio Group",
					ShowcaseFile:    examples.DropdownMenuRadioGroupExample(),
					PreviewCodeFile: "dropdownmenu_radio_group.templ",
					ID:              "radio-group",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Radio Icons",
					ShowcaseFile:    examples.DropdownMenuRadioIcons(),
					PreviewCodeFile: "dropdownmenu_radio_icons.templ",
					ID:              "radio-icons",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Destructive",
					ShowcaseFile:    examples.DropdownMenuDestructive(),
					PreviewCodeFile: "dropdownmenu_destructive.templ",
					ID:              "destructive",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Avatar",
					ShowcaseFile:    examples.DropdownMenuAvatar(),
					PreviewCodeFile: "dropdownmenu_avatar.templ",
					ID:              "avatar",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Complex",
					ShowcaseFile:    examples.DropdownMenuComplex(),
					PreviewCodeFile: "dropdownmenu_complex.templ",
					ID:              "complex",
				})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "API Reference", ID: "api-reference"}) {
				@modules.APILegend()
				<div id="api-content" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Content",
						Description: "The menu surface, anchored to the trigger. Use Root, Trigger (attributes) and Content together.",
						Items: []modules.APITableItem{
							{Name: "Side", Type: "Side", Default: "bottom", Description: "Side of the trigger the menu opens on. Options: 'top', 'right', 'bottom', 'left'. Flips automatically when there is no room.", Required: false},
							{Name: "Align", Type: "Align", Default: "start", Description: "Alignment along the trigger edge. Options: 'start', 'center', 'end'.", Required: false},
							{Name: "SideOffset", Type: "int", Default: "4", Description: "Gap between trigger and menu in px.", Required: false},
							{Name: "AlignOffset", Type: "int", Default: "0", Description: "Shift along the aligned edge in px.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes. Set a width here (e.g. w-40); the menu defaults to the trigger width.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply to the content.", Required: false},
						},
					})
				</div>
				<div id="api-item" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Item",
						Description: "A selectable entry. Renders as a link when Href is set; closes the menu on click.",
						Items: []modules.APITableItem{
							{Name: "Variant", Type: "ItemVariant", Default: "default", Description: "Visual style. Options: 'default', 'destructive'.", Required: false},
							{Name: "Inset", Type: "bool", Default: "false", Description: "Adds left padding to align with checkbox/radio items.", Required: false},
							{Name: "Disabled", Type: "bool", Default: "false", Description: "Whether the item is disabled.", Required: false},
							{Name: "Href", Type: "string", Default: "", Description: "URL to navigate to; renders the item as an anchor.", Required: false},
							{Name: "Target", Type: "string", Default: "", Description: "Target attribute for anchor items.", Required: false},
							{Name: "PreventClose", Type: "bool", Default: "false", Description: "Keep the menu open after the item is clicked.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply to the item.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply to the item.", Required: false},
						},
					})
				</div>
				<div id="api-checkbox-item" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "CheckboxItem",
						Description: "A toggleable entry with a check indicator. Emits a 'dropdownmenu-checked-change' event; keeps the menu open.",
						Items: []modules.APITableItem{
							{Name: "Checked", Type: "bool", Default: "false", Description: "Whether the item starts checked.", Required: false},
							{Name: "Disabled", Type: "bool", Default: "false", Description: "Whether the item is disabled.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply to the item.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply to the item.", Required: false},
						},
					})
				</div>
				<div id="api-radio-item" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "RadioItem",
						Description: "An exclusive-choice entry inside a RadioGroup. Emits a 'dropdownmenu-value-change' event; keeps the menu open.",
						Items: []modules.APITableItem{
							{Name: "Value", Type: "string", Default: "", Description: "Identifies the item within its RadioGroup (exposed in the event detail).", Required: false},
							{Name: "Checked", Type: "bool", Default: "false", Description: "Whether the item starts selected.", Required: false},
							{Name: "Disabled", Type: "bool", Default: "false", Description: "Whether the item is disabled.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply to the item.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply to the item.", Required: false},
						},
					})
				</div>
				<div id="api-sub-trigger">
					@modules.APITable(modules.APITableProps{
						Title:       "SubTrigger",
						Description: "Opens a nested SubContent on hover or click. Use inside Sub together with SubContent.",
						Items: []modules.APITableItem{
							{Name: "Inset", Type: "bool", Default: "false", Description: "Adds left padding to align with checkbox/radio items.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply to the trigger.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply to the trigger.", Required: false},
						},
					})
				</div>
			}
		}
	}
}
