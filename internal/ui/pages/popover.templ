package pages

import (
	"github.com/templui/templui/internal/ui/layouts"
	"github.com/templui/templui/internal/ui/modules"
	"github.com/templui/templui/internal/ui/showcase"
)

templ Popover() {
	@layouts.DocsLayout(
		"Popover",
		"Displays rich content in a floating layer using the browser popover API and Floating UI.",
		[]modules.TableOfContentsItem{
			{ID: "installation", Text: "Installation"},
			{
				Text: "Examples",
				ID:   "examples",
				Children: []modules.TableOfContentsItem{
					{Text: "Basic", ID: "basic"},
					{Text: "Align", ID: "align"},
					{Text: "With Form", ID: "with-form"},
				},
			},
			{
				ID:   "api",
				Text: "API Reference",
				Children: []modules.TableOfContentsItem{
					{ID: "api-root", Text: "Root"},
					{ID: "api-trigger", Text: "Trigger"},
					{ID: "api-content", Text: "Content"},
				},
			},
			{ID: "javascript-api", Text: "JavaScript API"},
		},
	) {
		@modules.PageWrapper(modules.PageWrapperProps{
			Name:        "Popover",
			Description: templ.Raw(`Displays rich content in a floating layer using the native browser <a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Global_attributes/popover" target="_blank" rel="noopener" class="text-primary underline underline-offset-2 hover:opacity-80 transition-opacity">popover API</a> and <a href="https://floating-ui.com/" target="_blank" rel="noopener" class="text-primary underline underline-offset-2 hover:opacity-80 transition-opacity">Floating UI</a> for positioning.`),
			Tailwind:    true,
			VanillaJS:   true,
			Breadcrumbs: modules.Breadcrumbs{
				Items: []modules.BreadcrumbItem{
					{Text: "Docs", Path: "/docs"},
					{Text: "Components", Path: "/docs/components"},
					{Text: "Popover"},
				},
			},
		}) {
			@modules.ExampleWrapper(modules.ExampleWrapperProps{
				ShowcaseFile:    showcase.PopoverDefault(),
				PreviewCodeFile: "popover_default.templ",
			})
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "Installation", ID: "installation"}) {
				@modules.ComponentUsage(modules.ComponentUsageProps{ComponentName: "popover"})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "Examples", ID: "examples"}) {
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Basic",
					ShowcaseFile:    showcase.PopoverBasic(),
					PreviewCodeFile: "popover_basic.templ",
					ID:              "basic",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Align",
					ShowcaseFile:    showcase.PopoverAlignments(),
					PreviewCodeFile: "popover_alignments.templ",
					ID:              "align",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "With Form",
					ShowcaseFile:    showcase.PopoverForm(),
					PreviewCodeFile: "popover_form.templ",
					ID:              "with-form",
				})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "API Reference", ID: "api"}) {
				@modules.APILegend()
				<div id="api-root" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Root",
						Description: "The root that links Trigger and Content via ctx. Renders no element.",
						Items: []modules.APITableItem{
							{Name: "ID", Type: "string", Default: "randomID", Description: "Optional id linking trigger and content, also used by the JavaScript API.", Required: false},
						},
					})
				</div>
				<div id="api-trigger" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Trigger",
						Description: "popover.Trigger(ctx) returns the attributes that turn any element into the trigger, usually spread onto a Button.",
						Items: []modules.APITableItem{
							{Name: "ctx", Type: "context.Context", Default: "", Description: "The templ context inside Root, carrying the popover id.", Required: true},
						},
					})
				</div>
				<div id="api-content" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Content",
						Description: "The floating surface, portaled to the body and rendered in the native top layer.",
						Items: []modules.APITableItem{
							{Name: "Side", Type: "Side", Default: "bottom", Description: "Side of the trigger to open against. Options: 'top', 'right', 'bottom', 'left'.", Required: false},
							{Name: "Align", Type: "Align", Default: "center", Description: "Alignment along the trigger edge. Options: 'start', 'center', 'end'.", Required: false},
							{Name: "SideOffset", Type: "int", Default: "4", Description: "Gap to the trigger in px.", Required: false},
							{Name: "AlignOffset", Type: "int", Default: "0", Description: "Shift along the aligned edge in px.", Required: false},
							{Name: "ID", Type: "string", Default: "Root ID", Description: "Optional HTML id for the content element.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply to the content.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply to the content.", Required: false},
						},
					})
				</div>
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "JavaScript API", ID: "javascript-api"}) {
				@modules.Code(modules.CodeProps{
					CodeContent: `window.tui.popover.open("root-id");
window.tui.popover.close("root-id");
window.tui.popover.closeAll();
window.tui.popover.toggle("root-id");
const isOpen = window.tui.popover.isOpen("root-id");`,
					ShowCopyButton: true,
				})
			}
		}
	}
}
