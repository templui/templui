package pages

import (
	"github.com/templui/templui/internal/ui/layouts"
	"github.com/templui/templui/internal/ui/modules"
	"github.com/templui/templui/internal/ui/showcase"
)

templ Collapsible() {
	@layouts.DocsLayout(
		"Collapsible",
		"An interactive component which expands/collapses a panel.",
		[]modules.TableOfContentsItem{
			{
				ID:   "installation",
				Text: "Installation",
			},
			{
				ID:   "api",
				Text: "API Reference",
				Children: []modules.TableOfContentsItem{
					{
						ID:   "api-collapsible",
						Text: "Collapsible",
					},
					{
						ID:   "api-trigger",
						Text: "Trigger",
					},
					{
						ID:   "api-content",
						Text: "Content",
					},
				},
			},
		},
	) {
		@modules.PageWrapper(modules.PageWrapperProps{
			Name:        "Collapsible",
			Description: templ.Raw("An interactive component which expands/collapses a panel."),
			Tailwind:    true,
			VanillaJS:   true,
			Breadcrumbs: modules.Breadcrumbs{
				Items: []modules.BreadcrumbItem{
					{
						Text: "Docs",
						Path: "/docs",
					},
					{
						Text: "Components",
						Path: "/docs/components",
					},
					{
						Text: "Collapsible",
					},
				},
			},
		}) {
			@modules.ExampleWrapper(modules.ExampleWrapperProps{
				ShowcaseFile:    showcase.CollapsibleDefault(),
				PreviewCodeFile: "collapsible_default.templ",
			})
			@modules.ContainerWrapper(modules.ContainerWrapperProps{
				Title: "Installation",
				ID:    "installation",
			}) {
				@modules.ComponentUsage(modules.ComponentUsageProps{
					ComponentName: "collapsible",
				})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{
				Title: "API Reference",
				ID:    "api",
			}) {
				@modules.APILegend()
				<div id="api-collapsible" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Collapsible",
						Description: "Root container that links Trigger and Content and carries the open state (data-open/data-closed).",
						Items: []modules.APITableItem{
							{
								Name:        "ID",
								Type:        "string",
								Default:     "randomID",
								Description: "Optional id linking trigger and content.",
								Required:    false,
							},
							{
								Name:        "Class",
								Type:        "string",
								Default:     "",
								Description: "Additional CSS classes to apply to the collapsible.",
								Required:    false,
							},
							{
								Name:        "Attributes",
								Type:        "templ.Attributes",
								Default:     "",
								Description: "Additional HTML attributes to apply to the collapsible element.",
								Required:    false,
							},
							{
								Name:        "Open",
								Type:        "bool",
								Default:     "false",
								Description: "Whether the collapsible is initially open.",
								Required:    false,
							},
						},
					})
				</div>
				<div id="api-trigger" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Trigger",
						Description: "collapsible.Trigger(ctx) returns the attributes that turn any element into the trigger, usually spread onto a Button. Sets data-panel-open while expanded for styling hooks.",
						Items: []modules.APITableItem{
							{
								Name:        "ctx",
								Type:        "context.Context",
								Default:     "",
								Description: "The templ context inside Collapsible, carrying the collapsible id.",
								Required:    true,
							},
						},
					})
				</div>
				<div id="api-content" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Content",
						Description: "The panel: hidden while closed, unstyled like Base UI. Its measured height is exposed as --tui-collapsible-panel-height for custom animations.",
						Items: []modules.APITableItem{
							{
								Name:        "Class",
								Type:        "string",
								Default:     "",
								Description: "Additional CSS classes to apply to the content container.",
								Required:    false,
							},
							{
								Name:        "Attributes",
								Type:        "templ.Attributes",
								Default:     "",
								Description: "Additional HTML attributes to apply to the content element.",
								Required:    false,
							},
						},
					})
				</div>
			}
		}
	}
}
