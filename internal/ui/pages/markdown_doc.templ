package pages

import (
	"github.com/axadrn/shadcn-templ/v2/internal/service"
	"github.com/axadrn/shadcn-templ/v2/internal/ui/layouts"
	"github.com/axadrn/shadcn-templ/v2/internal/ui/modules"
)

templ MarkdownDoc(doc *service.DocPage, prev, next PagerLink) {
	@layouts.DocsLayout(
		doc.Title,
		doc.Description,
		doc.TOC,
	) {
		@modules.DocsCodeToggleScript()
		// shadcn's docs column: header and content are siblings in a gap-6
		// flex column (app/(app)/docs/[[...slug]]/page.tsx line 96).
		<div class="flex w-full flex-1 flex-col gap-6">
			@modules.DocsPageHeader(doc.Title, doc.Description, prev.Href, next.Href)
			<div class="typeset w-full flex-1 pb-16 sm:pb-0">
				for _, segment := range doc.Segments {
					@renderSegment(segment)
				}
			</div>
			@modules.DocsPager(prev.Title, prev.Href, next.Title, next.Href)
		</div>
	}
}
