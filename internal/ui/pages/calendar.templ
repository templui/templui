package pages

import (
	"github.com/templui/templui/internal/ui/layouts"
	"github.com/templui/templui/internal/ui/modules"
	"github.com/templui/templui/internal/ui/examples"
)

templ Calendar() {
	@layouts.DocsLayout(
		"Calendar",
		"A date field component that allows users to enter and edit date.",
		[]modules.TableOfContentsItem{
			{ID: "installation", Text: "Installation"},
			{
				ID:   "examples",
				Text: "Examples",
				Children: []modules.TableOfContentsItem{
					{Text: "Range Calendar", ID: "range-calendar"},
					{Text: "Month and Year Selector", ID: "caption"},
					{Text: "Presets", ID: "presets"},
					{Text: "Date and Time Picker", ID: "date-and-time-picker"},
					{Text: "Booked dates", ID: "booked-dates"},
					{Text: "Custom Cell Size", ID: "custom-cell-size"},
					{Text: "Week Numbers", ID: "week-numbers"},
				},
			},
			{
				ID:   "api",
				Text: "API Reference",
				Children: []modules.TableOfContentsItem{
					{ID: "api-calendar", Text: "Calendar"},
				},
			},
		},
	) {
		@modules.PageWrapper(modules.PageWrapperProps{
			Name:        "Calendar",
			Description: templ.Raw("A date field component that allows users to enter and edit date."),
			Tailwind:    true,
			VanillaJS:   true,
			Breadcrumbs: modules.Breadcrumbs{
				Items: []modules.BreadcrumbItem{
					{Text: "Docs", Path: "/docs"},
					{Text: "Components", Path: "/docs/components"},
					{Text: "Calendar"},
				},
			},
		}) {
			@modules.ExampleWrapper(modules.ExampleWrapperProps{
				ShowcaseFile:    examples.CalendarDefault(),
				PreviewCodeFile: "calendar_default.templ",
			})
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "Installation", ID: "installation"}) {
				@modules.ComponentUsage(modules.ComponentUsageProps{ComponentName: "calendar"})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "Examples", ID: "examples"}) {
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Range Calendar",
					ShowcaseFile:    examples.CalendarRange(),
					PreviewCodeFile: "calendar_range.templ",
					ID:              "range-calendar",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Month and Year Selector",
					ShowcaseFile:    examples.CalendarCaption(),
					PreviewCodeFile: "calendar_caption.templ",
					ID:              "caption",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Presets",
					ShowcaseFile:    examples.CalendarPresets(),
					PreviewCodeFile: "calendar_presets.templ",
					ID:              "presets",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Date and Time Picker",
					ShowcaseFile:    examples.CalendarTime(),
					PreviewCodeFile: "calendar_time.templ",
					ID:              "date-and-time-picker",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Booked dates",
					ShowcaseFile:    examples.CalendarBookedDates(),
					PreviewCodeFile: "calendar_booked_dates.templ",
					ID:              "booked-dates",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Custom Cell Size",
					ShowcaseFile:    examples.CalendarCustomCellSize(),
					PreviewCodeFile: "calendar_custom_cell_size.templ",
					ID:              "custom-cell-size",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Week Numbers",
					ShowcaseFile:    examples.CalendarWeekNumbers(),
					PreviewCodeFile: "calendar_week_numbers.templ",
					ID:              "week-numbers",
				})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "API Reference", ID: "api"}) {
				@modules.APILegend()
				<div id="api-calendar">
					@modules.APITable(modules.APITableProps{
						Title:       "Calendar",
						Description: "Date grid with single or range selection. Emits a 'calendar-change' event and accepts a 'calendar-set' event.",
						Items: []modules.APITableItem{
							{Name: "Mode", Type: "Mode", Default: "single", Description: "Selection mode. Options: 'single', 'range'.", Required: false},
							{Name: "CaptionLayout", Type: "CaptionLayout", Default: "label", Description: "Caption style. Options: 'label', 'dropdown' (month and year selects).", Required: false},
							{Name: "Value", Type: "time.Time", Default: "", Description: "Preselected date, or the range start in range mode.", Required: false},
							{Name: "EndValue", Type: "time.Time", Default: "", Description: "Preselected range end (range mode).", Required: false},
							{Name: "Month", Type: "time.Time", Default: "Value or now", Description: "Initially displayed month.", Required: false},
							{Name: "Name", Type: "string", Default: "", Description: "Form field name. Renders a hidden input with the ISO date.", Required: false},
							{Name: "EndName", Type: "string", Default: "Name + \"-end\"", Description: "Hidden input name for the range end.", Required: false},
							{Name: "NumberOfMonths", Type: "int", Default: "1", Description: "Months rendered side by side.", Required: false},
							{Name: "StartOfWeek", Type: "Day", Default: "Sunday", Description: "First weekday, 0-6 from Sunday.", Required: false},
							{Name: "LocaleTag", Type: "LocaleTag", Default: "en-US", Description: "BCP 47 locale for month and weekday names.", Required: false},
							{Name: "HideOutsideDays", Type: "bool", Default: "false", Description: "Hides days of adjacent months.", Required: false},
							{Name: "FixedWeeks", Type: "bool", Default: "false", Description: "Always renders six weeks.", Required: false},
							{Name: "ShowWeekNumbers", Type: "bool", Default: "false", Description: "Renders an ISO week number column.", Required: false},
							{Name: "MinDate", Type: "time.Time", Default: "", Description: "Earliest selectable date.", Required: false},
							{Name: "MaxDate", Type: "time.Time", Default: "", Description: "Latest selectable date.", Required: false},
							{Name: "DisabledDates", Type: "[]time.Time", Default: "", Description: "Dates that cannot be selected.", Required: false},
							{Name: "BookedDates", Type: "[]time.Time", Default: "", Description: "Unselectable dates rendered struck through.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply.", Required: false},
						},
					})
				</div>
			}
		}
	}
}
