package pages

import (
	"github.com/templui/templui/internal/ui/layouts"
	"github.com/templui/templui/internal/ui/modules"
	"github.com/templui/templui/internal/ui/examples"
)

templ Toast() {
	@layouts.DocsLayout(
		"Toast",
		"An opinionated toast component. A vanilla port of sonner, the library shadcn ships.",
		[]modules.TableOfContentsItem{
			{ID: "installation", Text: "Installation"},
			{ID: "usage", Text: "Usage"},
			{
				ID:   "examples",
				Text: "Examples",
				Children: []modules.TableOfContentsItem{
					{Text: "Types", ID: "types"},
					{Text: "Description", ID: "description"},
					{Text: "Position", ID: "position"},
					{Text: "HTMX", ID: "htmx"},
				},
			},
			{
				ID:   "api",
				Text: "API Reference",
				Children: []modules.TableOfContentsItem{
					{ID: "api-toaster", Text: "Toaster"},
					{ID: "api-toast", Text: "Toast"},
				},
			},
			{ID: "javascript-api", Text: "JavaScript API"},
		},
	) {
		@modules.PageWrapper(modules.PageWrapperProps{
			Name:        "Toast",
			Description: templ.Raw("An opinionated toast component. A vanilla port of sonner, the library shadcn ships."),
			Tailwind:    true,
			VanillaJS:   true,
			Breadcrumbs: modules.Breadcrumbs{
				Items: []modules.BreadcrumbItem{
					{Text: "Docs", Path: "/docs"},
					{Text: "Components", Path: "/docs/components"},
					{Text: "Toast"},
				},
			},
		}) {
			@modules.ExampleWrapper(modules.ExampleWrapperProps{
				ShowcaseFile:    examples.ToastDefault(),
				PreviewCodeFile: "toast_default.templ",
			})
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "Installation", ID: "installation"}) {
				@modules.ComponentUsage(modules.ComponentUsageProps{ComponentName: "toast"})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "Usage", ID: "usage"}) {
				<p class="mb-4 text-sm text-muted-foreground">
					Add the vendored <code>sonner.css</code> next to your input css and import it once:
				</p>
				@modules.Code(modules.CodeProps{
					CodeContent:    `@import "./sonner.css";`,
					ShowCopyButton: true,
				})
				<p class="my-4 text-sm text-muted-foreground">
					Render the Toaster once in your layout, then trigger toasts from JavaScript or from the server:
				</p>
				@modules.Code(modules.CodeProps{
					CodeContent: `@toast.Toaster(toast.ToasterProps{ID: "toaster"})

// JavaScript
window.tui.toast("Event has been created")

// Server (htmx): render a toast into the response, out of band
@toast.Toast(toast.Props{
	Title:      "Changes saved",
	Variant:    toast.VariantSuccess,
	Attributes: templ.Attributes{"hx-swap-oob": "beforeend:#toaster"},
})`,
					ShowCopyButton: true,
				})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "Examples", ID: "examples"}) {
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Types",
					ShowcaseFile:    examples.ToastTypes(),
					PreviewCodeFile: "toast_types.templ",
					ID:              "types",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Description",
					ShowcaseFile:    examples.ToastDescription(),
					PreviewCodeFile: "toast_description.templ",
					ID:              "description",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Position",
					ShowcaseFile:    examples.ToastPosition(),
					PreviewCodeFile: "toast_position.templ",
					ID:              "position",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "HTMX",
					ShowcaseFile:    examples.ToastHtmx(),
					PreviewCodeFile: "toast_htmx.templ",
					ID:              "htmx",
				})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "API Reference", ID: "api"}) {
				@modules.APILegend()
				<div id="api-toaster" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Toaster",
						Description: "The stack viewport, rendered once per page (usually in the layout). Server toasts are swapped into it, e.g. with hx-target and hx-swap beforeend.",
						Items: []modules.APITableItem{
							{Name: "Position", Type: "Position", Default: "bottom-right", Description: "Stack position. Options: 'top-left', 'top-center', 'top-right', 'bottom-left', 'bottom-center', 'bottom-right'.", Required: false},
							{Name: "Duration", Type: "int", Default: "4000", Description: "Default auto-dismiss duration in ms.", Required: false},
							{Name: "CloseButton", Type: "bool", Default: "false", Description: "Shows a close button on every toast.", Required: false},
							{Name: "RichColors", Type: "bool", Default: "false", Description: "Colors success, info, warning and error toasts.", Required: false},
							{Name: "ID", Type: "string", Default: "", Description: "HTML id, e.g. as an htmx target.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply.", Required: false},
						},
					})
				</div>
				<div id="api-toast">
					@modules.APITable(modules.APITableProps{
						Title:       "Toast",
						Description: "One server-rendered toast. Place it inside the Toaster; the script mounts, stacks and dismisses it.",
						Items: []modules.APITableItem{
							{Name: "Title", Type: "string", Default: "", Description: "The toast message.", Required: false},
							{Name: "Description", Type: "string", Default: "", Description: "Secondary line below the title.", Required: false},
							{Name: "Variant", Type: "Variant", Default: "default", Description: "Options: 'default', 'success', 'info', 'warning', 'error', 'loading'.", Required: false},
							{Name: "Duration", Type: "int", Default: "Toaster default", Description: "Auto-dismiss duration in ms, -1 disables.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply.", Required: false},
						},
					})
				</div>
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "JavaScript API", ID: "javascript-api"}) {
				@modules.Code(modules.CodeProps{
					CodeContent: `window.tui.toast("Event has been created");
window.tui.toast.success("Saved", { description: "All good." });
window.tui.toast.error("Something went wrong", { duration: 8000 });
window.tui.toast("With action", { action: { label: "Undo", onClick: () => {} } });
window.tui.toast("Elsewhere", { position: "top-center" });
window.tui.toast.dismiss();`,
					ShowCopyButton: true,
				})
			}
		}
	}
}
