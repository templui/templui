package pages

import (
	"github.com/templui/templui/internal/ui/layouts"
	"github.com/templui/templui/internal/ui/modules"
	"github.com/templui/templui/internal/ui/examples"
)

templ HoverCard() {
	@layouts.DocsLayout(
		"Hover Card",
		"Displays rich content in a card when hovering over a trigger. Uses Popover for the popup.",
		[]modules.TableOfContentsItem{
			{ID: "installation", Text: "Installation"},
			{
				Text: "Examples",
				ID:   "examples",
				Children: []modules.TableOfContentsItem{
					{Text: "Sides", ID: "sides"},
				},
			},
			{
				ID:   "api",
				Text: "API Reference",
				Children: []modules.TableOfContentsItem{
					{ID: "api-root", Text: "Root"},
					{ID: "api-trigger", Text: "Trigger"},
					{ID: "api-content", Text: "Content"},
				},
			},
		},
	) {
		@modules.PageWrapper(modules.PageWrapperProps{
			Name:        "Hover Card",
			Description: templ.Raw("Displays rich content in a card when hovering over a trigger. Uses Popover for the popup and positioning."),
			Tailwind:    true,
			VanillaJS:   true,
			Breadcrumbs: modules.Breadcrumbs{
				Items: []modules.BreadcrumbItem{
					{Text: "Docs", Path: "/docs"},
					{Text: "Components", Path: "/docs/components"},
					{Text: "Hover Card"},
				},
			},
		}) {
			@modules.ExampleWrapper(modules.ExampleWrapperProps{
				ShowcaseFile:    examples.HoverCardDefault(),
				PreviewCodeFile: "hovercard_default.templ",
			})
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "Installation", ID: "installation"}) {
				@modules.ComponentUsage(modules.ComponentUsageProps{ComponentName: "hovercard"})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "Examples", ID: "examples"}) {
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Sides",
					ShowcaseFile:    examples.HoverCardSides(),
					PreviewCodeFile: "hovercard_sides.templ",
					ID:              "sides",
				})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "API Reference", ID: "api"}) {
				@modules.APILegend()
				<div id="api-root" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "HoverCard",
						Description: "The root that links Trigger and Content via ctx. Renders no element.",
						Items: []modules.APITableItem{
							{Name: "ID", Type: "string", Default: "randomID", Description: "Optional id linking trigger and content.", Required: false},
							{Name: "OpenDelay", Type: "int", Default: "700", Description: "Delay in milliseconds before showing the card on hover.", Required: false},
							{Name: "CloseDelay", Type: "int", Default: "300", Description: "Delay in milliseconds before hiding the card on hover out.", Required: false},
						},
					})
				</div>
				<div id="api-trigger" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Trigger",
						Description: "hovercard.Trigger(ctx) returns the attributes that turn any element into the trigger, usually spread onto a link.",
						Items: []modules.APITableItem{
							{Name: "ctx", Type: "context.Context", Default: "", Description: "The templ context inside HoverCard, carrying the card id.", Required: true},
						},
					})
				</div>
				<div id="api-content" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Content",
						Description: "The hover card surface, portaled to the body and rendered in the native top layer.",
						Items: []modules.APITableItem{
							{Name: "Side", Type: "Side", Default: "bottom", Description: "Side of the trigger the card opens on. Options: 'top', 'right', 'bottom', 'left'. Flips automatically when there is no room.", Required: false},
							{Name: "Align", Type: "Align", Default: "center", Description: "Alignment along the trigger edge. Options: 'start', 'center', 'end'.", Required: false},
							{Name: "SideOffset", Type: "int", Default: "4", Description: "Gap to the trigger in px.", Required: false},
							{Name: "AlignOffset", Type: "int", Default: "4", Description: "Shift along the aligned edge in px; only applies with Align start or end.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes. Override the default width (w-64) here.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply to the content element.", Required: false},
						},
					})
				</div>
			}
		}
	}
}
