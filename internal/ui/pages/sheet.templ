package pages 

import (
	"github.com/templui/templui/internal/ui/layouts"
	"github.com/templui/templui/internal/ui/modules"
	"github.com/templui/templui/internal/ui/showcase"
)

templ Sheet() {
	@layouts.DocsLayout(
		"Sheet",
		"Extends the Dialog component to display content that complements the main content of the screen.",
		[]modules.TableOfContentsItem{
			{
				ID:   "installation",
				Text: "Installation",
			},
			{
				ID:   "examples",
				Text: "Examples",
				Children: []modules.TableOfContentsItem{
					{
						ID:   "sheet-sides",
						Text: "Sheet Sides",
					},
					{
						ID:   "external-trigger",
						Text: "External Trigger",
					},
				},
			},
			{
				ID:   "api-reference",
				Text: "API Reference",
				Children: []modules.TableOfContentsItem{
					{
						ID:   "api-sheet",
						Text: "Sheet",
					},
					{
						ID:   "api-trigger",
						Text: "Trigger",
					},
					{
						ID:   "api-content",
						Text: "Content",
					},
					{
						ID:   "api-header",
						Text: "Header",
					},
					{
						ID:   "api-title",
						Text: "Title",
					},
					{
						ID:   "api-description",
						Text: "Description",
					},
					{
						ID:   "api-footer",
						Text: "Footer",
					},
					{
						ID:   "api-close",
						Text: "Close",
					},
				},
			},
		},
	) {
		@modules.PageWrapper(modules.PageWrapperProps{
			Name:        "Sheet",
			Description: templ.Raw("Extends the <a href=\"/docs/components/dialog\" class=\"text-primary underline underline-offset-2 hover:opacity-80 transition-opacity\">Dialog</a> component to display content that complements the main content of the screen."),
			Tailwind:    true,
			VanillaJS:   true,
			Breadcrumbs: modules.Breadcrumbs{
				Items: []modules.BreadcrumbItem{
					{
						Text: "Docs",
						Path: "/docs",
					},
					{
						Text: "Components",
						Path: "/docs/components",
					},
					{
						Text: "Sheet",
					},
				},
			},
		}) {
			@modules.ExampleWrapper(modules.ExampleWrapperProps{
				ShowcaseFile:    showcase.SheetDefault(),
				PreviewCodeFile: "sheet_default.templ",
			})
			@modules.ContainerWrapper(modules.ContainerWrapperProps{
				Title: "Examples",
				ID:    "examples",
			}) {
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Sheet Sides",
					ShowcaseFile:    showcase.SheetSides(),
					PreviewCodeFile: "sheet_sides.templ",
					ID:              "sheet-sides",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "External Trigger",
					ShowcaseFile:    showcase.SheetExternalTrigger(),
					PreviewCodeFile: "sheet_external_trigger.templ",
					ID:              "external-trigger",
				})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{
				Title: "Installation",
				ID:    "installation",
			}) {
				@modules.ComponentUsage(modules.ComponentUsageProps{
					ComponentName: "sheet",
				})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{
				Title: "API Reference",
				ID:    "api-reference",
			}) {
				@modules.APILegend()
				<div id="api-sheet" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Sheet",
						Description: "The root that links Trigger, Content and Close via ctx. Renders no element.",
						Items: []modules.APITableItem{
							{
								Name:        "ID",
								Type:        "string",
								Default:     "randomID",
								Description: "Optional id linking trigger and content, also used for external triggers and the JavaScript API.",
							},
							{
								Name:        "Side",
								Type:        "Side",
								Default:     "SideRight",
								Description: "Side from which the sheet slides in (top, right, bottom, left)",
							},
							{
								Name:        "Open",
								Type:        "bool",
								Default:     "false",
								Description: "Whether the sheet should be open initially",
							},
							{
								Name:        "DisableClickAway",
								Type:        "bool",
								Default:     "false",
								Description: "Disable closing the sheet when clicking the backdrop",
							},
							{
								Name:        "DisableESC",
								Type:        "bool",
								Default:     "false",
								Description: "Disable closing the sheet with the ESC key",
							},
						},
					})
				</div>
				<div id="api-trigger" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Trigger",
						Description: "sheet.Trigger(ctx) returns the attributes that turn any element into the trigger, usually spread onto a Button. Use sheet.TriggerFor(id) to target a sheet outside the current root.",
						Items: []modules.APITableItem{
							{
								Name:        "ctx",
								Type:        "context.Context",
								Default:     "",
								Description: "The templ context inside Sheet, carrying the sheet id.",
								Required:    true,
							},
						},
					})
				</div>
				<div id="api-content" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title: "Content",
						Items: []modules.APITableItem{
							{
								Name:        "Class",
								Type:        "string",
								Default:     "\"\"",
								Description: "Additional CSS classes to apply to the content container",
							},
							{
								Name:        "Attributes",
								Type:        "templ.Attributes",
								Default:     "nil",
								Description: "Additional HTML attributes to apply to the content container",
							},
							{
								Name:        "HideCloseButton",
								Type:        "bool",
								Default:     "false",
								Description: "Hide the close X button in the top right corner",
							},
						},
					})
				</div>
				<div id="api-header" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title: "Header",
						Items: []modules.APITableItem{
							{
								Name:        "ID",
								Type:        "string",
								Default:     "\"\"",
								Description: "Unique identifier for the header element",
							},
							{
								Name:        "Class",
								Type:        "string",
								Default:     "\"\"",
								Description: "Additional CSS classes to apply to the header",
							},
							{
								Name:        "Attributes",
								Type:        "templ.Attributes",
								Default:     "nil",
								Description: "Additional HTML attributes to apply to the header",
							},
						},
					})
				</div>
				<div id="api-title" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title: "Title",
						Items: []modules.APITableItem{
							{
								Name:        "ID",
								Type:        "string",
								Default:     "\"\"",
								Description: "Unique identifier for the title element",
							},
							{
								Name:        "Class",
								Type:        "string",
								Default:     "\"\"",
								Description: "Additional CSS classes to apply to the title",
							},
							{
								Name:        "Attributes",
								Type:        "templ.Attributes",
								Default:     "nil",
								Description: "Additional HTML attributes to apply to the title",
							},
						},
					})
				</div>
				<div id="api-description" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title: "Description",
						Items: []modules.APITableItem{
							{
								Name:        "ID",
								Type:        "string",
								Default:     "\"\"",
								Description: "Unique identifier for the description element",
							},
							{
								Name:        "Class",
								Type:        "string",
								Default:     "\"\"",
								Description: "Additional CSS classes to apply to the description",
							},
							{
								Name:        "Attributes",
								Type:        "templ.Attributes",
								Default:     "nil",
								Description: "Additional HTML attributes to apply to the description",
							},
						},
					})
				</div>
				<div id="api-footer" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title: "Footer",
						Items: []modules.APITableItem{
							{
								Name:        "ID",
								Type:        "string",
								Default:     "\"\"",
								Description: "Unique identifier for the footer element",
							},
							{
								Name:        "Class",
								Type:        "string",
								Default:     "\"\"",
								Description: "Additional CSS classes to apply to the footer",
							},
							{
								Name:        "Attributes",
								Type:        "templ.Attributes",
								Default:     "nil",
								Description: "Additional HTML attributes to apply to the footer",
							},
						},
					})
				</div>
				<div id="api-close">
					@modules.APITable(modules.APITableProps{
						Title:       "Close",
						Description: "sheet.Close(ctx) returns the attributes that make any element close the sheet. Use sheet.CloseFor(id) to target a sheet outside the current root.",
						Items: []modules.APITableItem{
							{
								Name:        "ctx",
								Type:        "context.Context",
								Default:     "",
								Description: "The templ context inside Sheet, carrying the sheet id.",
								Required:    true,
							},
						},
					})
				</div>
			}
		}
	}
}
