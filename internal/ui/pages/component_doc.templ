package pages

import (
	"github.com/axadrn/shadcn-templ/v2/components/tabs"
	"github.com/axadrn/shadcn-templ/v2/internal/markdown"
	"github.com/axadrn/shadcn-templ/v2/internal/service"
	"github.com/axadrn/shadcn-templ/v2/internal/ui/layouts"
	"github.com/axadrn/shadcn-templ/v2/internal/ui/modules"
	"github.com/axadrn/shadcn-templ/v2/internal/ui/examples"
	"github.com/axadrn/shadcn-templ/v2/utils"
)

// PagerLink points to the previous/next component page.
type PagerLink struct {
	Title string
	Href  string
}

// ComponentDoc renders a markdown-authored component page (the shadcn mdx
// pendant): frontmatter header, markdown prose and shortcode blocks resolved
// against the examples registry.
templ ComponentDoc(page *service.ComponentDocPage, prev, next PagerLink) {
	@layouts.DocsLayout(
		page.Title,
		page.Description,
		page.TOC,
	) {
		@modules.DocsCodeToggleScript()
		// shadcn's docs column: header and content are siblings in a gap-6
		// flex column (app/(app)/docs/[[...slug]]/page.tsx line 96).
		<div class="flex w-full flex-1 flex-col gap-6">
			@modules.DocsPageHeader(page.Title, page.Description, prev.Href, next.Href)
			<div class="typeset w-full flex-1 pb-16 sm:pb-0">
				for _, segment := range page.Segments {
					@renderSegment(segment)
				}
			</div>
			@modules.DocsPager(prev.Title, prev.Href, next.Title, next.Href)
		</div>
	}
}

templ renderSegment(segment markdown.Segment) {
	switch segment.Shortcode {
		case "":
			@templ.Raw(segment.HTML)
		case "ComponentPreview":
			if entry, ok := examples.Registry[segment.Attrs["name"]]; ok {
				if segment.Attrs["type"] == "block" {
					@modules.BlockPreview(segment.Attrs["name"], segment.Attrs)
				} else {
					@modules.ComponentPreviewBlock(entry, segment.Attrs)
				}
			} else {
				<div class="my-6 rounded-lg border border-destructive/50 p-4 text-sm text-destructive">
					Unknown preview: { segment.Attrs["name"] }
				</div>
			}
		case "ComponentSource":
			@modules.ComponentSourceBlock(segment.Attrs["name"], segment.Attrs["title"])
		case "Callout":
			@modules.CalloutBlock(segment.Attrs["className"]) {
				@templ.Raw(segment.HTML)
			}
		case "Steps":
			// The shadcn Steps wrapper: a numbered timeline; the div stays
			// open across the following segments until StepsEnd closes it.
			@templ.Raw(`<div class="` + utils.CN("steps mb-12 [counter-reset:step] md:ml-4 md:border-l md:pl-8 [&>h3]:step", segment.Attrs["className"]) + `">`)
		case "StepsEnd":
			@templ.Raw("</div>")
		case "Step":
			@templ.Raw("<h3>" + segment.HTML + "</h3>")
		case "CodeCollapsibleWrapper":
			// The shadcn CodeCollapsibleWrapper: the inner code figure clamped
			// behind an Expand/Collapse toggle.
			@modules.CodeCollapsibleWrapper() {
				for _, sub := range segment.Children {
					@renderSegment(sub)
				}
			}
		case "CodeTabs":
			// The shadcn CodeTabs pendant: hand written tab blocks in the
			// markdown, each tab's body is its own segment list.
			@tabs.Tabs(tabs.Props{DefaultValue: segment.Tabs[0].Value, ID: segment.ID, Class: "relative mt-6 w-full"}) {
				@tabs.List(tabs.ListProps{
					Class: "w-fit justify-start gap-6 rounded-none bg-transparent px-0 group-data-horizontal/tabs:h-9",
				}) {
					for _, t := range segment.Tabs {
						@tabs.Trigger(tabs.TriggerProps{Value: t.Value, Class: modules.InstallTabTriggerClass}) {
							{ t.Label }
						}
					}
				}
				for _, t := range segment.Tabs {
					@tabs.Content(tabs.ContentProps{Value: t.Value}) {
						for _, sub := range t.Segments {
							@renderSegment(sub)
						}
					}
				}
			}
	}
}
