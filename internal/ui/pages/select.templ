package pages

import (
	"github.com/templui/templui/internal/ui/layouts"
	"github.com/templui/templui/internal/ui/modules"
	"github.com/templui/templui/internal/ui/examples"
)

templ Select() {
	@layouts.DocsLayout(
		"Select",
		"Displays a list of options for the user to pick from, triggered by a button.",
		[]modules.TableOfContentsItem{
			{ID: "installation", Text: "Installation"},
			{
				ID:   "examples",
				Text: "Examples",
				Children: []modules.TableOfContentsItem{
					{Text: "Align Item With Trigger", ID: "align-item"},
					{Text: "Groups", ID: "groups"},
					{Text: "Scrollable", ID: "scrollable"},
					{Text: "Disabled", ID: "disabled"},
					{Text: "Invalid", ID: "invalid"},
				},
			},
			{
				ID:   "api",
				Text: "API Reference",
				Children: []modules.TableOfContentsItem{
					{ID: "api-select", Text: "Select"},
					{ID: "api-trigger", Text: "Trigger"},
					{ID: "api-content", Text: "Content"},
					{ID: "api-item", Text: "Item"},
				},
			},
		},
	) {
		@modules.PageWrapper(modules.PageWrapperProps{
			Name:        "Select",
			Description: templ.Raw("Displays a list of options for the user to pick from, triggered by a button."),
			Tailwind:    true,
			VanillaJS:   true,
			Breadcrumbs: modules.Breadcrumbs{
				Items: []modules.BreadcrumbItem{
					{Text: "Docs", Path: "/docs"},
					{Text: "Components", Path: "/docs/components"},
					{Text: "Select"},
				},
			},
		}) {
			@modules.ExampleWrapper(modules.ExampleWrapperProps{
				ShowcaseFile:    examples.SelectDefault(),
				PreviewCodeFile: "select_default.templ",
			})
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "Installation", ID: "installation"}) {
				@modules.ComponentUsage(modules.ComponentUsageProps{ComponentName: "select"})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "Examples", ID: "examples"}) {
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Align Item With Trigger",
					ShowcaseFile:    examples.SelectAlignItem(),
					PreviewCodeFile: "select_align_item.templ",
					ID:              "align-item",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Groups",
					ShowcaseFile:    examples.SelectGroupsExample(),
					PreviewCodeFile: "select_groups.templ",
					ID:              "groups",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Scrollable",
					ShowcaseFile:    examples.SelectScrollable(),
					PreviewCodeFile: "select_scrollable.templ",
					ID:              "scrollable",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Disabled",
					ShowcaseFile:    examples.SelectDisabled(),
					PreviewCodeFile: "select_disabled.templ",
					ID:              "disabled",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Invalid",
					ShowcaseFile:    examples.SelectInvalid(),
					PreviewCodeFile: "select_invalid.templ",
					ID:              "invalid",
				})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "API Reference", ID: "api"}) {
				@modules.APILegend()
				<div id="api-select" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Select",
						Description: "The root that links Trigger, Content and the hidden form input. Renders no element.",
						Items: []modules.APITableItem{
							{Name: "Name", Type: "string", Default: "", Description: "Form field name. Renders a hidden input that submits the selected value.", Required: false},
							{Name: "Value", Type: "string", Default: "", Description: "Preselects the item with this value.", Required: false},
							{Name: "Disabled", Type: "bool", Default: "false", Description: "Disables the trigger.", Required: false},
							{Name: "ID", Type: "string", Default: "randomID", Description: "Optional id linking trigger and content.", Required: false},
						},
					})
				</div>
				<div id="api-trigger" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Trigger",
						Description: "The button that opens the listbox. Put Value inside it.",
						Items: []modules.APITableItem{
							{Name: "Size", Type: "Size", Default: "default", Description: "Trigger height. Options: 'default' (h-8), 'sm' (h-7).", Required: false},
							{Name: "Invalid", Type: "bool", Default: "false", Description: "Marks the trigger aria-invalid for error styling.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes. Set a width here (e.g. w-full max-w-48).", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply to the trigger.", Required: false},
						},
					})
				</div>
				<div id="api-content" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Content",
						Description: "The listbox surface.",
						Items: []modules.APITableItem{
							{Name: "Position", Type: "Position", Default: "item-aligned", Description: "'item-aligned' overlays the selected item on the trigger; 'popper' opens like a dropdown.", Required: false},
							{Name: "Align", Type: "Align", Default: "center", Description: "Alignment along the trigger edge in popper mode. Options: 'start', 'center', 'end'.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply to the content.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply to the content.", Required: false},
						},
					})
				</div>
				<div id="api-item">
					@modules.APITable(modules.APITableProps{
						Title:       "Item",
						Description: "A selectable option. Emits a 'select-change' event on the trigger when picked.",
						Items: []modules.APITableItem{
							{Name: "Value", Type: "string", Default: "", Description: "The value submitted when this item is selected.", Required: true},
							{Name: "Selected", Type: "bool", Default: "false", Description: "Whether the item starts selected (alternative to Select.Value).", Required: false},
							{Name: "Disabled", Type: "bool", Default: "false", Description: "Whether the item is disabled.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply to the item.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply to the item.", Required: false},
						},
					})
				</div>
			}
		}
	}
}
