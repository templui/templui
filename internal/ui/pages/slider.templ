package pages

import (
	"github.com/templui/templui/internal/ui/layouts"
	"github.com/templui/templui/internal/ui/modules"
	"github.com/templui/templui/internal/ui/examples"
)

templ Slider() {
	@layouts.DocsLayout(
		"Slider",
		"Control for selecting a numeric value within a range.",
		[]modules.TableOfContentsItem{
			{
				ID:   "installation",
				Text: "Installation",
			},
			{
				Text: "Examples",
				ID:   "examples",
				Children: []modules.TableOfContentsItem{
					{
						Text: "Value",
						ID:   "value",
					},
					{
						Text: "Steps",
						ID:   "steps",
					},
					{
						Text: "Disabled",
						ID:   "disabled",
					},
					{
						Text: "External Value",
						ID:   "external-value",
					},
					{
						Text: "Range",
						ID:   "range",
					},
				},
			},
			{
				ID:   "api-reference",
				Text: "API Reference",
				Children: []modules.TableOfContentsItem{
					{
						ID:   "api-slider",
						Text: "Slider",
					},
					{
						ID:   "api-range",
						Text: "Range",
					},
					{
						ID:   "api-value",
						Text: "Value",
					},
				},
			},
		},
	) {
		@modules.PageWrapper(modules.PageWrapperProps{
			Name:        "Slider",
			Description: templ.Raw("Control for selecting a numeric value within a range."),
			Tailwind:    true,
			VanillaJS:   true,
			Breadcrumbs: modules.Breadcrumbs{
				Items: []modules.BreadcrumbItem{
					{
						Text: "Docs",
						Path: "/docs",
					},
					{
						Text: "Components",
						Path: "/docs/components",
					},
					{
						Text: "Slider",
					},
				},
			},
		}) {
			@modules.ExampleWrapper(modules.ExampleWrapperProps{
				ShowcaseFile:    examples.SliderDefault(),
				PreviewCodeFile: "slider_default.templ",
			})
			@modules.ContainerWrapper(modules.ContainerWrapperProps{
				Title: "Installation",
				ID:    "installation",
			}) {
				@modules.ComponentUsage(modules.ComponentUsageProps{
					ComponentName: "slider",
				})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{
				Title: "Examples",
				ID:    "examples",
			}) {
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Value",
					ShowcaseFile:    examples.SliderValue(),
					PreviewCodeFile: "slider_value.templ",
					ID:              "value",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Steps",
					ShowcaseFile:    examples.SliderSteps(),
					PreviewCodeFile: "slider_steps.templ",
					ID:              "steps",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Disabled",
					ShowcaseFile:    examples.SliderDisabled(),
					PreviewCodeFile: "slider_disabled.templ",
					ID:              "disabled",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "External Value",
					ShowcaseFile:    examples.SliderExternalValue(),
					PreviewCodeFile: "slider_external_value.templ",
					ID:              "external-value",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Range",
					ShowcaseFile:    examples.SliderRange(),
					PreviewCodeFile: "slider_range.templ",
					ID:              "range",
				})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{
				Title: "API Reference",
				ID:    "api-reference",
			}) {
				@modules.APILegend()
				<div id="api-slider" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Slider",
						Description: "Single-thumb slider component.",
						Items: []modules.APITableItem{
							{
								Name:        "ID",
								Type:        "string",
								Default:     "randomID",
								Description: "Unique identifier for the slider. Required when using the Value component.",
							},
							{
								Name:        "Class",
								Type:        "string",
								Default:     "\"\"",
								Description: "Additional CSS classes.",
							},
							{
								Name:        "Attributes",
								Type:        "templ.Attributes",
								Default:     "nil",
								Description: "Additional HTML attributes.",
							},
							{
								Name:        "Name",
								Type:        "string",
								Default:     "\"\"",
								Description: "Name attribute for the hidden form input.",
							},
							{
								Name:        "Min",
								Type:        "int",
								Default:     "0",
								Description: "Minimum value.",
							},
							{
								Name:        "Max",
								Type:        "int",
								Default:     "100",
								Description: "Maximum value.",
							},
							{
								Name:        "Step",
								Type:        "int",
								Default:     "1",
								Description: "Step increment.",
							},
							{
								Name:        "Value",
								Type:        "int",
								Default:     "0",
								Description: "Initial value.",
							},
							{
								Name:        "Disabled",
								Type:        "bool",
								Default:     "false",
								Description: "Whether the slider is disabled.",
							},
						},
					})
				</div>
				<div id="api-range" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Range",
						Description: "Dual-thumb range slider. Value displays use the slider ID with a -min or -max suffix.",
						Items: []modules.APITableItem{
							{
								Name:        "ID",
								Type:        "string",
								Default:     "randomID",
								Description: "Unique identifier. Value components use {ID}-min and {ID}-max as their For value.",
							},
							{
								Name:        "Class",
								Type:        "string",
								Default:     "\"\"",
								Description: "Additional CSS classes.",
							},
							{
								Name:        "Attributes",
								Type:        "templ.Attributes",
								Default:     "nil",
								Description: "Additional HTML attributes.",
							},
							{
								Name:        "NameMin",
								Type:        "string",
								Default:     "\"\"",
								Description: "Name attribute for the min hidden input.",
							},
							{
								Name:        "NameMax",
								Type:        "string",
								Default:     "\"\"",
								Description: "Name attribute for the max hidden input.",
							},
							{
								Name:        "Min",
								Type:        "int",
								Default:     "0",
								Description: "Minimum allowed value.",
							},
							{
								Name:        "Max",
								Type:        "int",
								Default:     "100",
								Description: "Maximum allowed value.",
							},
							{
								Name:        "Step",
								Type:        "int",
								Default:     "1",
								Description: "Step increment.",
							},
							{
								Name:        "MinValue",
								Type:        "int",
								Default:     "0",
								Description: "Initial value for the min thumb.",
							},
							{
								Name:        "MaxValue",
								Type:        "int",
								Default:     "Max",
								Description: "Initial value for the max thumb.",
							},
							{
								Name:        "Disabled",
								Type:        "bool",
								Default:     "false",
								Description: "Whether the slider is disabled.",
							},
						},
					})
				</div>
				<div id="api-value">
					@modules.APITable(modules.APITableProps{
						Title:       "Value",
						Description: "Displays the current slider value. For range sliders use {sliderID}-min or {sliderID}-max as the For value.",
						Items: []modules.APITableItem{
							{
								Name:        "ID",
								Type:        "string",
								Default:     "\"\"",
								Description: "Unique identifier.",
							},
							{
								Name:        "Class",
								Type:        "string",
								Default:     "\"\"",
								Description: "Additional CSS classes.",
							},
							{
								Name:        "Attributes",
								Type:        "templ.Attributes",
								Default:     "nil",
								Description: "Additional HTML attributes.",
							},
							{
								Name:        "For",
								Type:        "string",
								Default:     "\"\"",
								Description: "ID of the slider to link to. For range sliders append -min or -max.",
							},
						},
					})
				</div>
			}
		}
	}
}
