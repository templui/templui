package pages

import (
	"github.com/templui/templui/components/badge"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/internal/ui/layouts"
	"github.com/templui/templui/internal/ui/modules"
)

// Landing is the 1:1 pendant of shadcn's homepage,
// app/(app)/(root)/page.tsx: the PageHeader hero
// (components/page-header.tsx) with the Announcement badge
// (components/announcement.tsx) on top, and the card wall from
// app/(app)/(root)/cards (CardsDemo) below it. Structure, classes and copy
// are verbatim; the identity swaps are our changelog headline in the
// announcement and our own /create link on the CTA.

const landingTitle = "The Foundation for your Design System"

const landingDescription = "A set of beautifully designed components that you can customize, extend, and build on. Start here then make it your own. Open Source. Open Code."

templ Landing() {
	@layouts.BaseLayout(landingTitle, landingDescription) {
		@modules.AnnouncementBar()
		@modules.Navbar()
		// app/(app)/layout.tsx's <main> plus page.tsx's root div.
		<main class="flex min-h-0 flex-1 flex-col">
			<div class="flex flex-1 flex-col">
				// PageHeader, with the page's own
				// md:**:[.container]:pb-8 lg:**:[.container]:pb-12.
				<section class="border-grid md:**:[.container]:pb-8 lg:**:[.container]:pb-12">
					<div class="container-wrapper">
						<div class="container flex flex-col items-center gap-2 px-6 py-8 text-center md:py-16 lg:py-20 xl:gap-4">
							// Announcement: their badge links to the newest
							// changelog entry, so ours names ours.
							@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "bg-muted", Href: "/docs/changelog"}) {
								Hover Card is now available
								@icon.ArrowRight()
							}
							// PageHeaderHeading with the page's max-w-4xl.
							<h1 class="leading-tighter max-w-4xl text-3xl font-semibold tracking-tight text-balance text-primary lg:leading-[1.1] lg:font-semibold xl:text-5xl xl:tracking-tighter">
								{ landingTitle }
							</h1>
							// PageHeaderDescription.
							<p class="max-w-4xl text-base text-balance text-foreground sm:text-lg">
								{ landingDescription }
							</p>
							// PageActions.
							<div class="flex w-full items-center justify-center gap-2 pt-2 **:data-[slot=button]:shadow-none">
								@button.Button(button.Props{Href: "/create?preset=b27GcrRo", Class: "h-[31px] rounded-lg"}) {
									Build Your Own
									@icon.ArrowRight(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-end"}})
								}
							</div>
						</div>
					</div>
				</section>
				<div class="container-wrapper flex-1 p-0">
					<div class="container overflow-hidden md:px-0 lg:max-w-none">
						// Below md the reference swaps the card wall for a
						// screenshot pair (/images/full-light.png,
						// /images/full-dark.png). We have no such pair yet, so
						// the existing readme screenshot stands in for both.
						<section class="-mx-4 w-[140vw] overflow-hidden md:hidden">
							<img
								src="/assets/img/readme.png"
								width="2718"
								height="1466"
								alt="Dashboard"
								class="block h-auto w-full"
							/>
						</section>
						<section class="hidden md:block">
							@landingCardsDemo()
						</section>
					</div>
				</div>
			</div>
		</main>
		@modules.Footer()
	}
}

// landingCardsDemo is CardsDemo from app/(app)/(root)/cards/index.tsx.
templ landingCardsDemo() {
	<div
		data-slot="demo"
		class="theme-neutral relative flex w-full max-w-none flex-col gap-(--gap) overflow-hidden bg-muted p-12 pb-0! [--gap:--spacing(8)] 3xl:[--gap:--spacing(8)] min-[1900px]:p-12 min-[1900px]:[--gap:--spacing(10)]! lg:p-6 lg:[--gap:--spacing(6)] dark:bg-background"
	>
		@landingCardsSkeletonRails()
		<div class="relative z-10 mx-auto grid gap-(--gap) **:data-[slot=card]:w-full min-[1400px]:grid-cols-4! min-[1900px]:grid-cols-5! md:max-w-3xl md:grid-cols-2 lg:max-w-none lg:grid-cols-3 xl:max-w-[1600px] 2xl:max-w-[1900px]">
			<div class="flex flex-col items-start gap-(--gap)">
				@landingCardUIElements()
				@landingCardSidebarNav()
				@landingCardSavingsTargets()
			</div>
			<div class="hidden flex-col gap-(--gap) lg:flex">
				@landingCardContributionHistory()
				@landingCardClaimableBalance()
				@landingCardDividendIncome()
			</div>
			<div class="hidden flex-col gap-(--gap) min-[1400px]:flex">
				// Literally the block card, so the existing port is reused.
				@cardNewMilestone()
				@landingCardPayoutThreshold()
				@landingCardAccountAccess()
			</div>
			<div class="hidden flex-col gap-(--gap) md:flex">
				@landingCardQrConnect()
				// The reference renders MessageScrollerDemo here and keeps
				// <TransferFunds /> commented out right above it. templUI has
				// no message-scroller component, so this slot keeps the card
				// the reference falls back to and that its own skeleton wall
				// still shows here: TransferFunds.
				@cardTransferFunds()
				@landingCardPayments()
			</div>
			<div class="hidden flex-col gap-(--gap) min-[1900px]:flex">
				// Literally the block card, so the existing port is reused.
				@cardEmptyDistributeTrack()
				@landingCardAnalytics()
				@landingCardNotificationSettings()
				@landingCardPowerUsage()
			</div>
		</div>
		<div class="absolute inset-x-0 top-0 z-1 h-120 bg-linear-to-b from-background via-muted to-transparent dark:hidden"></div>
		<div class="absolute inset-x-0 bottom-0 z-20 h-48 bg-linear-to-t from-background via-muted/80 to-transparent lg:h-80 xl:h-64 dark:via-background/80"></div>
	</div>
}

// landingCardsSkeletonRails is CardsSkeletonRails: the decorative skeleton
// walls left and right of the grid, only visible from 2200px up.
templ landingCardsSkeletonRails() {
	<div
		aria-hidden="true"
		class="pointer-events-none absolute inset-x-0 top-12 z-10 hidden min-[2200px]:block [&_[data-slot=skeleton]:nth-child(even)]:hidden"
	>
		<div class="absolute top-0 left-[calc(50%-950px-var(--rail-width)-var(--gap))] grid w-(--rail-width) grid-cols-[repeat(2,var(--rail-column))] gap-(--gap) opacity-50 [--rail-column:20rem] [--rail-width:calc(var(--rail-column)*2+var(--gap))]">
			<div class="flex flex-col gap-(--gap)">
				@landingSkeletonContributionHistory()
				@landingSkeletonClaimableBalance()
				@landingSkeletonDividendIncome()
				@landingSkeletonPayoutThreshold()
			</div>
			<div class="flex flex-col gap-(--gap)">
				@landingSkeletonUIElements()
				@landingSkeletonSavingsTargets()
				@landingSkeletonNewMilestone()
				@landingSkeletonPayoutThreshold()
				@landingSkeletonAccountAccess()
			</div>
		</div>
		<div class="absolute top-0 right-[calc(50%-950px-var(--rail-width)-var(--gap))] grid w-(--rail-width) grid-cols-[repeat(2,var(--rail-column))] gap-(--gap) opacity-50 [--rail-column:20rem] [--rail-width:calc(var(--rail-column)*2+var(--gap))]">
			<div class="flex flex-col gap-(--gap)">
				@landingSkeletonNewMilestone()
				@landingSkeletonPayoutThreshold()
				@landingSkeletonAccountAccess()
				@landingSkeletonQrConnect()
				@landingSkeletonTransferFunds()
				@landingSkeletonPayments()
				@landingSkeletonEmptyDistributeTrack()
			</div>
			<div class="flex flex-col gap-(--gap)">
				@landingSkeletonQrConnect()
				@landingSkeletonTransferFunds()
				@landingSkeletonPayments()
				@landingSkeletonEmptyDistributeTrack()
				@landingSkeletonAnalyticsCard()
				@landingSkeletonNotificationSettings()
				@landingSkeletonPowerUsage()
			</div>
		</div>
	</div>
}
