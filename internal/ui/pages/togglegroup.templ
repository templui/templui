package pages

import (
	"github.com/templui/templui/internal/ui/layouts"
	"github.com/templui/templui/internal/ui/modules"
	"github.com/templui/templui/internal/ui/showcase"
)

templ ToggleGroup() {
	@layouts.DocsLayout(
		"Toggle Group",
		"A set of toggles grouped into a segmented control, with single or multiple selection.",
		[]modules.TableOfContentsItem{
			{ID: "installation", Text: "Installation"},
			{
				Text: "Examples",
				ID:   "examples",
				Children: []modules.TableOfContentsItem{
					{Text: "Outline", ID: "outline"},
					{Text: "Size", ID: "size"},
					{Text: "Spacing", ID: "spacing"},
					{Text: "Vertical", ID: "vertical"},
					{Text: "Disabled", ID: "disabled"},
					{Text: "Custom", ID: "custom"},
				},
			},
			{
				ID:   "api",
				Text: "API Reference",
				Children: []modules.TableOfContentsItem{
					{ID: "api-group", Text: "Group"},
				},
			},
		},
	) {
		@modules.PageWrapper(modules.PageWrapperProps{
			Name:        "Toggle Group",
			Description: templ.Raw("A set of toggles grouped into a segmented control. Uses Toggle for the items."),
			Tailwind:    true,
			VanillaJS:   true,
			Breadcrumbs: modules.Breadcrumbs{
				Items: []modules.BreadcrumbItem{
					{Text: "Docs", Path: "/docs"},
					{Text: "Components", Path: "/docs/components"},
					{Text: "Toggle Group"},
				},
			},
		}) {
			@modules.ExampleWrapper(modules.ExampleWrapperProps{
				ShowcaseFile:    showcase.ToggleGroup(),
				PreviewCodeFile: "toggle_group.templ",
			})
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "Installation", ID: "installation"}) {
				@modules.ComponentUsage(modules.ComponentUsageProps{ComponentName: "togglegroup"})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "Examples", ID: "examples"}) {
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Outline",
					ShowcaseFile:    showcase.ToggleGroupOutline(),
					PreviewCodeFile: "togglegroup_outline.templ",
					ID:              "outline",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Size",
					ShowcaseFile:    showcase.ToggleGroupSize(),
					PreviewCodeFile: "togglegroup_size.templ",
					ID:              "size",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Spacing",
					ShowcaseFile:    showcase.ToggleGroupSpacing(),
					PreviewCodeFile: "togglegroup_spacing.templ",
					ID:              "spacing",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Vertical",
					ShowcaseFile:    showcase.ToggleGroupVertical(),
					PreviewCodeFile: "togglegroup_vertical.templ",
					ID:              "vertical",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Disabled",
					ShowcaseFile:    showcase.ToggleGroupDisabled(),
					PreviewCodeFile: "togglegroup_disabled.templ",
					ID:              "disabled",
				})
				@modules.ExampleWrapper(modules.ExampleWrapperProps{
					SectionName:     "Custom",
					ShowcaseFile:    showcase.ToggleGroupCustom(),
					PreviewCodeFile: "togglegroup_custom.templ",
					ID:              "custom",
				})
			}
			@modules.ContainerWrapper(modules.ContainerWrapperProps{Title: "API Reference", ID: "api"}) {
				@modules.APILegend()
				<div id="api-group" class="mb-8">
					@modules.APITable(modules.APITableProps{
						Title:       "Group",
						Description: "Groups Toggle items into a segmented control and manages their state. Child toggles inherit Variant and Size.",
						Items: []modules.APITableItem{
							{Name: "ID", Type: "string", Default: "", Description: "Optional HTML id for the group.", Required: false},
							{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to apply to the group.", Required: false},
							{Name: "Type", Type: "Type", Default: "single", Description: "Selection mode. 'single' keeps at most one toggle on; 'multiple' toggles independently.", Required: false},
							{Name: "Variant", Type: "Variant", Default: "default", Description: "Variant applied to child toggles that don't set their own. Options: 'default', 'outline'.", Required: false},
							{Name: "Size", Type: "Size", Default: "default", Description: "Size applied to child toggles that don't set their own. Options: 'sm', 'default', 'lg'.", Required: false},
							{Name: "Orientation", Type: "Orientation", Default: "horizontal", Description: "Layout direction. Options: 'horizontal', 'vertical'.", Required: false},
							{Name: "Spacing", Type: "int", Default: "2", Description: "Gap between items in Tailwind units (e.g. 1, 2, 4, 6). 0 uses the default of 2.", Required: false},
							{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply to the group.", Required: false},
						},
					})
				</div>
			}
		}
	}
}
