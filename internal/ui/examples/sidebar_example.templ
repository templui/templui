package examples

import (
	"github.com/axadrn/shadcn-templ/v2/components/dropdownmenu"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/item"
	"github.com/axadrn/shadcn-templ/v2/components/label"
	"github.com/axadrn/shadcn-templ/v2/components/sidebar"
)

// The full-page example from sidebar-example.tsx: the docs sidebar with a
// version switcher and a search field.

type sidebarExampleNavGroup struct {
	Title string
	URL   string
	Items []sidebarExampleNavItem
}

type sidebarExampleNavItem struct {
	Title    string
	URL      string
	IsActive bool
}

var sidebarExampleVersions = []string{"1.0.1", "1.1.0-alpha", "2.0.0-beta1"}

var sidebarExampleNavMain = []sidebarExampleNavGroup{
	{
		Title: "Getting Started", URL: "#",
		Items: []sidebarExampleNavItem{
			{Title: "Installation", URL: "#"},
			{Title: "Project Structure", URL: "#"},
		},
	},
	{
		Title: "Build Your Application", URL: "#",
		Items: []sidebarExampleNavItem{
			{Title: "Routing", URL: "#"},
			{Title: "Data Fetching", URL: "#", IsActive: true},
			{Title: "Rendering", URL: "#"},
			{Title: "Caching", URL: "#"},
			{Title: "Styling", URL: "#"},
			{Title: "Optimizing", URL: "#"},
			{Title: "Configuring", URL: "#"},
			{Title: "Testing", URL: "#"},
			{Title: "Authentication", URL: "#"},
			{Title: "Deploying", URL: "#"},
			{Title: "Upgrading", URL: "#"},
			{Title: "Examples", URL: "#"},
		},
	},
	{
		Title: "API Reference", URL: "#",
		Items: []sidebarExampleNavItem{
			{Title: "Components", URL: "#"},
			{Title: "File Conventions", URL: "#"},
			{Title: "Functions", URL: "#"},
			{Title: "next.config.js Options", URL: "#"},
			{Title: "CLI", URL: "#"},
			{Title: "Edge Runtime", URL: "#"},
		},
	},
	{
		Title: "Architecture", URL: "#",
		Items: []sidebarExampleNavItem{
			{Title: "Accessibility", URL: "#"},
			{Title: "Fast Refresh", URL: "#"},
			{Title: "Next.js Compiler", URL: "#"},
			{Title: "Supported Browsers", URL: "#"},
			{Title: "Turbopack", URL: "#"},
		},
	},
}

templ sidebarExampleVersionSwitcher() {
	@sidebar.Menu() {
		@sidebar.MenuItem() {
			@dropdownmenu.DropdownMenu(dropdownmenu.Props{ID: "sidebar-example-version-menu"}) {
				@sidebar.MenuButton(sidebar.MenuButtonProps{
					Size:       sidebar.MenuButtonSizeLg,
					Class:      "data-[state=open]:bg-sidebar-accent data-[state=open]:text-sidebar-accent-foreground",
					Attributes: dropdownmenu.Trigger(ctx),
				}) {
					@item.Item(item.Props{Size: item.SizeXs, Class: "p-0"}) {
						@item.Content() {
							@item.Title(item.TitleProps{Class: "text-sm"}) {
								Documentation
							}
							@item.Description() {
								v<span data-version-label>{ sidebarExampleVersions[0] }</span>
							}
						}
						@item.Actions() {
							@icon.ChevronsUpDown()
						}
					}
				}
				@dropdownmenu.Content() {
					for i, version := range sidebarExampleVersions {
						@dropdownmenu.Item(dropdownmenu.ItemProps{
							Attributes: templ.Attributes{"data-version": version},
						}) {
							v{ version }
							@icon.Check(icon.Props{
								Class:      "ml-auto" + sidebarExampleCheckHidden(i),
								Attributes: templ.Attributes{"data-version-check": version},
							})
						}
					}
				}
			}
		}
	}
}

func sidebarExampleCheckHidden(i int) string {
	if i == 0 {
		return ""
	}
	return " hidden"
}

templ SidebarExample() {
	@sidebar.Provider() {
		@sidebar.Sidebar() {
			@sidebar.Header() {
				@sidebarExampleVersionSwitcher()
				<form>
					@sidebar.Group(sidebar.GroupProps{Class: "py-0"}) {
						@sidebar.GroupContent(sidebar.GroupContentProps{Class: "relative"}) {
							@label.Label(label.Props{For: "search", Class: "sr-only"}) {
								Search
							}
							@sidebar.Input(sidebar.InputProps{
								ID:          "search",
								Placeholder: "Search the docs...",
								Class:       "pl-8",
							})
							@icon.Search(icon.Props{Class: "pointer-events-none absolute top-1/2 left-2 size-4 -translate-y-1/2 opacity-50 select-none"})
						}
					}
				</form>
			}
			@sidebar.Content() {
				for _, group := range sidebarExampleNavMain {
					@sidebar.Group() {
						@sidebar.GroupLabel() {
							{ group.Title }
						}
						@sidebar.GroupContent() {
							@sidebar.Menu() {
								for _, subItem := range group.Items {
									@sidebar.MenuItem() {
										@sidebar.MenuButton(sidebar.MenuButtonProps{
											Href:     subItem.URL,
											IsActive: subItem.IsActive,
										}) {
											{ subItem.Title }
										}
									}
								}
							}
						}
					}
				}
			}
			@sidebar.Rail()
		}
		@sidebar.Inset() {
			<header class="flex h-16 shrink-0 items-center gap-2 px-4">
				@sidebar.Trigger(sidebar.TriggerProps{Class: "-ml-1"})
			</header>
			<div class="flex flex-1 flex-col gap-4 p-4">
				<div class="grid auto-rows-min gap-4 md:grid-cols-3">
					<div class="aspect-video rounded-xl bg-muted/50"></div>
					<div class="aspect-video rounded-xl bg-muted/50"></div>
					<div class="aspect-video rounded-xl bg-muted/50"></div>
				</div>
				<div class="min-h-[100vh] flex-1 rounded-xl bg-muted/50 md:min-h-min"></div>
			</div>
		}
	}
	<script nonce={ templ.GetNonce(ctx) }>
		(() => {
			// Version switching, the pendant of the demo's selectedVersion state.
			document.addEventListener("click", (e) => {
				if (!(e.target instanceof Element)) return;
				const item = e.target.closest("#sidebar-example-version-menu [data-version]");
				if (!item) return;
				const version = item.getAttribute("data-version");
				const labelEl = document.querySelector("[data-version-label]");
				if (labelEl) labelEl.textContent = version;
				document.querySelectorAll("[data-version-check]").forEach((check) => {
					check.classList.toggle("hidden", check.getAttribute("data-version-check") !== version);
				});
			});
		})();
	</script>
}
