package examples

import "github.com/templui/templui/components/button"

templ ToastHtmx() {
	<form
		hx-post="/docs/toast/demo"
		hx-target="#toaster"
		hx-swap="beforeend"
		hx-vals='{
			"title": "Changes saved",
			"description": "Your changes have been saved on the server.",
			"type": "success"
		}'
	>
		@button.Button(button.Props{
			Type:    button.TypeSubmit,
			Variant: button.VariantOutline,
		}) {
			Save on the server
		}
	</form>
}
