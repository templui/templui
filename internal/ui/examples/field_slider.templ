package examples

import (
	"github.com/templui/templui/components/field"
	"github.com/templui/templui/components/slider"
)

templ FieldSlider() {
	@field.Field(field.Props{Class: "w-full max-w-xs"}) {
		@field.Title() {
			Price Range
		}
		@field.Description() {
			Set your budget range ($
			<span class="font-medium tabular-nums">
				@slider.Value(slider.ValueProps{For: "price-range-min"})
			</span>
			-
			<span class="font-medium tabular-nums">
				@slider.Value(slider.ValueProps{For: "price-range-max"})
			</span>
			).
		}
		@slider.Range(slider.RangeProps{
			ID:       "price-range",
			Min:      0,
			Max:      1000,
			Step:     10,
			MinValue: 200,
			MaxValue: 800,
			Class:    "mt-2 w-full",
		})
	}
}
