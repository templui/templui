package examples

import (
	"github.com/templui/templui/components/checkbox"
	"github.com/templui/templui/components/field"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/label"
	"github.com/templui/templui/components/textarea"
)

// The kitchen-sink page from label-example.tsx.
templ labelExampleSection(title string) {
	<div data-slot="example" class="mx-auto flex w-full max-w-lg min-w-0 flex-col gap-1 self-stretch lg:max-w-none">
		if title != "" {
			<div class="px-1.5 py-2 text-xs font-medium text-muted-foreground">{ title }</div>
		}
		<div data-slot="example-content" class="flex min-w-0 flex-1 flex-col items-start gap-6 rounded-xl bg-card p-12 text-foreground style-lyra:rounded-none style-sera:rounded-none *:[div:not([class*='w-'])]:w-full">
			{ children... }
		</div>
	</div>
}

templ LabelExample() {
	<div class="w-full bg-muted dark:bg-background">
		<div data-slot="example-wrapper" class="mx-auto grid min-h-screen w-full max-w-5xl min-w-0 content-center items-start gap-8 p-4 pt-2 sm:gap-12 sm:p-6 md:grid-cols-2 md:gap-8 lg:p-12 2xl:max-w-6xl">
			@labelExampleWithCheckbox()
			@labelExampleWithInput()
			@labelExampleDisabled()
			@labelExampleWithTextarea()
		</div>
	</div>
}

templ labelExampleWithCheckbox() {
	@labelExampleSection("With Checkbox") {
		@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
			@checkbox.Checkbox(checkbox.Props{ID: "label-demo-terms"})
			@label.Label(label.Props{For: "label-demo-terms"}) {
				Accept terms and conditions
			}
		}
	}
}

templ labelExampleWithInput() {
	@labelExampleSection("With Input") {
		@field.Field() {
			@label.Label(label.Props{For: "label-demo-username"}) {
				Username
			}
			@input.Input(input.Props{ID: "label-demo-username", Placeholder: "Username"})
		}
	}
}

templ labelExampleDisabled() {
	@labelExampleSection("Disabled") {
		@field.Field(field.Props{Disabled: true}) {
			@label.Label(label.Props{For: "label-demo-disabled"}) {
				Disabled
			}
			@input.Input(input.Props{ID: "label-demo-disabled", Placeholder: "Disabled", Disabled: true})
		}
	}
}

templ labelExampleWithTextarea() {
	@labelExampleSection("With Textarea") {
		@field.Field() {
			@label.Label(label.Props{For: "label-demo-message"}) {
				Message
			}
			@textarea.Textarea(textarea.Props{ID: "label-demo-message", Placeholder: "Message"})
		}
	}
}
