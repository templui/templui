package examples

import (
	"github.com/templui/templui/components/contextmenu"
	"github.com/templui/templui/components/icon"
)

templ ContextMenuDestructive() {
	@contextmenu.Root() {
		@contextmenu.Trigger(contextmenu.TriggerProps{Class: "flex aspect-video w-full max-w-xs items-center justify-center rounded-xl border border-dashed text-sm"}) {
			<span class="hidden pointer-fine:inline-block">Right click here</span>
			<span class="hidden pointer-coarse:inline-block">Long press here</span>
		}
		@contextmenu.Content() {
			@contextmenu.Group() {
				@contextmenu.Item() {
					@icon.Pencil()
					Edit
				}
				@contextmenu.Item() {
					@icon.Share()
					Share
				}
			}
			@contextmenu.Separator()
			@contextmenu.Group() {
				@contextmenu.Item(contextmenu.ItemProps{Variant: contextmenu.ItemVariantDestructive}) {
					@icon.Trash()
					Delete
				}
			}
		}
	}
}
