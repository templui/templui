package examples

import (
	"github.com/templui/templui/components/label"
	"github.com/templui/templui/components/slider"
)

templ SliderControlled() {
	<div class="mx-auto grid w-full max-w-xs gap-3" data-slider-controlled-demo>
		<div class="flex items-center justify-between gap-2">
			@label.Label(label.Props{For: "slider-demo-temperature"}) {
				Temperature
			}
			<span class="text-sm text-muted-foreground" data-value>0.3, 0.7</span>
		</div>
		@slider.Slider(slider.Props{
			ID:     "slider-demo-temperature",
			Value: []float64{0.3, 0.7},
			Min:    0,
			Max:    1,
			Step:   0.1,
		})
	</div>
	<script>
		// The vanilla pendant of the demo's React state.
		(() => {
			const demo = document.querySelector("[data-slider-controlled-demo]");
			demo.addEventListener("slider-change", (e) => {
				demo.querySelector("[data-value]").textContent = e.detail.values.join(", ");
			});
		})();
	</script>
}
