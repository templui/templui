package examples

import (
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/calendar"
	"github.com/templui/templui/components/field"
	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/popover"
)

templ DatePickerTime() {
	@field.Group(field.GroupProps{Class: "mx-auto max-w-xs flex-row"}) {
		@field.Field() {
			@field.Label(field.LabelProps{For: "date-picker-time-trigger"}) {
				Date
			}
			@popover.Root(popover.RootProps{ID: "date-picker-time"}) {
		{{
			triggerAttrs := popover.Trigger(ctx)
			triggerAttrs["id"] = "date-picker-time-trigger"
			triggerAttrs["data-tui-datepicker-display"] = ""
		}}
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Class:      "w-48 justify-between font-normal",
					Attributes: triggerAttrs,
				}) {
					<span>Select date</span>
					<span data-icon="inline-end" class="contents">
						@icon.ChevronDown()
					</span>
				}
				@popover.Content(popover.ContentProps{
					Class:     "w-auto overflow-hidden p-0",
					Side: popover.SideBottom, Align: popover.AlignStart,
				}) {
					@calendar.Calendar(calendar.Props{
						CaptionLayout: calendar.CaptionLayoutDropdown,
					})
				}
			}
		}
		@field.Field(field.Props{Class: "w-24"}) {
			@field.Label(field.LabelProps{For: "date-picker-time-input"}) {
				Time
			}
			@input.Input(input.Props{
				ID:    "date-picker-time-input",
				Type:  "time",
				Value: "10:30:00",
				Class: "appearance-none bg-background [&::-webkit-calendar-picker-indicator]:hidden [&::-webkit-calendar-picker-indicator]:appearance-none",
				Attributes: templ.Attributes{
					"step": "1",
				},
			})
		}
	}
	<script>
		(() => {
			const root = document.getElementById("date-picker-time");
			const fmt = (d) => {
				const day = d.getDate();
				const suf = day % 10 === 1 && day !== 11 ? "st" : day % 10 === 2 && day !== 12 ? "nd" : day % 10 === 3 && day !== 13 ? "rd" : "th";
				return d.toLocaleDateString("en-US", { month: "long" }) + " " + day + suf + ", " + d.getFullYear();
			};
			root.addEventListener("calendar-change", (e) => {
				const display = root.querySelector("[data-tui-datepicker-display] span");
				display.textContent = e.detail.value ? fmt(e.detail.value) : "Select date";
				if (e.detail.value && window.tui && window.tui.popover) {
					window.tui.popover.closeNearest(root.querySelector("[data-tui-popover-content]"));
				}
			});
		})();
	</script>
}
