package layouts

import (
	"fmt"
	"github.com/templui/templui/internal/config"
	"github.com/templui/templui/internal/ctxkeys"
	"github.com/templui/templui/components/toast"
	"github.com/templui/templui/internal/ui/modules"
	"github.com/templui/templui/utils"
)

templ BaseLayout(title, description string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			// 2.0 beta (v2.templui.io): keep search engines out. REMOVE at the 2.0 release
			// (tracked in COMMIT_PLAN.md, "Pre-Release / Beta").
			<meta name="robots" content="noindex"/>
			// Google
			<meta name="google-site-verification" content="lcKF60IRUofKfZpOIYKOD7xyvrL220KpjmGjJcflde4"/>
			// SEO
			@modules.SEO(title, description, ctx.Value(ctxkeys.URLPathValue).(string))
			// Preload fonts to prevent flickering
			<link rel="preload" href="/assets/fonts/geist/geist-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
			<link rel="preload" href="/assets/fonts/geist/geist-mono-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
			// Component JS files
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/accordion/accordion.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/avatar/avatar.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/calendar/calendar.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/carousel/carousel.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/chart/chart.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/collapsible/collapsible.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/combobox/combobox.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/contextmenu/contextmenu.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/copybutton/copybutton.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/dropdownmenu/dropdownmenu.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/hovercard/hovercard.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/inputotp/inputotp.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/label/label.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/dialog/dialog.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/popover/popover.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/progress/progress.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/select/select.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/sidebar/sidebar.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/slider/slider.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/tabs/tabs.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/toast/toast.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/toggle/toggle.min.js") }></script>
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/components/js/tooltip/tooltip.min.js") }></script>
			// Plausible Analytics
			if config.AppConfig.GoEnv == "production" {
				<script defer data-domain="templui.io" src="https://plausible.axeladrian.com/js/script.js" nonce={ templ.GetNonce(ctx) }></script>
			}
			// Shiki Highlighter Script
			@modules.CodeHighlightingScript()
			// Tailwind CSS (themes.css is bundled in via globals.css)
			<link href="/assets/css/output.css" rel="stylesheet"/>
			// HTMX
			<script nonce={ templ.GetNonce(ctx) } src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0-alpha7/dist/htmx.min.js"></script>
			// Set script nonce for HTMX // without this, HTMX will not work with CSP
			<meta
				name="htmx-config"
				content={ fmt.Sprintf(`{
			    "inlineScriptNonce": "%s"
			}`, templ.GetNonce(ctx)) }
			/>
			// Theme initialization - must run before body renders to prevent flash
			<script nonce={ templ.GetNonce(ctx) }>
				(function() {
					// Get current theme preference (system, light, or dark)
					function getThemePreference() {
						return localStorage.getItem('themePreference') || 'system';
					}
					
					// Apply theme based on preference
					const preference = getThemePreference();
					let isDark = false;
					
					if (preference === 'system') {
						// Use system preference
						isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
					} else {
						// Use explicit preference
						isDark = preference === 'dark';
					}
					
					// Apply theme immediately to prevent flash
					if (isDark) {
						document.documentElement.classList.add('dark');
					}
				})();
			</script>
		</head>
		<body
			class="transition-colors duration-200"
		>
			<div class="min-h-screen flex flex-col">
				{ children... }
			</div>
			@toast.Toaster(toast.ToasterProps{ID: "toaster", Position: toast.PositionTopCenter})
		</body>
		// HTMX
		<script nonce={ templ.GetNonce(ctx) }>
			document.body.addEventListener('htmx:after:swap', (e) => {
				// Active link updater
				document.querySelectorAll('aside a').forEach(a => {
					a.classList.toggle('bg-accent', a.href === location.href);
				});

				// Scroll to top after content swap. The page scrolls on the
				// body since the docs layout rework, not on #main-content.
				const target = e.detail.ctx.target;
				if (target && target.id === 'main-content') {
					window.scrollTo({ top: 0, behavior: 'instant' });
				}
			});
		</script>
	</html>
}
