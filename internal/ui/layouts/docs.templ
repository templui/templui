package layouts

import "github.com/templui/templui/internal/ui/modules"

templ DocsLayout(title, description string, tocItems []modules.TableOfContentsItem) {
	@BaseLayout(title, description) {
		@modules.TableOfContentsScript()
		@modules.IframeThemeSync()
		<div class="flex min-h-svh flex-col">
			@modules.AnnouncementBar()
			<div class="sticky top-0 z-40 bg-background">
				@modules.Navbar()
			</div>
			<div class="flex flex-1 items-start">
				<aside class="sticky top-14 relative hidden h-[calc(100svh-3.5rem)] w-72 lg:block">
					<div class="absolute top-12 right-2 bottom-0 hidden w-px bg-[linear-gradient(to_bottom,transparent_0%,var(--border)_10%,var(--border)_90%,transparent_100%)] lg:flex"></div>
					<div class="no-scrollbar h-full overflow-y-auto pt-8 pb-8 pl-6 pr-4">
						@modules.Sidebar()
					</div>
				</aside>
				<main class="min-w-0 flex-1" id="main-content">
					@templ.Fragment("content") {
						<div class="px-4 pt-8 pb-8">
							<div class="mx-auto w-full max-w-160 text-[1.05rem] sm:text-[15px]">
								{ children... }
							</div>
						</div>
					}
				</main>
				<aside class="sticky top-14 z-30 ml-auto hidden h-[90svh] w-72 flex-col gap-4 overflow-hidden overscroll-none pt-8 pb-8 xl:flex">
					@templ.Fragment("toc") {
						<div class="scrollbar-none flex min-h-0 flex-col gap-8 overflow-y-auto px-8" id="toc-container" hx-swap-oob="true">
							@modules.TableOfContents(modules.TableOfContentsProps{
								Items: tocItems,
							})
						</div>
					}
					<div class="hidden flex-1 flex-col gap-6 px-6 xl:flex">
						@modules.TocAdCard()
					</div>
				</aside>
			</div>
		</div>
	}
}
