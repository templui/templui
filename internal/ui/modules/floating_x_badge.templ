package modules

templ FloatingXBadge() {
	<a
		href="https://x.com/axadrn"
		target="_blank"
		rel="noreferrer"
		aria-label="Follow Axel Adrian on X"
		class="group fixed bottom-3 right-3 z-40 inline-flex rounded-full border border-black/10 bg-zinc-950/92 p-1 shadow-[0_12px_28px_-24px_rgba(0,0,0,0.72)] backdrop-blur-md transition-transform duration-200 hover:-translate-y-0.5 hover:bg-zinc-950 dark:border-white/15 dark:bg-zinc-50/94 dark:hover:bg-white sm:bottom-5 sm:right-5"
	>
		<img
			src="/assets/img/axel-adrian-avatar.png"
			alt="Axel Adrian"
			class="size-9 shrink-0 rounded-full object-cover saturate-[0.92]"
		/>
	</a>
}
