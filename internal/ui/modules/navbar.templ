package modules

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/dialog"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/separator"
	"github.com/axadrn/shadcn-templ/v2/internal/ctxkeys"
)

// Navbar is the pendant of shadcn's components/site-header.tsx (SiteHeader).
// Like the reference, the header carries no logo: the Home nav item is the
// way back. Structure and classes are 1:1; the shell pieces live in their own
// module files like shadcn's components (main_nav, mobile_nav, command_menu,
// github_link, themeswitcher = mode-switcher).
templ Navbar() {
	<header class="sticky top-(--announcement-height,0px) z-50 w-full bg-background">
		<div class="container-wrapper px-6 group-has-data-[slot=designer]/layout:max-w-none 3xl:fixed:px-0">
			// **:data-[slot=separator]:self-center is the one addition to the
			// reference's class string: its separators come from
			// registry/new-york-v4 (data-[orientation=vertical]:h-full, no
			// align-self), ours from base/ui (data-vertical:self-stretch). A
			// stretch with the h-4! pinned here degrades to flex-start, so the
			// separators would hang at the top of the row instead of centered.
			<div class="flex h-(--header-height) items-center **:data-[slot=separator]:h-4! **:data-[slot=separator]:self-center group-has-data-[slot=designer]/layout:fixed:max-w-none 3xl:fixed:container">
				@MobileNav("flex lg:hidden")
				@MainNav("hidden lg:flex")
				<div class="ml-auto flex items-center gap-2 md:flex-1 md:justify-end">
					<div class="hidden w-full flex-1 md:flex md:w-auto md:flex-none">
						@CommandMenu()
					</div>
					@separator.Separator(separator.Props{
						Orientation: separator.OrientationVertical,
						Class:       "ml-2 hidden lg:block",
					})
					@GitHubLink()
					@separator.Separator(separator.Props{
						Orientation: separator.OrientationVertical,
					})
					@ThemeSwitcher()
					// Pendant of components/designer-actions.tsx: hidden unless a
					// designer page (data-slot="designer") is in the layout. The
					// Get Code dialog lives on the /create page. Typeset carries
					// its own docs panel, so the header stays clean there (the
					// same route gate as designer-actions.tsx).
					if ctx.Value(ctxkeys.URLPathValue) != "/typeset" {
						<div class="hidden items-center gap-2 group-has-data-[slot=designer]/layout:md:flex">
							@separator.Separator(separator.Props{
								Orientation: separator.OrientationVertical,
							})
							@button.Button(button.Props{
								Attributes: dialog.TriggerFor("create-code-dialog"),
							}) {
								Get Code
							}
						</div>
					}
					<div class="flex items-center gap-2 group-has-data-[slot=designer]/layout:hidden">
						@separator.Separator(separator.Props{
							Orientation: separator.OrientationVertical,
						})
						@button.Button(button.Props{
							Size:  button.SizeSm,
							Class: "h-[31px] rounded-lg",
							Href:  "/create",
						}) {
							@icon.Plus()
							New
						}
					</div>
				</div>
			</div>
		</div>
	</header>
}
