package modules

// Footer is the site footer, placed like shadcn's SiteFooter (landing and
// content pages, not in the docs).
templ Footer() {
	<footer>
		<div class="container-wrapper px-4 xl:px-6">
			<div class="flex items-center justify-between py-6">
				<div class="w-full px-1 text-center text-xs leading-loose text-muted-foreground sm:text-sm">
					Built by{ " " }<a href="https://twitter.com/shadcn" target="_blank" rel="noreferrer" class="font-medium underline underline-offset-4">shadcn</a>.
					Ported to templ and vanilla JS by{ " " }<a href="https://twitter.com/axadrn" target="_blank" rel="noreferrer" class="font-medium underline underline-offset-4">Axel Adrian</a>.
					The source code is available on{ " " }<a href="https://github.com/axadrn/shadcn-templ" target="_blank" rel="noreferrer" class="font-medium underline underline-offset-4">GitHub</a>.
				</div>
			</div>
		</div>
	</footer>
}
