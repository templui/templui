package modules

import "github.com/templui/templui/components/tabs"

type ComponentUsageProps struct {
	ComponentName string
}

func hasComponentScript(componentName string) bool {
	switch componentName {
	case "avatar",
		"calendar",
		"carousel",
		"chart",
		"checkbox",
		"collapsible",
		"copybutton",
		"datepicker",
		"dialog",
		"dropdown",
		"input",
		"inputotp",
		"label",
		"popover",
		"progress",
		"rating",
		"selectbox",
		"sheet",
		"sidebar",
		"slider",
		"tabs",
		"tagsinput",
		"textarea",
		"timepicker",
		"toast",
		"tooltip":
		return true
	default:
		return false
	}
}

templ ComponentUsage(props ComponentUsageProps) {
	{{
		componentAlias := props.ComponentName
		if props.ComponentName == "switch" {
			componentAlias = "switchcomp"
		}

		componentImportLine := `"` + "github.com/templui/templui/components/" + props.ComponentName + `"`
		if componentAlias != props.ComponentName {
			componentImportLine = componentAlias + " " + componentImportLine
		}

		importCode := "import " + componentImportLine
		scriptCode := "<head>\n  @" + componentAlias + ".Script()\n</head>"
		showScriptCode := hasComponentScript(props.ComponentName)
	}}
	@tabs.Tabs(tabs.Props{
		ID: "installation-" + props.ComponentName,
	}) {
		@tabs.List(tabs.ListProps{
			Class: "w-fit",
		}) {
			@tabs.Trigger(tabs.TriggerProps{
				Value:    "cli",
				IsActive: true,
			}) {
				CLI
			}
			@tabs.Trigger(tabs.TriggerProps{
				Value: "import",
			}) {
				Import
			}
		}
		<div class="mt-4">
			@tabs.Content(tabs.ContentProps{
				Value:    "cli",
				IsActive: true,
			}) {
				@Code(CodeProps{
					CodeContent:    "templui add " + props.ComponentName,
					ShowCopyButton: true,
				})
				if showScriptCode {
					<p class="mt-4 mb-2 text-sm text-muted-foreground">Load the script once in your layout:</p>
					@Code(CodeProps{
						CodeContent:    scriptCode,
						ShowCopyButton: true,
					})
				}
			}
			@tabs.Content(tabs.ContentProps{
				Value: "import",
			}) {
				@Code(CodeProps{
					CodeContent:    importCode,
					ShowCopyButton: true,
				})
				if showScriptCode {
					<p class="mt-4 mb-2 text-sm text-muted-foreground">Load the script once in your layout:</p>
					@Code(CodeProps{
						CodeContent:    scriptCode,
						ShowCopyButton: true,
					})
				}
			}
		</div>
	}
}
