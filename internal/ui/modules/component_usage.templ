package modules

import "github.com/templui/templui/components/tabs"

type ComponentUsageProps struct {
	ComponentName string
	JSFiles       []string
}

templ ComponentUsage(props ComponentUsageProps) {
	{{
		componentAlias := props.ComponentName
		if props.ComponentName == "switch" {
			componentAlias = "switchcomp"
		}

		componentImportLine := `"` + "github.com/templui/templui/components/" + props.ComponentName + `"`
		if componentAlias != props.ComponentName {
			componentImportLine = componentAlias + " " + componentImportLine
		}

		importLines := []string{componentImportLine}

		importCode := "import (\n"
		for _, line := range importLines {
			importCode += "\t" + line + "\n"
		}
		importCode += ")"
	}}
	@tabs.Tabs(tabs.Props{
		ID: "installation-" + props.ComponentName,
	}) {
		@tabs.List(tabs.ListProps{
			Class: "w-fit",
		}) {
			@tabs.Trigger(tabs.TriggerProps{
				Value:    "cli",
				IsActive: true,
			}) {
				CLI
			}
			@tabs.Trigger(tabs.TriggerProps{
				Value: "import",
			}) {
				Import
			}
		}
		<div class="mt-4">
			@tabs.Content(tabs.ContentProps{
				Value:    "cli",
				IsActive: true,
			}) {
				@Code(CodeProps{
					CodeContent:    "templui add " + props.ComponentName,
					ShowCopyButton: true,
				})
			}
			@tabs.Content(tabs.ContentProps{
				Value: "import",
			}) {
				<p class="mb-4 font-semibold">Import the package</p>
				@Code(CodeProps{
					CodeContent:    importCode,
					ShowCopyButton: true,
				})
			}
		</div>
	}
}
