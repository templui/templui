package modules

import (
	"strconv"

	"github.com/templui/templui/components/button"
	"github.com/templui/templui/internal/ctxkeys"
	"github.com/templui/templui/internal/shared"
	"github.com/templui/templui/utils"
)

// MainNav is the pendant of shadcn's components/main-nav.tsx: ghost sm
// buttons over the nav items, data-active on the current path and data-new
// from PagesNew like their PAGES_NEW. The reference imports its Button from
// registry/new-york-v4 (the site's own legacy family); ours is the styled
// button of the active style, so only the reference's own classes are kept.
templ MainNav(class string) {
	{{ path, _ := ctx.Value(ctxkeys.URLPathValue).(string) }}
	<nav class={ utils.TwMerge("items-center gap-0", class) }>
		for _, item := range shared.NavItems {
			@button.Button(button.Props{
				Variant: button.VariantGhost,
				Size:    button.SizeSm,
				Href:    item.Href,
				// "px-2.5" is the Button's class, "relative items-center" the
				// Link's; our Href button is the one <a>, so they merge.
				Class: "px-2.5 relative items-center",
				Attributes: templ.Attributes{
					"data-active": strconv.FormatBool(path == item.Href),
					"data-new":    strconv.FormatBool(shared.PageIsNew(item.Href)),
				},
			}) {
				{ item.Text }
			}
		}
	</nav>
}
