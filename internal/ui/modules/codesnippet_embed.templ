package modules

import (
	"embed"
	"strings"
)

templ CodeSnippetFromEmbedded(filename, language string, embed embed.FS) {
	if content, err := embed.ReadFile(filename); err != nil {
		<div class="error">Error reading file: { filename }: { err.Error() }</div>
	} else {
		@Code(CodeProps{
			Language:       "templ",
			ShowCopyButton: true,
			CodeContent:    strings.TrimRight(string(content), "\n"),
		})
	}
}

// CodeSnippetFromEmbeddedStyled is CodeSnippetFromEmbedded with extra
// classes for the inner code container (the docs blocks restyle the pre).
templ CodeSnippetFromEmbeddedStyled(filename, language string, embed embed.FS, codeClass string) {
	if content, err := embed.ReadFile(filename); err != nil {
		<div class="error">Error reading file: { filename }: { err.Error() }</div>
	} else {
		@Code(CodeProps{
			Language:       "templ",
			ShowCopyButton: true,
			CodeContent:    strings.TrimRight(string(content), "\n"),
			CodeClass:      codeClass,
		})
	}
}
