package modules

import "github.com/templui/templui/components/button"

type TableOfContentsItem struct {
	ID       string
	Text     string
	Children []TableOfContentsItem
}

type TableOfContentsProps struct {
	Items []TableOfContentsItem
}

templ TableOfContents(props TableOfContentsProps) {
	<aside
		class="text-sm"
		data-toc="container"
	>
		if len(props.Items) > 0 {
			<div class="flex flex-col gap-2 p-4 pt-0">
				<p class="h-6 bg-background text-xs font-medium text-muted-foreground">On This Page</p>
				<nav class="flex flex-col gap-0.5">
					@renderTOCItems(props.Items, 0)
				</nav>
			</div>
		}
	</aside>
}

templ renderTOCItems(items []TableOfContentsItem, level int) {
	for _, item := range items {
		<a
			href={ templ.SafeURL("#" + item.ID) }
			class={ templ.Classes(
				"block py-1 text-[0.8rem] text-muted-foreground hover:text-foreground",
				"no-underline transition-colors break-words",
				"data-[active=true]:font-medium data-[active=true]:text-foreground",
				templ.KV("pl-4", level == 1),
				templ.KV("pl-6", level >= 2),
			) }
			data-toc-link="true"
			data-section-id={ item.ID }
		>
			{ item.Text }
		</a>
		if len(item.Children) > 0 {
			@renderTOCItems(item.Children, level+1)
		}
	}
}

templ TableOfContentsScript() {
	<script defer nonce={ templ.GetNonce(ctx) }>
        document.addEventListener('DOMContentLoaded', () => {
            const toc = document.querySelector('[data-toc="container"]');
            if (!toc) return;

            // Scroll spy: highlight the section under the cursor line, like
            // shadcn (IntersectionObserver with a -80% bottom root margin).
            const links = [...toc.querySelectorAll('[data-toc-link]')];
            const setActive = (id) => {
                links.forEach((link) => {
                    link.setAttribute('data-active', link.dataset.sectionId === id ? 'true' : 'false');
                });
            };
            const observer = new IntersectionObserver((entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) setActive(entry.target.id);
                }
            }, { rootMargin: '0% 0% -80% 0%' });
            links.forEach((link) => {
                const section = document.getElementById(link.dataset.sectionId);
                if (section) observer.observe(section);
            });
        });
    </script>
}

// TocAdCard is the pendant of shadcn's OpenInV0Cta card below the toc,
// advertising Goilerplate. Classes are 1:1 from open-in-v0-cta.tsx.
templ TocAdCard() {
	<div class="group relative flex flex-col gap-2 rounded-2xl bg-surface p-6 text-sm text-surface-foreground">
		<div class="text-base leading-tight font-semibold text-balance group-hover:underline">
			Ship your templUI app with goilerplate
		</div>
		<div class="text-muted-foreground">The Go + templ SaaS boilerplate. Auth, payments, UI. Done.</div>
		<div class="text-muted-foreground">Now{ " " }<span class="font-semibold text-foreground">$99</span>{ " " }instead of{ " " }<span class="line-through">$199</span>.</div>
		@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Class: "mt-2 w-fit"}) {
			Get goilerplate
		}
		<a href="https://goilerplate.com" target="_blank" rel="noreferrer" class="absolute inset-0">
			<span class="sr-only">Get goilerplate</span>
		</a>
	</div>
}
