package modules

import (
	"context"
	"strconv"
	"strings"

	"github.com/axadrn/shadcn-templ/v2/components/sidebar"
	"github.com/axadrn/shadcn-templ/v2/internal/ctxkeys"
	"github.com/axadrn/shadcn-templ/v2/internal/shared"
)

// Sidebar is the pendant of shadcn's components/docs-sidebar.tsx: a
// collapsible="none" sidebar, the gradient hairline on its right edge, the
// "Sections" group over the top level pages and one group per docs section.
// Their scroll-restore effect is left out: our sidebar is never remounted,
// the htmx swap only replaces #main-content.
templ Sidebar() {
	{{ path := currentPath(ctx) }}
	@sidebar.Sidebar(sidebar.Props{
		Collapsible: sidebar.CollapsibleNone,
		Class:       "sticky top-[calc(var(--header-height)+var(--announcement-height,0px)+0.6rem)] z-30 hidden h-[calc(100svh-10rem)] overflow-hidden overscroll-none bg-transparent [--sidebar-menu-width:--spacing(56)] lg:flex",
	}) {
		<div class="absolute top-12 right-2 bottom-0 hidden h-full w-px bg-[linear-gradient(to_bottom,transparent_0%,var(--border)_10%,var(--border)_90%,transparent_100%)] lg:flex"></div>
		@sidebar.Content(sidebar.ContentProps{
			// gap-2 is SidebarContent's own gap in their registry sidebar; the
			// nova style compacts it to gap-0, so the docs sidebar restores it.
			Class: "gap-2 w-(--sidebar-menu-width) scroll-fade scrollbar-none overflow-x-hidden pl-2.5",
			Attributes: templ.Attributes{
				"data-docs-sidebar-content": "",
			},
		}) {
			@sidebar.Group(sidebar.GroupProps{Class: "pt-12"}) {
				@sidebar.GroupLabel(sidebar.GroupLabelProps{Class: "font-medium text-muted-foreground"}) {
					Sections
				}
				@sidebar.GroupContent() {
					// The Sections menu takes SidebarMenu's own gap-1 (nova
					// compacts it to gap-0); the section groups below pass
					// gap-0.5 like the reference.
					@sidebar.Menu(sidebar.MenuProps{Class: "gap-1"}) {
						for _, link := range shared.TopLevelSections {
							@sidebar.MenuItem() {
								@docsSidebarLink(link, sidebarSectionActive(link.Href, path))
							}
						}
					}
				}
			}
			for _, section := range shared.Sections {
				if !shared.ExcludedSidebarSections[section.Title] {
					@sidebar.Group() {
						@sidebar.GroupLabel(sidebar.GroupLabelProps{Class: "font-medium text-muted-foreground"}) {
							{ section.Title }
						}
						@sidebar.GroupContent() {
							@sidebar.Menu(sidebar.MenuProps{Class: "gap-0.5"}) {
								for _, link := range section.Links {
									if !shared.ExcludedSidebarPages[link.Href] {
										@sidebar.MenuItem() {
											@docsSidebarLink(link, link.Href == path)
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

func currentPath(ctx context.Context) string {
	path, _ := ctx.Value(ctxkeys.URLPathValue).(string)
	return path
}

// sidebarSectionActive is the isActive rule of the Sections group: the docs
// index matches exactly, every other section matches by prefix.
func sidebarSectionActive(href, path string) bool {
	if href == "/docs" {
		return path == href
	}
	return strings.HasPrefix(path, href)
}

// docsSidebarLink is their SidebarMenuButton asChild + Link, plus our htmx
// wiring: a click swaps #main-content instead of taking a client-side route.
// /llms.txt is a raw file, so it stays a plain navigation.
templ docsSidebarLink(link shared.SideLink, active bool) {
	@sidebar.MenuButton(sidebar.MenuButtonProps{
		Href:  link.Href,
		Class: "relative h-[30px] w-fit overflow-visible border border-transparent text-[0.8rem] font-medium after:absolute after:inset-x-0 after:-inset-y-1 after:z-0 after:rounded-md data-[active=true]:border-accent data-[active=true]:bg-accent 3xl:fixed:w-full 3xl:fixed:max-w-48",
		Attributes: docsNavAttributes(link.Href, templ.Attributes{
			"data-active": strconv.FormatBool(active),
		}),
	}) {
		<span class="absolute inset-0 flex w-(--sidebar-menu-width) bg-transparent"></span>
		{ link.Text }
		if shared.PageIsNew(link.Href) {
			<span class="flex size-2 rounded-full bg-blue-500" title="New"></span>
		}
	}
}

// docsNavAttributes adds the fragment swap wiring to a docs link. Links that
// leave the docs shell (llms.txt) navigate normally.
func docsNavAttributes(href string, attrs templ.Attributes) templ.Attributes {
	if !strings.HasPrefix(href, "/docs") {
		return attrs
	}
	attrs["hx-get"] = href
	attrs["hx-target"] = "#main-content"
	attrs["hx-push-url"] = "true"
	attrs["hx-swap"] = "innerHTML"
	return attrs
}
