package modules

import (
	"fmt"
	"strconv"

	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/internal/ctxkeys"
	wrappedicon "github.com/axadrn/shadcn-templ/v2/internal/ui/icons"
)

// formatStars is StarsCount in github-link.tsx with one deviation: the
// reference rounds to full thousands (Math.round(n/1000) + "k"), which is
// honest at their 91k but turns our 1.6k into "2k". So thousands keep one
// decimal; below 1000 the plain number, like the reference.
func formatStars(count int) string {
	if count >= 1000 {
		return fmt.Sprintf("%.1fk", float64(count)/1000)
	}
	return strconv.Itoa(count)
}

// GitHubLink is the pendant of shadcn's components/github-link.tsx: a ghost
// sm button with the GitHub mark and the live star count (ours comes from
// ctx instead of a fetch cache). The reference's Button comes from
// registry/new-york-v4, ours is the active style's button.
templ GitHubLink() {
	{{ stars := 0 }}
	{{
		if starsVal := ctx.Value(ctxkeys.GitHubStars); starsVal != nil {
			stars = starsVal.(int)
		}
	}}
	@button.Button(button.Props{
		Size:    button.SizeSm,
		Variant: button.VariantGhost,
		Class:   "h-8 shadow-none",
		Href:    "https://github.com/axadrn/shadcn-templ",
		Target:  "_blank",
		Attributes: templ.Attributes{
			"rel": "noreferrer",
		},
	}) {
		@wrappedicon.GitHub(16)
		if stars > 0 {
			<span class="w-fit text-xs text-muted-foreground tabular-nums">{ formatStars(stars) }</span>
		}
	}
}
