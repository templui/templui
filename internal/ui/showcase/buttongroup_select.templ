package showcase

import (
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/buttongroup"
	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/components/input"
	selectcomp "github.com/templui/templui/components/select"
)

templ ButtonGroupSelect() {
	@buttongroup.ButtonGroup() {
		@buttongroup.ButtonGroup() {
			@selectcomp.Select() {
				@selectcomp.Trigger(selectcomp.TriggerProps{Class: "font-mono"}) {
					@selectcomp.Value(selectcomp.ValueProps{Placeholder: "$"})
				}
				@selectcomp.Content(selectcomp.ContentProps{Class: "min-w-24"}) {
					@selectcomp.Item(selectcomp.ItemProps{
						Value:    "$",
						Selected: true,
					}) {
						$ <span class="text-muted-foreground">US Dollar</span>
					}
					@selectcomp.Item(selectcomp.ItemProps{Value: "€"}) {
						€ <span class="text-muted-foreground">Euro</span>
					}
					@selectcomp.Item(selectcomp.ItemProps{Value: "£"}) {
						£ <span class="text-muted-foreground">British Pound</span>
					}
				}
			}
			@input.Input(input.Props{Placeholder: "10.00"})
		}
		@buttongroup.ButtonGroup() {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Size:       button.SizeIcon,
				Attributes: templ.Attributes{"aria-label": "Send"},
			}) {
				@icon.ArrowRight()
			}
		}
	}
}
