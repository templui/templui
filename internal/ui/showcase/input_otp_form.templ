package showcase

import (
	"github.com/templui/templui/components/field"
	"github.com/templui/templui/components/inputotp"
)

templ InputOTPForm() {
	@field.Field() {
		@field.Label(field.LabelProps{
			For: "otp-form",
		}) {
			Verification Code
		}
		@inputotp.InputOTP(inputotp.Props{
			ID:       "otp-form",
			HasError: true,
		}) {
			@inputotp.Group() {
				@inputotp.Slot(inputotp.SlotProps{
					Index: 0,
				})
				@inputotp.Slot(inputotp.SlotProps{
					Index: 1,
				})
				@inputotp.Slot(inputotp.SlotProps{
					Index: 2,
				})
				@inputotp.Separator()
				@inputotp.Slot(inputotp.SlotProps{
					Index: 3,
				})
				@inputotp.Slot(inputotp.SlotProps{
					Index: 4,
				})
				@inputotp.Slot(inputotp.SlotProps{
					Index: 5,
				})
			}
		}
		@field.Description() {
			Enter the 6-digit code sent to your phone
		}
		@field.Error() {
			Invalid verification code.
		}
	}
}
