package showcase

import (
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/popovernative"
)

templ PopoverNative() {
	@popovernative.Trigger(popovernative.TriggerProps{
		For: "default-native-popover",
	}) {
		@button.Button(button.Props{
			Variant: button.VariantOutline,
		}) {
			Open Native Popover
		}
	}
	@popovernative.Content(popovernative.ContentProps{
		ID: "default-native-popover",
	}) {
		@PopoverContent()
	}
}
