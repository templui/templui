package showcase

import (
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/popovernative"
)

templ PopoverNative() {
	@popovernative.Root() {
		@popovernative.Trigger() {
			@button.Button(button.Props{
				Variant: button.VariantOutline,
			}) {
				Open Native Popover
			}
		}
		@popovernative.Content() {
			@PopoverContent()
		}
	}
}
