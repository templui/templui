package showcase

import (
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/dialog"
	"github.com/templui/templui/components/field"
	"github.com/templui/templui/components/input"
)

templ DialogDefault() {
	@dialog.Dialog() {
		@button.Button(button.Props{
			Variant:    button.VariantOutline,
			Attributes: dialog.Trigger(ctx),
		}) {
			Open Dialog
		}
		@dialog.Content(dialog.ContentProps{
			Class: "max-w-md",
		}) {
			@dialog.Header() {
				@dialog.Title() {
					Edit Profile
				}
				@dialog.Description() {
					Make changes to your profile here. Click save when you're done.
				}
			}
			<div class="space-y-4">
				<div class="space-y-2">
					@field.Label(field.LabelProps{For: "name"}) {
						Name
					}
					@input.Input(input.Props{
						ID:          "name",
						Placeholder: "Enter your name",
						Value:       "Axel Adrian",
					})
				</div>
				<div class="space-y-2">
					@field.Label(field.LabelProps{For: "username"}) {
						Username
					}
					@input.Input(input.Props{
						ID:          "username",
						Placeholder: "Enter your username",
						Value:       "@axadrn",
					})
				</div>
			</div>
			@dialog.Footer() {
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Attributes: dialog.Close(ctx),
				}) {
					Cancel
				}
				@button.Button() {
					Save changes
				}
			}
		}
	}
}
