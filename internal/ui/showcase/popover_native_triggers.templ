package showcase

import (
	"github.com/templui/templui/components/button"
	popovernative "github.com/templui/templui/components/popovernative"
)

templ PopoverNativeTriggers() {
	<div class="flex gap-2 flex-wrap">
		@popovernative.Trigger(popovernative.TriggerProps{
			For:         "hover-native-popover",
			TriggerType: popovernative.TriggerTypeHover,
		}) {
			@button.Button(button.Props{Variant: button.VariantOutline}) {
				Hover
			}
		}
		@popovernative.Content(popovernative.ContentProps{
			ID:            "hover-native-popover",
			HoverDelay:    300,
			HoverOutDelay: 500,
		}) {
			@PopoverContent()
		}
		@popovernative.Trigger(popovernative.TriggerProps{
			For: "click-native-popover",
		}) {
			@button.Button(button.Props{Variant: button.VariantOutline}) {
				Click
			}
		}
		@popovernative.Content(popovernative.ContentProps{
			ID: "click-native-popover",
		}) {
			@PopoverContent()
		}
		@popovernative.Trigger(popovernative.TriggerProps{
			For: "no-clickaway-native-popover",
		}) {
			@button.Button(button.Props{Variant: button.VariantOutline}) {
				No ClickAway
			}
		}
		@popovernative.Content(popovernative.ContentProps{
			ID:               "no-clickaway-native-popover",
			DisableClickAway: true,
		}) {
			@PopoverContent()
		}
		@popovernative.Trigger(popovernative.TriggerProps{
			For: "no-clickaway-esc-native-popover",
		}) {
			@button.Button(button.Props{Variant: button.VariantOutline}) {
				No ClickAway-ESC
			}
		}
		@popovernative.Content(popovernative.ContentProps{
			ID:               "no-clickaway-esc-native-popover",
			DisableClickAway: true,
			DisableESC:       true,
		}) {
			@PopoverContent()
		}
	</div>
}
