GO_ENV=development
SHIKI_URL=http://localhost:3000/highlight
# Absolute origin for self-referencing URLs (canonical, og:url, AI prompt
# links, registry meta). Defaults to https://shadcn-templ.com; the beta deploy
# sets https://shadcn-templ.com.
BASE_URL=https://shadcn-templ.com
# Baked highlight cache path (build artifact, see cmd/highlight-gen);
# unset in dev - the live shiki service handles highlighting.
# HIGHLIGHT_CACHE=assets/highlight-cache.json.gz
# Docs server port (default 8090).
# PORT=8090
