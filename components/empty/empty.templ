package empty

import "github.com/templui/templui/utils"

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type HeaderProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type MediaVariant string

const (
	MediaVariantDefault MediaVariant = "default"
	MediaVariantIcon    MediaVariant = "icon"
)

type MediaProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Variant    MediaVariant
}

type TitleProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type DescriptionProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type ContentProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

func mediaClasses(variant MediaVariant) string {
	base := "mb-2 flex shrink-0 items-center justify-center [&_svg]:pointer-events-none [&_svg]:shrink-0"
	if variant == MediaVariantIcon {
		return utils.TwMerge(base, "size-8 rounded-lg bg-muted text-foreground [&_svg:not([class*='size-'])]:size-4")
	}
	return utils.TwMerge(base, "bg-transparent")
}

templ Empty(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="empty"
		class={
			utils.TwMerge(
				"flex w-full min-w-0 flex-1 flex-col items-center justify-center gap-4 rounded-xl border-dashed p-6 text-center text-balance",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Header(props ...HeaderProps) {
	{{ var p HeaderProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="empty-header"
		class={ utils.TwMerge("flex max-w-sm flex-col items-center gap-2", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Media(props ...MediaProps) {
	{{ var p MediaProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Variant == "" {
		{{ p.Variant = MediaVariantDefault }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="empty-icon"
		data-variant={ string(p.Variant) }
		class={ utils.TwMerge(mediaClasses(p.Variant), p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Title(props ...TitleProps) {
	{{ var p TitleProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="empty-title"
		class={ utils.TwMerge("text-sm font-medium tracking-tight", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Description(props ...DescriptionProps) {
	{{ var p DescriptionProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="empty-description"
		class={
			utils.TwMerge(
				"text-sm/relaxed text-muted-foreground [&>a]:underline [&>a]:underline-offset-4 [&>a:hover]:text-primary",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="empty-content"
		class={
			utils.TwMerge(
				"flex w-full max-w-sm min-w-0 flex-col items-center gap-2.5 text-sm text-balance",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}
