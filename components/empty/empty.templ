package empty

import "github.com/axadrn/shadcn-templ/v2/utils"

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type HeaderProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type MediaVariant string

const (
	MediaVariantDefault MediaVariant = "default"
	MediaVariantIcon    MediaVariant = "icon"
)

type MediaProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Variant    MediaVariant
}

type TitleProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type DescriptionProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type ContentProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

func mediaClasses(variant MediaVariant) string {
	base := "cn-empty-media flex shrink-0 items-center justify-center [&_svg]:pointer-events-none [&_svg]:shrink-0"
	if variant == MediaVariantIcon {
		return utils.CN(base, "cn-empty-media-icon")
	}
	return utils.CN(base, "cn-empty-media-default")
}

templ Empty(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="empty"
		class={
			utils.CN(
				"cn-empty flex w-full min-w-0 flex-1 flex-col items-center justify-center text-center text-balance",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Header(props ...HeaderProps) {
	{{ var p HeaderProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="empty-header"
		class={ utils.CN("cn-empty-header flex max-w-sm flex-col items-center", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Media(props ...MediaProps) {
	{{ var p MediaProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Variant == "" {
		{{ p.Variant = MediaVariantDefault }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="empty-icon"
		data-variant={ string(p.Variant) }
		class={ utils.CN(mediaClasses(p.Variant), p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Title(props ...TitleProps) {
	{{ var p TitleProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="empty-title"
		class={ utils.CN("cn-empty-title cn-font-heading", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Description(props ...DescriptionProps) {
	{{ var p DescriptionProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="empty-description"
		class={
			utils.CN(
				"cn-empty-description text-muted-foreground [&>a]:underline [&>a]:underline-offset-4 [&>a:hover]:text-primary",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="empty-content"
		class={
			utils.CN(
				"cn-empty-content flex w-full max-w-sm min-w-0 flex-col items-center text-balance",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}
