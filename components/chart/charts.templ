package chart

import (
	"fmt"
	"strings"

	"github.com/templui/templui/utils"
)

// Datum is one row of chart data, the pendant of the plain objects in
// shadcn's chartData arrays.
type Datum map[string]any

// Margin replaces Recharts' default margin of 5 on every side entirely
// when set, like the Recharts margin prop.
type Margin struct {
	Top, Right, Bottom, Left float64
}

type CurveType string

const CurveNatural CurveType = "natural"

// XAxisProps is the pendant of Recharts' XAxis.
type XAxisProps struct {
	DataKey       string
	TickLine      bool
	AxisLine      bool
	TickMargin    float64
	MinTickGap    float64 // defaults to Recharts' 5
	TickFormatter func(any) string
}

// TooltipProps is the pendant of ChartTooltip plus ChartTooltipContent.
type TooltipProps struct {
	Cursor         bool
	Indicator      string // "dot" (default), "line", "dashed"
	HideLabel      bool
	NameKey        string
	Class          string // extra content class, e.g. "w-[150px]"
	LabelFormatter func(any) string
}

// AreaProps is the pendant of one Recharts Area.
type AreaProps struct {
	DataKey     string
	Type        CurveType
	Fill        string // "gradient" for the defs gradient, else a color, empty uses the series color
	Stroke      string
	StackID     string
	FillOpacity float64 // 0 uses Recharts' default 0.6
}

// BarProps is the pendant of one Recharts Bar.
type BarProps struct {
	DataKey string
	Fill    string
	Radius  float64
}

// AreaChartProps is the pendant of a Recharts AreaChart tree.
type AreaChartProps struct {
	Data    []Datum
	Config  Config
	Margin  *Margin
	XAxis   *XAxisProps
	Tooltip *TooltipProps
	Legend  bool
	Areas   []AreaProps
	// Width and Height are the SSR first paint size, chart.js re-renders
	// at the real container pixels.
	Width, Height float64
}

// BarChartProps is the pendant of a Recharts BarChart tree.
type BarChartProps struct {
	Data          []Datum
	Config        Config
	Margin        *Margin
	XAxis         *XAxisProps
	Tooltip       *TooltipProps
	Bars          []BarProps
	Width, Height float64
}

// PieChartProps is the pendant of a Recharts PieChart with one Pie.
type PieChartProps struct {
	Data        []Datum
	Config      Config
	DataKey     string
	NameKey     string
	InnerRadius float64
	StrokeWidth float64
	Tooltip     *TooltipProps
	// ActiveIndex grows the sector like the interactive demo's custom
	// shape, ActiveRing adds the detached outer ring.
	ActiveIndex int
	ActiveRing  bool
	// CenterValue and CenterLabel render the Label content in the donut
	// hole.
	CenterValue, CenterLabel string
	Width, Height            float64
}

const (
	defaultXAxisHeight  = 30.0
	defaultLegendHeight = 28.0
)

func num(v any) float64 {
	switch n := v.(type) {
	case float64:
		return n
	case float32:
		return float64(n)
	case int:
		return float64(n)
	case int64:
		return float64(n)
	}
	return 0
}

func str(v any) string {
	return fmt.Sprint(v)
}

// seriesColor resolves the fill/stroke for a data key: the container's
// generated --color-<key> variable.
func seriesColor(key string) string {
	return "var(--color-" + key + ")"
}

func (c Config) Label(key string) string {
	for _, s := range c {
		if s.Key == key {
			return s.Label
		}
	}
	return key
}

// cartesianModel normalizes an area or bar chart into the shared model
// that both the Go and the chart.js renderer consume.
func cartesianModel(kind string, data []Datum, config Config, margin *Margin, x *XAxisProps, tt *TooltipProps, legend bool, areas []AreaProps, bars []BarProps) Model {
	m := Model{Kind: kind}
	if margin != nil {
		m.MarginTop, m.MarginRight, m.MarginBottom, m.MarginLeft = margin.Top, margin.Right, margin.Bottom, margin.Left
	} else {
		m.MarginTop, m.MarginRight, m.MarginBottom, m.MarginLeft = 5, 5, 5, 5
	}
	if x != nil {
		m.XAxisHeight = defaultXAxisHeight
		m.TickMargin = x.TickMargin
		m.MinTickGap = x.MinTickGap
		if m.MinTickGap == 0 {
			m.MinTickGap = 5
		}
	}
	if legend {
		m.LegendHeight = defaultLegendHeight
	}
	if tt != nil {
		m.Cursor = tt.Cursor
		m.Tooltip = TooltipModel{Indicator: tt.Indicator, HideLabel: tt.HideLabel, Width: tt.Class}
	}

	m.Labels = make([]string, len(data))
	m.TooltipLabels = make([]string, len(data))
	for i, d := range data {
		raw := d[x.DataKey]
		if x.TickFormatter != nil {
			m.Labels[i] = x.TickFormatter(raw)
		} else {
			m.Labels[i] = str(raw)
		}
		if tt != nil && tt.LabelFormatter != nil {
			m.TooltipLabels[i] = tt.LabelFormatter(raw)
		} else {
			m.TooltipLabels[i] = str(raw)
		}
	}

	if kind == "bar" {
		m.CategoryGap = 0.1
		for _, b := range bars {
			if b.Radius > 0 {
				m.Radius = b.Radius
			}
			m.Series = append(m.Series, modelSeries(config, b.DataKey, b.Fill, 0, data))
		}
	} else {
		gradient := false
		stacked := false
		for _, a := range areas {
			if a.Fill == "gradient" {
				gradient = true
			}
			if a.StackID != "" {
				stacked = true
			}
			m.Series = append(m.Series, modelSeries(config, a.DataKey, "", a.FillOpacity, data))
		}
		m.Gradient = gradient
		m.Stacked = stacked
	}
	return m
}

func modelSeries(config Config, key, fill string, fillOpacity float64, data []Datum) ModelSeries {
	color := fill
	if color == "" || color == "gradient" {
		color = seriesColor(key)
	}
	values := make([]float64, len(data))
	for i, d := range data {
		values[i] = num(d[key])
	}
	return ModelSeries{Key: key, Label: config.Label(key), Color: color, Values: values, FillOpacity: fillOpacity}
}

// cartesianSVG is the server side pendant of chart.js' renderCartesian:
// identical geometry, identical Recharts markup.
func cartesianSVG(m Model, W, H float64, uid string) string {
	plotX, plotY := m.MarginLeft, m.MarginTop
	plotW := W - m.MarginLeft - m.MarginRight
	plotH := H - m.MarginTop - m.MarginBottom - m.XAxisHeight - m.LegendHeight
	plotBottom := plotY + plotH
	n := len(m.Labels)

	max := 0.0
	if m.Stacked {
		for i := 0; i < n; i++ {
			sum := 0.0
			for _, s := range m.Series {
				sum += s.Values[i]
			}
			if sum > max {
				max = sum
			}
		}
	} else {
		for _, s := range m.Series {
			for _, v := range s.Values {
				if v > max {
					max = v
				}
			}
		}
	}
	ticks := NiceTicks(max, 5)
	domainMax := ticks[len(ticks)-1]

	var sb strings.Builder
	fmt.Fprintf(&sb, `<svg class="recharts-surface" width="100%%" height="100%%" viewBox="0 0 %s %s" style="width:100%%;height:100%%">`, FmtF(W), FmtF(H))

	if m.Gradient {
		sb.WriteString(`<defs>`)
		for _, s := range m.Series {
			fmt.Fprintf(&sb,
				`<linearGradient id="%s-fill-%s" x1="0" y1="0" x2="0" y2="1"><stop offset="5%%" stop-color="%s" stop-opacity="0.8"/><stop offset="95%%" stop-color="%s" stop-opacity="0.1"/></linearGradient>`,
				uid, s.Key, s.Color, s.Color)
		}
		sb.WriteString(`</defs>`)
	}

	sb.WriteString(`<g class="recharts-layer recharts-cartesian-grid"><g class="recharts-cartesian-grid-horizontal">`)
	for _, tv := range ticks {
		y := LinearY(tv, domainMax, plotY, plotH)
		fmt.Fprintf(&sb, `<line stroke="#ccc" fill="none" x1="%s" y1="%s" x2="%s" y2="%s"/>`, FmtF(plotX), FmtF(y), FmtF(plotX+plotW), FmtF(y))
	}
	sb.WriteString(`</g></g>`)

	xs := make([]float64, n)
	if m.Kind == "bar" {
		s := m.Series[0]
		band := plotW / float64(n)
		gapOffset, barW := BarGeometry(band, m.CategoryGap)
		sb.WriteString(`<g class="recharts-layer recharts-bar"><g class="recharts-layer recharts-bar-rectangles">`)
		for i := 0; i < n; i++ {
			x := plotX + float64(i)*band + gapOffset
			y := LinearY(s.Values[i], domainMax, plotY, plotH)
			fmt.Fprintf(&sb,
				`<g class="recharts-layer recharts-bar-rectangle"><path fill="%s" d="%s"/></g>`,
				s.Color, RoundedBarPath(x, y, barW, plotBottom-y, m.Radius))
		}
		sb.WriteString(`</g></g>`)
		for i := 0; i < n; i++ {
			xs[i] = plotX + float64(i)*band + band/2
		}
	} else {
		for i := 0; i < n; i++ {
			xs[i] = plotX + float64(i)*(plotW/float64(n-1))
		}
		baseline := make([]float64, n)
		for i := range baseline {
			baseline[i] = plotBottom
		}
		base := baseline
		for _, s := range m.Series {
			top := make([]float64, n)
			for i := 0; i < n; i++ {
				if m.Stacked {
					top[i] = base[i] - (s.Values[i]/domainMax)*plotH
				} else {
					top[i] = LinearY(s.Values[i], domainMax, plotY, plotH)
				}
			}
			fill := s.Color
			if m.Gradient {
				fill = fmt.Sprintf("url(#%s-fill-%s)", uid, s.Key)
			}
			opacity := s.FillOpacity
			if opacity == 0 {
				opacity = 0.6
			}
			areaD := AreaPathBetween(xs, top, base)
			if !m.Stacked {
				areaD = AreaPathBetween(xs, top, baseline)
			}
			fmt.Fprintf(&sb,
				`<g class="recharts-layer recharts-area"><path class="recharts-curve recharts-area-area" fill="%s" fill-opacity="%s" stroke="none" d="%s"/><path class="recharts-curve recharts-area-curve" stroke="%s" fill="none" stroke-width="1" d="%s"/></g>`,
				fill, FmtF(opacity), areaD, s.Color, NaturalPath(xs, top))
			if m.Stacked {
				base = top
			}
		}
	}

	if m.XAxisHeight > 0 {
		sb.WriteString(`<g class="recharts-layer recharts-cartesian-axis recharts-xAxis xAxis"><g class="recharts-cartesian-axis-ticks">`)
		for _, tk := range PreserveEndTicks(xs, m.Labels, W, m.MinTickGap) {
			fmt.Fprintf(&sb,
				`<g class="recharts-layer recharts-cartesian-axis-tick"><text orientation="bottom" height="%s" x="%s" y="%s" stroke="none" fill="#666" class="recharts-text recharts-cartesian-axis-tick-value" text-anchor="middle"><tspan dy="0.71em">%s</tspan></text></g>`,
				FmtF(m.XAxisHeight), FmtF(tk.Coord), FmtF(plotBottom+m.TickMargin), m.Labels[tk.Index])
		}
		sb.WriteString(`</g></g>`)
	}

	sb.WriteString(`</svg>`)
	return sb.String()
}

// AreaChart renders a Recharts AreaChart: SSR SVG plus the model payload
// for the client runtime, and the legend when enabled.
templ AreaChart(p AreaChartProps) {
	{{
	if p.Width == 0 {
		p.Width, p.Height = 369, 207
	}
	m := cartesianModel("area", p.Data, p.Config, p.Margin, p.XAxis, p.Tooltip, p.Legend, p.Areas, nil)
	uid := "tui-" + utils.RandomID()
	}}
	<div style="position:relative;width:100%;height:100%">
		@templ.Raw(ModelScript(m) + cartesianSVG(m, p.Width, p.Height, uid))
		if p.Legend {
			@legendContent(m.Series)
		}
	</div>
}

// BarChart renders a Recharts BarChart the same way.
templ BarChart(p BarChartProps) {
	{{
	if p.Width == 0 {
		p.Width, p.Height = 369, 207
	}
	m := cartesianModel("bar", p.Data, p.Config, p.Margin, p.XAxis, p.Tooltip, false, nil, p.Bars)
	}}
	<div style="position:relative;width:100%;height:100%">
		@templ.Raw(ModelScript(m) + cartesianSVG(m, p.Width, p.Height, ""))
	</div>
}

// legendContent is the ChartLegendContent pendant, absolutely positioned
// like Recharts' legend wrapper.
templ legendContent(series []ModelSeries) {
	<div class="recharts-legend-wrapper" style="position:absolute;left:0;right:0;bottom:5px">
		<div class="flex items-center justify-center gap-4 pt-3">
			for i := len(series) - 1; i >= 0; i-- {
				<div class="flex items-center gap-1.5 [&>svg]:h-3 [&>svg]:w-3 [&>svg]:text-muted-foreground">
					<div class="h-2 w-2 shrink-0 rounded-[2px]" style={ "background-color:" + series[i].Color }></div>
					{ series[i].Label }
				</div>
			}
		</div>
	</div>
}

// PieChart renders a Recharts PieChart with one Pie: sectors from the data
// rows, the interactive active shape and the donut center label.
templ PieChart(p PieChartProps) {
	{{
	if p.Width == 0 {
		p.Width, p.Height = 250, 250
	}
	m := pieModel(p)
	}}
	<div style="position:relative;width:100%;height:100%">
		@templ.Raw(ModelScript(m) + pieSVG(p))
	</div>
}

func pieModel(p PieChartProps) Model {
	m := Model{
		Kind: "pie", Cursor: false,
		InnerRadius: p.InnerRadius, StrokeWidth: p.StrokeWidth,
		ActiveIndex: p.ActiveIndex, ActiveRing: p.ActiveRing,
		CenterValue: p.CenterValue, CenterLabel: p.CenterLabel,
	}
	if p.Tooltip != nil {
		m.Tooltip = TooltipModel{Indicator: p.Tooltip.Indicator, HideLabel: p.Tooltip.HideLabel, Width: p.Tooltip.Class}
	}
	values := make([]float64, len(p.Data))
	m.Labels = make([]string, len(p.Data))
	m.SliceColors = make([]string, len(p.Data))
	for i, d := range p.Data {
		values[i] = num(d[p.DataKey])
		key := str(d[p.NameKey])
		m.Labels[i] = p.Config.Label(key)
		if f, ok := d["fill"]; ok {
			m.SliceColors[i] = str(f)
		} else {
			m.SliceColors[i] = seriesColor(key)
		}
	}
	m.Series = []ModelSeries{{Key: p.DataKey, Label: p.Config.Label(p.DataKey), Values: values}}
	return m
}

func pieSVG(p PieChartProps) string {
	W, H := p.Width, p.Height
	const margin = 5.0
	cx, cy := W/2, H/2
	maxR := (min(W, H) - 2*margin) / 2
	outerR := maxR * 0.8

	total := 0.0
	for _, d := range p.Data {
		total += num(d[p.DataKey])
	}

	strokeWidth := ""
	if p.StrokeWidth > 0 {
		strokeWidth = fmt.Sprintf(` stroke-width="%s"`, FmtF(p.StrokeWidth))
	}

	var sb strings.Builder
	fmt.Fprintf(&sb, `<svg class="recharts-surface" width="100%%" height="100%%" viewBox="0 0 %s %s" style="width:100%%;height:100%%">`, FmtF(W), FmtF(H))
	sb.WriteString(`<g class="recharts-layer recharts-pie">`)
	angle := 0.0
	for i, d := range p.Data {
		sweep := num(d[p.DataKey]) / total * 360
		fill := seriesColor(str(d[p.NameKey]))
		if f, ok := d["fill"]; ok {
			fill = str(f)
		}
		if i == p.ActiveIndex && p.ActiveRing {
			fmt.Fprintf(&sb,
				`<g class="recharts-layer recharts-pie-sector"><path class="recharts-sector" stroke="#fff"%s fill="%s" data-tui-chart-sector="%d" d="%s"/><path class="recharts-sector" stroke="#fff"%s fill="%s" data-tui-chart-sector="%d" d="%s"/></g>`,
				strokeWidth, fill, i, SectorPath(cx, cy, p.InnerRadius, outerR+10, angle, angle+sweep),
				strokeWidth, fill, i, SectorPath(cx, cy, outerR+12, outerR+25, angle, angle+sweep))
		} else {
			fmt.Fprintf(&sb,
				`<g class="recharts-layer recharts-pie-sector"><path class="recharts-sector" stroke="#fff"%s fill="%s" data-tui-chart-sector="%d" d="%s"/></g>`,
				strokeWidth, fill, i, SectorPath(cx, cy, p.InnerRadius, outerR, angle, angle+sweep))
		}
		angle += sweep
	}
	if p.CenterValue != "" {
		fmt.Fprintf(&sb,
			`<text x="%s" y="%s" text-anchor="middle" dominant-baseline="middle"><tspan x="%s" y="%s" class="fill-foreground text-3xl font-bold">%s</tspan><tspan x="%s" y="%s" class="fill-muted-foreground">%s</tspan></text>`,
			FmtF(cx), FmtF(cy), FmtF(cx), FmtF(cy), p.CenterValue, FmtF(cx), FmtF(cy+24), p.CenterLabel)
	}
	sb.WriteString(`</g></svg>`)
	return sb.String()
}
