templ Separator(props ...SeparatorProps) {
	{{ var p SeparatorProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="item-separator"
		role="separator"
		class={ utils.TwMerge("my-2 h-px w-full shrink-0 bg-border", p.Class) }
		{ p.Attributes... }
	></div>
}
