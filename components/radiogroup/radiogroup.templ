package radiogroup

import (
	"context"

	"github.com/templui/templui/utils"
)

type ctxKey string

const stateKey ctxKey = "radioGroupState"

type ctxState struct {
	name     string
	value    string
	disabled bool
}

func state(ctx context.Context) ctxState {
	if s, ok := ctx.Value(stateKey).(ctxState); ok {
		return s
	}
	return ctxState{}
}

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	// Name is shared by all items in the group; a random name is generated
	// when empty so the radios stay mutually exclusive.
	Name string
	// Value preselects the item with this value.
	Value    string
	Disabled bool
}

type ItemProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Name       string
	Value      string
	Form       string
	Disabled   bool
	Checked    bool
}

// Group is the pendant of shadcn's RadioGroup: it shares the name and the
// selected value with the items (via ctx).
templ RadioGroup(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Name == "" {
		{{ p.Name = utils.RandomID() }}
	}
	{{ ctx = context.WithValue(ctx, stateKey, ctxState{name: p.Name, value: p.Value, disabled: p.Disabled}) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="radio-group"
		role="radiogroup"
		class={ utils.TwMerge("cn-radio-group w-full", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Radio is the pendant of shadcn's RadioGroupItem: the root carries the
// visuals and state pendants, a hidden native radio inside provides state,
// forms and the extended hit area, and the indicator is a real element.
templ Item(props ...ItemProps) {
	{{ var p ItemProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{
		s := state(ctx)
		if p.Name == "" {
			p.Name = s.name
		}
		checked := p.Checked || (s.value != "" && s.value == p.Value)
		disabled := p.Disabled || s.disabled
	}}
	<div
		data-slot="radio-group-item"
		if checked {
			data-checked
		} else {
			data-unchecked
		}
		class={
			utils.TwMerge(
				// 1:1 base/ui/radio-group.tsx: structure lives here, the look comes
				// from the active style-*.css via cn-radio-group-item. Two
				// deviations for our native-input DOM: the after:-inset hit area
				// lives on the hidden input instead (a pseudo element on the root
				// would swallow its clicks), and disabled: is translated to
				// has-[:disabled] because our root is a div, not Base UI's button.
				"cn-radio-group-item group/radio-group-item peer relative aspect-square shrink-0 border outline-none has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-50",
				p.Class,
			),
		}
	>
		<input
			if p.ID != "" {
				id={ p.ID }
			}
			data-slot="radio"
			type="radio"
			if p.Name != "" {
				name={ p.Name }
			}
			if p.Value != "" {
				value={ p.Value }
			}
			if p.Form != "" {
				form={ p.Form }
			}
			checked?={ checked }
			disabled?={ disabled }
			class="peer absolute -inset-x-3 -inset-y-2 size-auto cursor-default appearance-none outline-none"
			{ p.Attributes... }
		/>
		// Base UI unmounts the indicator while unchecked; our pendant toggles
		// it with hidden/peer-checked:flex (utilities win over the base-layer
		// cn-radio-group-indicator display).
		<span data-slot="radio-group-indicator" class="cn-radio-group-indicator hidden peer-checked:flex">
			<span class="cn-radio-group-indicator-icon"></span>
		</span>
	</div>
}
