package switchcomp

import "github.com/templui/templui/utils"

type Size string

const (
	SizeDefault Size = "default"
	SizeSm      Size = "sm"
)

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Name       string
	Value      string
	Disabled   bool
	Checked    bool
	Form       string
	// Size of the switch. Options: 'default', 'sm'.
	Size Size
}

// Switch is the pendant of shadcn's Base UI switch: the root carries the
// visuals and state pendants (has-[:checked] for data-checked), a hidden
// native checkbox inside provides state, forms and the extended hit area,
// and the thumb is a real element like Base UI's Switch.Thumb.
templ Switch(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	if p.Size == "" {
		{{ p.Size = SizeDefault }}
	}
	<div
		data-slot="switch"
		data-size={ string(p.Size) }
		if p.Checked {
			data-checked
		} else {
			data-unchecked
		}
		if p.Disabled {
			data-disabled
		}
		class={
			utils.TwMerge(
				// 1:1 base/ui/switch.tsx: structure lives here, the look comes from
				// the active style-*.css via cn-switch. One deviation for our
				// native-input DOM: the after:-inset hit area lives on the hidden
				// input instead (a pseudo element on the root would paint over it
				// and swallow the clicks).
				"cn-switch peer group/switch relative inline-flex items-center transition-all outline-none data-disabled:cursor-not-allowed data-disabled:opacity-50",
				p.Class,
			),
		}
	>
		<input
			id={ p.ID }
			type="checkbox"
			role="switch"
			if p.Name != "" {
				name={ p.Name }
			}
			if p.Value != "" {
				value={ p.Value }
			} else {
				value="on"
			}
			if p.Form != "" {
				form={ p.Form }
			}
			checked?={ p.Checked }
			disabled?={ p.Disabled }
			class="peer absolute -inset-x-3 -inset-y-2 size-auto cursor-default appearance-none outline-none"
			{ p.Attributes... }
		/>
		// Base UI mirrors data-checked/data-unchecked onto the thumb; the
		// peer-checked translate pendants keep the thumb moving on our native
		// input until the state attributes are JS-synced.
		<span
			data-slot="switch-thumb"
			if p.Checked {
				data-checked
			} else {
				data-unchecked
			}
			class="cn-switch-thumb pointer-events-none block ring-0 transition-transform peer-not-checked:translate-x-0 peer-checked:translate-x-[calc(100%-2px)]"
		></span>
	</div>
}
