package dialog

import (
	"context"

	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/utils"
)

type ctxKey string

const stateKey ctxKey = "dialogState"

type ctxState struct {
	id               string
	open             bool
	disableClickAway bool
}

func state(ctx context.Context) ctxState {
	if s, ok := ctx.Value(stateKey).(ctxState); ok {
		return s
	}
	return ctxState{}
}

type Props struct {
	ID string
	// Open renders the dialog already open on page load.
	Open bool
	// DisableClickAway keeps the dialog open when clicking the backdrop.
	DisableClickAway bool
}

// PortalProps has no Class: the portal node is the plumbing wrapper that
// stays [hidden] in <body> while the dialog is unmounted, it renders nothing
// of its own (base/ui/dialog.tsx DialogPortal passes only data-slot too).
type PortalProps struct {
	Attributes templ.Attributes
}

type OverlayProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// PopupProps is 1:1 base/ui/dialog.tsx DialogContent's props: the popup's own
// (className) plus HideCloseButton, the inverse of their showCloseButton.
// DisableModal is Dialog.Root's modal, which our popup carries as an
// attribute because the root renders no element.
type PopupProps struct {
	Class           string
	Attributes      templ.Attributes
	HideCloseButton bool
	DisableModal    bool
}

// ContentProps is PopupProps: Content is Portal + Overlay + Popup and passes
// them straight through, like DialogContent spreading onto Dialog.Popup.
type ContentProps = PopupProps

type HeaderProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type FooterProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type TitleProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type DescriptionProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// Dialog renders no element: it only carries the id and options that link
// Trigger, Content and Close (via ctx).
templ Dialog(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	{{ ctx = context.WithValue(ctx, stateKey, ctxState{id: p.ID, open: p.Open, disableClickAway: p.DisableClickAway}) }}
	{ children... }
}

// Trigger returns the attributes that turn any element (usually a button)
// into the dialog trigger — the asChild equivalent: no wrapper element.
func Trigger(ctx context.Context) templ.Attributes {
	return TriggerFor(state(ctx).id)
}

// TriggerFor targets a dialog outside the current Dialog root by id.
func TriggerFor(id string) templ.Attributes {
	return templ.Attributes{
		"data-tui-dialog-trigger": true,
		"aria-controls":           id,
		"aria-haspopup":           "dialog",
		"aria-expanded":           "false",
	}
}

// Close returns the attributes that make any element close the dialog.
func Close(ctx context.Context) templ.Attributes {
	return CloseFor(state(ctx).id)
}

// CloseFor targets a dialog outside the current Dialog root by id.
func CloseFor(id string) templ.Attributes {
	return templ.Attributes{
		"data-tui-dialog-close":  true,
		"data-tui-dialog-target": id,
	}
}

// Portal is 1:1 base/ui/dialog.tsx DialogPortal (Dialog.Portal). Inert until
// the script portals it to <body> at init, so the SSRd content never
// participates in layout or sibling CSS. The wrapper div is the FloatingPortal
// node: it stays in <body>, [hidden] while the dialog is unmounted (Base UI
// removes the portal subtree instead), and the script drives the Base UI
// data-open/data-closed/data-starting-style/data-ending-style lifecycle on
// backdrop and popup.
//
// A Portal composed without an Overlay gets Base UI's InternalBackdrop, the
// invisible full-viewport layer DialogPortal renders for every modal dialog
// (dialog/portal/DialogPortal.tsx): dialog.js creates it, since a rendered
// Overlay doubles as it.
templ Portal(props ...PortalProps) {
	{{ var p PortalProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<template data-tui-dialog-portal>
		<div data-tui-dialog-root hidden { p.Attributes... }>
			{ children... }
		</div>
	</template>
}

// Overlay is 1:1 base/ui/dialog.tsx DialogOverlay (Dialog.Backdrop): the look
// comes from cn-dialog-overlay. user-select none is Base UI's inline style on
// the backdrop.
templ Overlay(props ...OverlayProps) {
	{{ var p OverlayProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="dialog-overlay"
		data-tui-dialog-backdrop
		role="presentation"
		style="user-select: none; -webkit-user-select: none;"
		class={ utils.TwMerge("cn-dialog-overlay fixed inset-0 isolate z-50", p.Class) }
		{ p.Attributes... }
	></div>
}

// Popup is 1:1 base/ui/dialog.tsx DialogContent's Dialog.Popup — the part
// their command-menu.tsx composes under DialogPortal on its own: the look
// comes from cn-dialog-content, tabindex is managed at runtime like Base UI's
// handleTabIndex.
templ Popup(props ...PopupProps) {
	{{ var p PopupProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ s := state(ctx) }}
	<div
		id={ s.id }
		role="dialog"
		tabindex="-1"
		data-slot="dialog-content"
		data-tui-dialog-content
		data-tui-dialog-initial-open={ utils.IfElse(s.open, "true", "false") }
		data-tui-dialog-show-modal={ utils.IfElse(!p.DisableModal, "true", "false") }
		if s.disableClickAway {
			data-tui-dialog-disable-click-away="true"
		}
		class={ p.Class }
		{ p.Attributes... }
	>
		{ children... }
		if !p.HideCloseButton {
			@button.Button(button.Props{
				Variant: button.VariantGhost,
				Size:    button.SizeIconSm,
				Class:   "cn-dialog-close",
				Attributes: templ.Attributes{
					"data-slot":             "dialog-close",
					"data-tui-dialog-close": true,
					"aria-label":            "Close",
				},
			}) {
				@icon.X()
				<span class="sr-only">Close</span>
			}
		}
	</div>
}

// Content is 1:1 base/ui/dialog.tsx DialogContent: DialogPortal > DialogOverlay
// + Dialog.Popup.
templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	// Overlay and Popup share a line because templ writes a space between two
	// component calls on separate lines; the portal node holds elements only.
	// The wrapper classes live here, not in Popup: Popup is the pendant of
	// Dialog.Popup (the bare primitive), Content of shadcn's DialogContent
	// which adds cn-dialog-content and the centering. Callers that need the
	// bare popup (the command menu, like their local DialogContent) compose
	// Portal + Popup themselves.
	{{ p.Class = utils.TwMerge("cn-dialog-content fixed top-1/2 left-1/2 z-50 w-full -translate-x-1/2 -translate-y-1/2 outline-none", p.Class) }}
	@Portal() {
		@Overlay()@Popup(p) {
			{ children... }
		}
	}
}

templ Header(props ...HeaderProps) {
	{{ var p HeaderProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="dialog-header"
		class={ utils.TwMerge("cn-dialog-header flex flex-col", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Footer(props ...FooterProps) {
	{{ var p FooterProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="dialog-footer"
		class={ utils.TwMerge("cn-dialog-footer flex flex-col-reverse gap-2 sm:flex-row sm:justify-end", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Title(props ...TitleProps) {
	{{ var p TitleProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	// data-tui-dialog-title is the Title registration: the script wires the
	// popup's aria-labelledby to this element, like Base UI's useDialogTitle.
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="dialog-title"
		data-tui-dialog-title
		class={ utils.TwMerge("cn-dialog-title cn-font-heading", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Description(props ...DescriptionProps) {
	{{ var p DescriptionProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	// data-tui-dialog-description is the Description registration: the script
	// wires the popup's aria-describedby to this element, like Base UI.
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="dialog-description"
		data-tui-dialog-description
		class={ utils.TwMerge("cn-dialog-description", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}
