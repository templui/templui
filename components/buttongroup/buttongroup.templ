package buttongroup

import "github.com/templui/templui/utils"

type Orientation string

const (
	OrientationHorizontal Orientation = "horizontal"
	OrientationVertical   Orientation = "vertical"
)

type Props struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Orientation Orientation
}

type TextProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type SeparatorProps struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Orientation Orientation
}

// Rounding is data-slot based like base-nova: hidden elements without a
// data-slot (e.g. a select's form input) never break the first/last rounding.
func variantClasses(o Orientation) string {
	base := "group/button-group flex w-fit items-stretch *:focus-visible:relative *:focus-visible:z-10 has-[>[data-slot=button-group]]:gap-2 has-[select[aria-hidden=true]:last-child]:[&>[data-slot=select-trigger]:last-of-type]:rounded-r-lg [&>[data-slot=select-trigger]:not([class*='w-'])]:w-fit [&>input]:flex-1"
	switch o {
	case OrientationVertical:
		return base + " flex-col *:data-slot:rounded-b-none [&>[data-slot]~[data-slot]]:rounded-t-none [&>[data-slot]~[data-slot]]:border-t-0 [&>[data-slot]:not(:has(~[data-slot]))]:rounded-b-lg!"
	default:
		return base + " *:data-slot:rounded-r-none [&>[data-slot]~[data-slot]]:rounded-l-none [&>[data-slot]~[data-slot]]:border-l-0 [&>[data-slot]:not(:has(~[data-slot]))]:rounded-r-lg!"
	}
}

templ ButtonGroup(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Orientation == "" {
		{{ p.Orientation = OrientationHorizontal }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="group"
		data-slot="button-group"
		data-orientation={ string(p.Orientation) }
		class={ utils.TwMerge(variantClasses(p.Orientation), p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Text(props ...TextProps) {
	{{ var p TextProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="button-group-text"
		class={ utils.TwMerge("flex items-center gap-2 rounded-lg border bg-muted px-2.5 text-sm font-medium [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Separator(props ...SeparatorProps) {
	{{ var p SeparatorProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Orientation == "" {
		{{ p.Orientation = OrientationVertical }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="separator"
		data-slot="button-group-separator"
		data-orientation={ string(p.Orientation) }
		class={ utils.TwMerge("relative self-stretch bg-input shrink-0 data-[orientation=vertical]:my-px data-[orientation=vertical]:h-auto data-[orientation=vertical]:w-px data-[orientation=horizontal]:mx-px data-[orientation=horizontal]:w-auto data-[orientation=horizontal]:h-px", p.Class) }
		{ p.Attributes... }
	></div>
}
