package inputgroup

import (
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/textarea"
	"github.com/templui/templui/utils"
)

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type Align string

const (
	AlignInlineStart Align = "inline-start"
	AlignInlineEnd   Align = "inline-end"
	AlignBlockStart  Align = "block-start"
	AlignBlockEnd    Align = "block-end"
)

type ButtonSize string

const (
	ButtonSizeXs     ButtonSize = "xs"
	ButtonSizeSm     ButtonSize = "sm"
	ButtonSizeIconXs ButtonSize = "icon-xs"
	ButtonSizeIconSm ButtonSize = "icon-sm"
)

type AddonProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Align      Align
}

type InputProps struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Type        string
	Name        string
	Value       string
	Placeholder string
	Disabled    bool
}

type TextareaProps struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Name        string
	Value       string
	Placeholder string
	Disabled    bool
	Rows        int
}

type ButtonProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Type       button.Type
	Variant    button.Variant
	Size       ButtonSize
	Disabled   bool
}

type TextProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

templ InputGroup(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="group"
		data-slot="input-group"
		class={ utils.TwMerge("group/input-group relative flex h-8 w-full min-w-0 items-center rounded-lg border border-input transition-colors outline-none has-disabled:bg-input/50 has-disabled:opacity-50 has-[[data-slot=input-group-control]:focus-visible]:border-ring has-[[data-slot=input-group-control]:focus-visible]:ring-3 has-[[data-slot=input-group-control]:focus-visible]:ring-ring/50 has-[[data-slot][aria-invalid=true]]:border-destructive has-[[data-slot][aria-invalid=true]]:ring-3 has-[[data-slot][aria-invalid=true]]:ring-destructive/20 has-[>[data-align=block-end]]:h-auto has-[>[data-align=block-end]]:flex-col has-[>[data-align=block-start]]:h-auto has-[>[data-align=block-start]]:flex-col has-[>textarea]:h-auto dark:bg-input/30 dark:has-disabled:bg-input/80 dark:has-[[data-slot][aria-invalid=true]]:ring-destructive/40 has-[>[data-align=block-end]]:[&>input]:pt-3 has-[>[data-align=block-start]]:[&>input]:pb-3 has-[>[data-align=inline-end]]:[&>input]:pr-1.5 has-[>[data-align=inline-start]]:[&>input]:pl-1.5", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Input wraps the base Input component with the input-group control override,
// exactly like shadcn's InputGroupInput wraps <Input/>. All base sizing
// (h-8, w-full, px-2.5, …) comes from input.Input — no local re-styling.
templ Input(props ...InputProps) {
	{{ var p InputProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{
		attrs := templ.Attributes{"data-slot": "input-group-control"}
		for k, v := range p.Attributes {
			attrs[k] = v
		}
	}}
	@input.Input(input.Props{
		ID:          p.ID,
		Type:        input.Type(p.Type),
		Name:        p.Name,
		Value:       p.Value,
		Placeholder: p.Placeholder,
		Disabled:    p.Disabled,
		Class:       utils.TwMerge("flex-1 rounded-none border-0 bg-transparent shadow-none ring-0 focus-visible:ring-0 disabled:bg-transparent aria-invalid:ring-0 dark:bg-transparent dark:disabled:bg-transparent", p.Class),
		Attributes:  attrs,
	})
}

// Textarea wraps the base Textarea component with the input-group control
// override, exactly like shadcn's InputGroupTextarea wraps <Textarea/>.
templ Textarea(props ...TextareaProps) {
	{{ var p TextareaProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{
		attrs := templ.Attributes{"data-slot": "input-group-control"}
		for k, v := range p.Attributes {
			attrs[k] = v
		}
	}}
	@textarea.Textarea(textarea.Props{
		ID:          p.ID,
		Name:        p.Name,
		Value:       p.Value,
		Placeholder: p.Placeholder,
		Rows:        p.Rows,
		Disabled:    p.Disabled,
		Class:       utils.TwMerge("flex-1 resize-none rounded-none border-0 bg-transparent py-2 shadow-none ring-0 focus-visible:ring-0 disabled:bg-transparent aria-invalid:ring-0 dark:bg-transparent dark:disabled:bg-transparent", p.Class),
		Attributes:  attrs,
	})
}

templ Addon(props ...AddonProps) {
	{{ var p AddonProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Align == "" {
		{{ p.Align = AlignInlineStart }}
	}
	{{
		align := "order-first pl-2 has-[>button]:ml-[-0.3rem] has-[>kbd]:ml-[-0.15rem]"
		switch p.Align {
		case AlignInlineEnd:
			align = "order-last pr-2 has-[>button]:mr-[-0.3rem] has-[>kbd]:mr-[-0.15rem]"
		case AlignBlockStart:
			align = "order-first w-full justify-start px-2.5 pt-2 group-has-[>input]/input-group:pt-2 [.border-b]:pb-2"
		case AlignBlockEnd:
			align = "order-last w-full justify-start px-2.5 pb-2 group-has-[>input]/input-group:pb-2 [.border-t]:pt-2"
		}
	}}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="group"
		data-slot="input-group-addon"
		data-align={ string(p.Align) }
		class={ utils.TwMerge("flex h-auto cursor-text items-center justify-center gap-2 py-1.5 text-sm font-medium text-muted-foreground select-none group-data-[disabled=true]/input-group:opacity-50 [&>kbd]:rounded-[calc(var(--radius)-5px)] [&>svg:not([class*='size-'])]:size-4 "+align, p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

func inputGroupButtonClasses(size ButtonSize) string {
	base := "flex items-center gap-2 text-sm shadow-none"
	switch size {
	case ButtonSizeSm:
		return base
	case ButtonSizeIconXs:
		return base + " size-6 rounded-[calc(var(--radius)-3px)] p-0 has-[>svg]:p-0"
	case ButtonSizeIconSm:
		return base + " size-8 p-0 has-[>svg]:p-0"
	default:
		return base + " h-6 gap-1 rounded-[calc(var(--radius)-3px)] px-1.5 [&>svg:not([class*='size-'])]:size-3.5"
	}
}

templ Button(props ...ButtonProps) {
	{{ var p ButtonProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Type == "" {
		{{ p.Type = button.TypeButton }}
	}
	if p.Variant == "" {
		{{ p.Variant = button.VariantGhost }}
	}
	if p.Size == "" {
		{{ p.Size = ButtonSizeXs }}
	}
	{{
		attrs := templ.Attributes{"data-size": string(p.Size)}
		for k, v := range p.Attributes {
			attrs[k] = v
		}
	}}
	@button.Button(button.Props{
		Type:       p.Type,
		Variant:    p.Variant,
		Disabled:   p.Disabled,
		Class:      utils.TwMerge(inputGroupButtonClasses(p.Size), p.Class),
		Attributes: attrs,
	}) {
		{ children... }
	}
}

templ Text(props ...TextProps) {
	{{ var p TextProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("flex items-center gap-2 text-sm text-muted-foreground [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</span>
}
