	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="separator"
		data-slot="context-menu-separator"
		class={ utils.CN("cn-context-menu-separator", p.Class) }
		{ p.Attributes... }
	></div>
}

templ Shortcut(props ...ShortcutProps) {
	{{ var p ShortcutProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="context-menu-shortcut"
		class={ utils.CN("cn-context-menu-shortcut", p.Class) }
