package accordion

import (
	"context"

	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/utils"
)

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Multiple   bool
}

type ItemProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Open       bool
	Disabled   bool
}

type TriggerProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type ContentProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type ctxKey string

const (
	openKey     ctxKey = "accordionItemOpen"
	disabledKey ctxKey = "accordionItemDisabled"
)

func itemOpen(ctx context.Context) bool {
	open, _ := ctx.Value(openKey).(bool)
	return open
}

func itemDisabled(ctx context.Context) bool {
	disabled, _ := ctx.Value(disabledKey).(bool)
	return disabled
}

templ Accordion(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="accordion"
		data-multiple?={ p.Multiple }
		class={
			utils.TwMerge(
				"flex w-full flex-col",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Item(props ...ItemProps) {
	{{ var p ItemProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ ctx = context.WithValue(ctx, openKey, p.Open) }}
	{{ ctx = context.WithValue(ctx, disabledKey, p.Disabled) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="accordion-item"
		data-disabled?={ p.Disabled }
		class={
			utils.TwMerge(
				"group not-last:border-b",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Trigger(props ...TriggerProps) {
	{{ var p TriggerProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<h3 class="flex">
		<button
			if p.ID != "" {
				id={ p.ID }
			}
			type="button"
			data-slot="accordion-trigger"
			aria-expanded={ utils.IfElse(itemOpen(ctx), "true", "false") }
			disabled?={ itemDisabled(ctx) }
			class={
				utils.TwMerge(
					"group/accordion-trigger relative flex flex-1 items-start justify-between rounded-lg border border-transparent py-2.5 text-left text-sm font-medium transition-all outline-none hover:underline focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:after:border-ring disabled:pointer-events-none disabled:opacity-50",
					"**:data-[slot=accordion-trigger-icon]:ml-auto **:data-[slot=accordion-trigger-icon]:size-4 **:data-[slot=accordion-trigger-icon]:text-muted-foreground",
					p.Class,
				),
			}
			{ p.Attributes... }
		>
			{ children... }
			@icon.ChevronDown(icon.Props{
				Class:      "pointer-events-none shrink-0 group-aria-expanded/accordion-trigger:hidden",
				Attributes: templ.Attributes{"data-slot": "accordion-trigger-icon"},
			})
			@icon.ChevronUp(icon.Props{
				Class:      "pointer-events-none hidden shrink-0 group-aria-expanded/accordion-trigger:inline",
				Attributes: templ.Attributes{"data-slot": "accordion-trigger-icon"},
			})
		</button>
	</h3>
}

templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="accordion-content"
		hidden?={ !itemOpen(ctx) }
		class="overflow-hidden text-sm data-open:animate-accordion-down data-closed:animate-accordion-up"
		{ p.Attributes... }
	>
		<div
			class={
				utils.TwMerge(
					"pt-0 pb-2.5 [&_a]:underline [&_a]:underline-offset-3 [&_a]:hover:text-foreground [&_p:not(:last-child)]:mb-4",
					p.Class,
				),
			}
		>
			{ children... }
		</div>
	</div>
}

var scriptOnce = templ.NewOnceHandle()

templ Script() {
	@scriptOnce.Once() {
		@utils.ComponentScript("accordion")
	}
}
