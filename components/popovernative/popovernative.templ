package popovernative

import (
	"fmt"
	"github.com/templui/templui/utils"
	"strconv"
)

type Placement string

const (
	PlacementTop         Placement = "top"
	PlacementTopStart    Placement = "top-start"
	PlacementTopEnd      Placement = "top-end"
	PlacementRight       Placement = "right"
	PlacementRightStart  Placement = "right-start"
	PlacementRightEnd    Placement = "right-end"
	PlacementBottom      Placement = "bottom"
	PlacementBottomStart Placement = "bottom-start"
	PlacementBottomEnd   Placement = "bottom-end"
	PlacementLeft        Placement = "left"
	PlacementLeftStart   Placement = "left-start"
	PlacementLeftEnd     Placement = "left-end"
)

type TriggerType string

const (
	TriggerTypeHover  TriggerType = "hover"
	TriggerTypeClick  TriggerType = "click"
	TriggerTypeManual TriggerType = "manual"
)

type TriggerProps struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	For         string
	TriggerType TriggerType
}

type ContentProps struct {
	ID               string
	Class            string
	Attributes       templ.Attributes
	Placement        Placement
	Offset           int
	DisableClickAway bool
	DisableESC       bool
	ShowArrow        bool
	HoverDelay       int
	HoverOutDelay    int
	Exclusive        bool
}

func triggerStyle(id string) string {
	return "anchor-name: --tui-popovernative-" + id + ";"
}

func contentStyle(id string, placement Placement, offset int) string {
	anchorName := "--tui-popovernative-" + id
	gap := strconv.Itoa(offset) + "px"

	switch placement {
	case PlacementTopStart:
		return fmt.Sprintf("position: fixed; position-anchor: %s; inset: auto; margin: 0; top: calc(anchor(top) - %s); left: anchor(left); translate: 0 -100%%;", anchorName, gap)
	case PlacementTop:
		return fmt.Sprintf("position: fixed; position-anchor: %s; inset: auto; margin: 0; top: calc(anchor(top) - %s); left: anchor(center); translate: -50%% -100%%;", anchorName, gap)
	case PlacementTopEnd:
		return fmt.Sprintf("position: fixed; position-anchor: %s; inset: auto; margin: 0; top: calc(anchor(top) - %s); left: anchor(right); translate: -100%% -100%%;", anchorName, gap)
	case PlacementRightStart:
		return fmt.Sprintf("position: fixed; position-anchor: %s; inset: auto; margin: 0; top: anchor(top); left: calc(anchor(right) + %s);", anchorName, gap)
	case PlacementRight:
		return fmt.Sprintf("position: fixed; position-anchor: %s; inset: auto; margin: 0; top: anchor(center); left: calc(anchor(right) + %s); translate: 0 -50%%;", anchorName, gap)
	case PlacementRightEnd:
		return fmt.Sprintf("position: fixed; position-anchor: %s; inset: auto; margin: 0; top: anchor(bottom); left: calc(anchor(right) + %s); translate: 0 -100%%;", anchorName, gap)
	case PlacementBottomStart:
		return fmt.Sprintf("position: fixed; position-anchor: %s; inset: auto; margin: 0; top: calc(anchor(bottom) + %s); left: anchor(left);", anchorName, gap)
	case PlacementBottomEnd:
		return fmt.Sprintf("position: fixed; position-anchor: %s; inset: auto; margin: 0; top: calc(anchor(bottom) + %s); left: anchor(right); translate: -100%% 0;", anchorName, gap)
	case PlacementLeftStart:
		return fmt.Sprintf("position: fixed; position-anchor: %s; inset: auto; margin: 0; top: anchor(top); left: calc(anchor(left) - %s); translate: -100%% 0;", anchorName, gap)
	case PlacementLeft:
		return fmt.Sprintf("position: fixed; position-anchor: %s; inset: auto; margin: 0; top: anchor(center); left: calc(anchor(left) - %s); translate: -100%% -50%%;", anchorName, gap)
	case PlacementLeftEnd:
		return fmt.Sprintf("position: fixed; position-anchor: %s; inset: auto; margin: 0; top: anchor(bottom); left: calc(anchor(left) - %s); translate: -100%% -100%%;", anchorName, gap)
	default:
		return fmt.Sprintf("position: fixed; position-anchor: %s; inset: auto; margin: 0; top: calc(anchor(bottom) + %s); left: anchor(center); translate: -50%% 0;", anchorName, gap)
	}
}

func arrowClass(placement Placement) string {
	base := "absolute h-2.5 w-2.5 rotate-45 bg-popover border border-border"

	switch placement {
	case PlacementTopStart:
		return base + " -bottom-[5px] left-4 border-t-transparent border-l-transparent"
	case PlacementTop:
		return base + " -bottom-[5px] left-1/2 -translate-x-1/2 border-t-transparent border-l-transparent"
	case PlacementTopEnd:
		return base + " -bottom-[5px] right-4 border-t-transparent border-l-transparent"
	case PlacementRightStart:
		return base + " -left-[5px] top-4 border-r-transparent border-t-transparent"
	case PlacementRight:
		return base + " -left-[5px] top-1/2 -translate-y-1/2 border-r-transparent border-t-transparent"
	case PlacementRightEnd:
		return base + " -left-[5px] bottom-4 border-r-transparent border-t-transparent"
	case PlacementBottomStart:
		return base + " -top-[5px] left-4 border-b-transparent border-r-transparent"
	case PlacementBottomEnd:
		return base + " -top-[5px] right-4 border-b-transparent border-r-transparent"
	case PlacementLeftStart:
		return base + " -right-[5px] top-4 border-l-transparent border-b-transparent"
	case PlacementLeft:
		return base + " -right-[5px] top-1/2 -translate-y-1/2 border-l-transparent border-b-transparent"
	case PlacementLeftEnd:
		return base + " -right-[5px] bottom-4 border-l-transparent border-b-transparent"
	default:
		return base + " -top-[5px] left-1/2 -translate-x-1/2 border-b-transparent border-r-transparent"
	}
}

templ Trigger(props ...TriggerProps) {
	@script()
	{{ var p TriggerProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.TriggerType == "" {
		{{ p.TriggerType = TriggerTypeClick }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("group inline-flex cursor-pointer", p.Class) }
		if p.For != "" {
			data-tui-popovernative-trigger={ p.For }
			style={ triggerStyle(p.For) }
		}
		data-tui-popovernative-open="false"
		data-tui-popovernative-type={ string(p.TriggerType) }
		{ p.Attributes... }
	>
		{ children... }
	</span>
}

templ Content(props ...ContentProps) {
	@script()
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Placement == "" {
		{{ p.Placement = PlacementBottom }}
	}
	if p.Offset == 0 {
		if p.ShowArrow {
			{{ p.Offset = 8 }}
		} else {
			{{ p.Offset = 4 }}
		}
	}
	<div
		id={ p.ID }
		popover="manual"
		data-tui-popovernative-content
		data-tui-popovernative-id={ p.ID }
		data-tui-popovernative-open="false"
		data-tui-popovernative-placement={ string(p.Placement) }
		data-tui-popovernative-offset={ strconv.Itoa(p.Offset) }
		data-tui-popovernative-disable-clickaway={ strconv.FormatBool(p.DisableClickAway) }
		data-tui-popovernative-disable-esc={ strconv.FormatBool(p.DisableESC) }
		data-tui-popovernative-show-arrow={ strconv.FormatBool(p.ShowArrow) }
		data-tui-popovernative-hover-delay={ strconv.Itoa(p.HoverDelay) }
		data-tui-popovernative-hover-out-delay={ strconv.Itoa(p.HoverOutDelay) }
		data-tui-popovernative-exclusive={ strconv.FormatBool(p.Exclusive) }
		style={ contentStyle(p.ID, p.Placement, p.Offset) }
		class={ utils.TwMerge(
			"bg-popover rounded-lg border text-popover-foreground text-sm shadow-lg pointer-events-auto fixed max-w-[min(24rem,calc(100vw-2rem))] outline-none",
			p.Class,
		) }
		{ p.Attributes... }
	>
		<div class="w-full overflow-hidden">
			{ children... }
		</div>
		if p.ShowArrow {
			<div data-tui-popovernative-arrow class={ arrowClass(p.Placement) }></div>
		}
	</div>
}

var onceHandle = templ.NewOnceHandle()

templ script() {
	@onceHandle.Once() {
		if !utils.SuppressComponentScripts {
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ComponentScriptURL("popovernative") }></script>
		}
	}
}
