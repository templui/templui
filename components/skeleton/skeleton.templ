package skeleton

import "github.com/axadrn/shadcn-templ/v2/utils"

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

templ Skeleton(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="skeleton"
		class={ utils.CN("cn-skeleton animate-pulse", p.Class) }
		{ p.Attributes... }
	></div>
}
