package pagination

import (
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/utils"
)

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type ContentProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type ItemProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type LinkProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Href       string
	IsActive   bool
	Disabled   bool
}

type PreviousProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Href       string
	Disabled   bool
	Label      string
}

type NextProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Href       string
	Disabled   bool
	Label      string
}

templ Pagination(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<nav
		if p.ID != "" {
			id={ p.ID }
		}
		role="navigation"
		aria-label="pagination"
		class={ utils.TwMerge("mx-auto flex w-full justify-center", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</nav>
}

templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<ul
		if p.ID != "" {
			id={ p.ID }
		}
		class="flex items-center gap-0.5"
		{ p.Attributes... }
	>
		{ children... }
	</ul>
}

templ Item(props ...ItemProps) {
	{{ var p ItemProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<li
		if p.ID != "" {
			id={ p.ID }
		}
		{ p.Attributes... }
	>
		{ children... }
	</li>
}

templ Link(props ...LinkProps) {
	{{ var p LinkProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Disabled {
		@button.Button(button.Props{
			ID:         p.ID,
			Disabled:   true,
			Size:       button.SizeIcon,
			Variant:    button.VariantGhost,
			Class:      p.Class,
			Attributes: p.Attributes,
		}) {
			{ children... }
		}
	} else {
		{{
			attrs := templ.Attributes{"data-slot": "pagination-link"}
			if p.IsActive {
				attrs["aria-current"] = "page"
				attrs["data-active"] = "true"
			}
			for k, v := range p.Attributes {
				attrs[k] = v
			}
		}}
		@button.Button(button.Props{
			ID:         p.ID,
			Href:       p.Href,
			Size:       button.SizeIcon,
			Variant:    button.Variant(buttonVariant(p.IsActive)),
			Class:      p.Class,
			Attributes: attrs,
		}) {
			{ children... }
		}
	}
}

templ Previous(props ...PreviousProps) {
	{{ var p PreviousProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Label == "" {
		{{ p.Label = "Previous" }}
	}
	{{
		attrs := templ.Attributes{"aria-label": "Go to previous page", "data-slot": "pagination-link"}
		for k, v := range p.Attributes {
			attrs[k] = v
		}
	}}
	@button.Button(button.Props{
		ID:         p.ID,
		Href:       p.Href,
		Disabled:   p.Disabled,
		Variant:    button.VariantGhost,
		Class:      utils.TwMerge("pl-1.5!", p.Class),
		Attributes: attrs,
	}) {
		@icon.ChevronLeft(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-start"}})
		<span class="hidden sm:block">{ p.Label }</span>
	}
}

templ Next(props ...NextProps) {
	{{ var p NextProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Label == "" {
		{{ p.Label = "Next" }}
	}
	{{
		attrs := templ.Attributes{"aria-label": "Go to next page", "data-slot": "pagination-link"}
		for k, v := range p.Attributes {
			attrs[k] = v
		}
	}}
	@button.Button(button.Props{
		ID:         p.ID,
		Href:       p.Href,
		Disabled:   p.Disabled,
		Variant:    button.VariantGhost,
		Class:      utils.TwMerge("pr-1.5!", p.Class),
		Attributes: attrs,
	}) {
		<span class="hidden sm:block">{ p.Label }</span>
		@icon.ChevronRight(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-end"}})
	}
}

templ Ellipsis() {
	<span aria-hidden="true" data-slot="pagination-ellipsis" class="flex size-8 items-center justify-center [&_svg:not([class*='size-'])]:size-4">
		@icon.Ellipsis()
		<span class="sr-only">More pages</span>
	</span>
}

func buttonVariant(isActive bool) button.Variant {
	if isActive {
		return button.VariantOutline
	}
	return button.VariantGhost
}
