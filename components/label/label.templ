package label

import "github.com/templui/templui/utils"

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	For        string
	Error      string
}

templ Label(props ...Props) {
	@Script()
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<label
		if p.ID != "" {
			id={ p.ID }
		}
		if p.For != "" {
			for={ p.For }
		}
		class={
			utils.TwMerge(
				"text-sm font-medium leading-none inline-block",
				utils.If(len(p.Error) > 0, "text-destructive"),
				p.Class,
			),
		}
		data-tui-label-disabled-style="opacity-50 cursor-not-allowed"
		{ p.Attributes... }
	>
		{ children... }
	</label>
}

var onceHandle = templ.NewOnceHandle()

templ Script() {
	@onceHandle.Once() {
		if !utils.SuppressComponentScripts {
			<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ComponentScriptURL("label") }></script>
		}
	}
}
